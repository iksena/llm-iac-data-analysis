    "# ── 2b. GitHub API Authentication ─────────────────────────────────────────────\n",
    "# Every downstream cell that talks to the GitHub API (repo discovery, licence\n",
    "# lookups, DPIaC-Eval template fetch) shares GH_HEADERS from cell 2. Without a\n",
    "# token, GitHub's REST API caps you at 60 requests/hour (core) and 10/min\n",
    "# (search) — that's not enough to licence-check ~1,000 registry repos or run\n",
    "# the cell-2.5 discovery queries without long stalls. An authenticated token\n",
    "# raises those to 5,000/hour (core) and 30/min (search), which comfortably\n",
    "# covers this notebook's call volume in one pass.\n",
    "#\n",
    "# Precedence:\n",
    "#   1. GITHUB_TOKEN already set in the environment (e.g. `export GITHUB_TOKEN=...`\n",
    "#      before launching Jupyter, or a platform-injected credential) — used as-is,\n",
    "#      nothing is prompted or overwritten.\n",
    "#   2. Otherwise, prompt once via getpass (input is masked, never echoed or\n",
    "#      logged, and never written to disk or to any cache file).\n",
    "#\n",
    "# Create a token at https://github.com/settings/tokens — a fine-grained token\n",
    "# with no scopes/permissions (public-repo read access is unauthenticated-\n",
    "# equivalent but still gets the higher authenticated rate limit) is sufficient;\n",
    "# this notebook only reads public repo metadata, licences, and file contents.\n",
    "\n",
    "import os\n",
    "import requests\n",
    "\n",
    "if os.environ.get('GITHUB_TOKEN pass'):\n",
    "    GITHUB_TOKEN = os.environ['GITHUB_TOKEN']\n",
    "    print('✅ Using GITHUB_TOKEN from environment.')\n",
    "else:\n",
    "    import getpass\n",
    "    print('No GITHUB_TOKEN found in environment.')\n",
    "    GITHUB_TOKEN = getpass.getpass('Paste a GitHub personal access token (leave blank to continue unauthenticated): ').strip()\n",
    "    if GITHUB_TOKEN:\n",
    "        os.environ['GITHUB_TOKEN'] = GITHUB_TOKEN  # so later cells / kernel restarts within this session see it too\n",
    "        print('✅ Token captured for this session (not written to disk).')\n",
    "    else:\n",
    "        print('⚠️  Continuing unauthenticated — 60 req/hr (core) / 10 req/min (search) limits apply.')\n",
    "\n",
    "GH_HEADERS = {'Authorization': f'token {GITHUB_TOKEN}'} if GITHUB_TOKEN else {}\n",
    "\n",
    "# ── Validate the token and report actual quota ────────────────────────────────\n",
    "try:\n",
    "    r = requests.get('https://api.github.com/rate_limit', headers=GH_HEADERS, timeout=15)\n",
    "    if r.status_code == 200:\n",
    "        core = r.json()['resources']['core']\n",
    "        search = r.json()['resources']['search']\n",
    "        auth_state = 'authenticated' if GITHUB_TOKEN else 'unauthenticated'\n",
    "        print(f'\\nGitHub API quota ({auth_state}):')\n",
    "        print(f'  core   : {core[\"remaining\"]}/{core[\"limit\"]} per hour')\n",
    "        print(f'  search : {search[\"remaining\"]}/{search[\"limit\"]} per minute-window')\n",
    "    elif r.status_code == 401:\n",
    "        print('\\n❌ Token rejected (401 Unauthorized) — check it was copied correctly / has not expired.')\n",
    "        print('   Falling back to unauthenticated GH_HEADERS for the rest of this session.')\n",
    "        GITHUB_TOKEN = ''\n",
    "        GH_HEADERS = {}\n",
    "    else:\n",
    "        print(f'\\n⚠️  Could not verify quota (HTTP {r.status_code}) — proceeding with current GH_HEADERS anyway.')\n",
    "except requests.exceptions.RequestException as e:\n",
    "    print(f'\\n⚠️  Could not reach GitHub to verify quota ({e}) — proceeding with current GH_HEADERS anyway.')\n"
