    "# %%\n",
    "# \u2500\u2500 Utility: Explore Adjustable Difficulty Thresholds & Distribution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "\n",
    "# \u2500\u2500 1. Adjustable Thresholds \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Adjust these tuples: (Minimum_Lines_of_Code, Minimum_Resource_Count)\n",
    "# A scenario must meet BOTH thresholds to qualify for the level.\n",
    "\n",
    "# \ud83d\udca1 CFN-Aligned Thresholds (Very strict for TF):\n",
    "# L5_LOC, L5_RES = 200, 12\n",
    "# L4_LOC, L4_RES = 150, 8\n",
    "# L3_LOC, L3_RES = 100, 4\n",
    "# L2_LOC, L2_RES = 50,  2\n",
    "\n",
    "# \ud83d\udca1 Original Terraform-Specific Thresholds (Accounts for HCL verbosity):\n",
    "L5_LOC, L5_RES = 400, 12\n",
    "L4_LOC, L4_RES = 250, 8\n",
    "L3_LOC, L3_RES = 150, 4\n",
    "L2_LOC, L2_RES = 80,  2\n",
    "\n",
    "# \u2500\u2500 2. Apply Custom Logic \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "# DEPLOY_PASSED_CSV = DATASET_DIR / 'deploy_passed_batch.csv'\n",
    "DEPLOY_PASSED_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "\n",
    "if not DEPLOY_PASSED_CSV.exists():\n",
    "    print(f\"\u26a0\ufe0f {DEPLOY_PASSED_CSV.name} not found. Please ensure it exists.\")\n",
    "else:\n",
    "    df_deploy = pd.read_csv(DEPLOY_PASSED_CSV)\n",
    "    \n",
    "    def calculate_custom_difficulty(row):\n",
    "        loc = row['loc']\n",
    "        res = row['n_resources']\n",
    "        if loc >= L5_LOC and res >= L5_RES: return 5\n",
    "        elif loc >= L4_LOC and res >= L4_RES: return 4\n",
    "        elif loc >= L3_LOC and res >= L3_RES: return 3\n",
    "        elif loc >= L2_LOC and res >= L2_RES: return 2\n",
    "        else: return 1\n",
    "\n",
    "    # Apply the custom difficulty\n",
    "    df_deploy['custom_difficulty'] = df_deploy.apply(calculate_custom_difficulty, axis=1)\n",
    "    # df_deploy['custom_difficulty'] = df_deploy.apply(calculate_difficulty, axis=1)\n",
    "    \n",
    "    # \u2500\u2500 3. Display Results \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    print(\"\ud83d\udcca Custom Difficulty Distribution (Deployable Candidates):\")\n",
    "    dist = df_deploy['custom_difficulty'].value_counts().sort_index()\n",
    "    print(dist.to_frame(name='Count'))\n",
    "    \n",
    "    print(\"\\n\ud83d\udcc8 Median Statistics per Custom Level:\")\n",
    "    summary_table = df_deploy.groupby('custom_difficulty')[['loc', 'n_resources', 'n_params']].median().round(1)\n",
    "    display(summary_table)\n",
    "\n",
    "    # \u2500\u2500 4. Plot the Distribution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    sns.set_theme(style=\"whitegrid\")\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "    fig.suptitle('Exploratory Difficulty Distribution', fontsize=16, fontweight='bold')\n",
    "\n",
    "    # Bar chart of counts\n",
    "    sns.countplot(data=df_deploy, x='custom_difficulty', ax=axes[0], palette='viridis')\n",
    "    axes[0].set_title('Number of Scenarios per Level')\n",
    "    axes[0].set_xlabel('Custom Difficulty Level')\n",
    "    axes[0].set_ylabel('Count')\n",
    "    \n",
    "    # Add count labels on top of bars\n",
    "    for p in axes[0].patches:\n",
    "        axes[0].annotate(f'{int(p.get_height())}', \n",
    "                         (p.get_x() + p.get_width() / 2., p.get_height()), \n",
    "                         ha='center', va='bottom', fontsize=10, color='black', xytext=(0, 5), textcoords='offset points')\n",
    "\n",
    "    # Scatter plot showing where the templates fall\n",
    "    sns.scatterplot(data=df_deploy, x='loc', y='n_resources', hue='custom_difficulty', \n",
    "                    palette='viridis', alpha=0.6, ax=axes[1])\n",
