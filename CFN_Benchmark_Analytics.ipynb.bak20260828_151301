    "        print(f\"    {f}\")\n",
    "\n",
    "_manual_added = [f for f in MANUAL_FIX_DEST_FILES if f not in REAL_AWS_TEST_QUEUE]\n",
    "REAL_AWS_TEST_QUEUE += _manual_added\n",
    "if _manual_added:\n",
