{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "UseSnapshot": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "EBSSnapshotId"
            },
            ""
          ]
        }
      ]
    },
    "PROD": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "PROD"
      ]
    },
    "UNCLASS": {
      "Fn::Equals": [
        {
          "Ref": "AWS::Partition"
        },
        "aws"
      ]
    }
  },
  "Description": "EC2 service",
  "Outputs": {
    "ServerId": {
      "Description": "Instance ID",
      "Value": {
        "Ref": "Server"
      }
    },
    "LogGroup": {
      "Description": "Log Group Name",
      "Value": {
        "Ref": "LogGroup"
      }
    }
  },
  "Parameters": {
    "ParentStack": {
      "Type": "String"
    },
    "DeployType": {
      "Type": "String"
    },
    "ImageId": {
      "Type": "AWS::EC2::Image::Id"
    },
    "Bucket": {
      "Type": "String"
    },
    "IamInstanceProfile": {
      "Type": "String"
    },
    "DBHost": {
      "Type": "String"
    },
    "DBName": {
      "Type": "String"
    },
    "DBUsername": {
      "Type": "String"
    },
    "DBPassword": {
      "NoEcho": "True",
      "Type": "String"
    },
    "GroupSet": {
      "Type": "List<AWS::EC2::SecurityGroup::Id>"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "EBSSnapshotId": {
      "Type": "String",
      "Default": ""
    },
    "InstanceType": {
      "Type": "String"
    },
    "Hostname": {
      "Type": "String"
    },
    "AFUser": {
      "Type": "String"
    },
    "AFPass": {
      "Type": "String",
      "NoEcho": "True"
    },
    "Environment": {
      "Type": "String"
    },
    "LDAPUser": {
      "Type": "String"
    },
    "LDAPPass": {
      "Type": "String"
    },
    "LDAPURL": {
      "Type": "String"
    },
    "CfnEndpointUrl": {
      "Type": "String"
    },
    "ArtUrl": {
      "Type": "String"
    },
    "ArtRepo": {
      "Type": "String"
    },
    "CredsBucket": {
      "Type": "String"
    },
    "WamConfig": {
      "Type": "String"
    },
    "AppSize": {
      "Type": "String"
    },
    "BannerText": {
      "Type": "String"
    },
    "BannerBg": {
      "Type": "String"
    },
    "BannerTextColor": {
      "Type": "String"
    },
        "EC2Domain": {
            "Type": "String"
        },
        "CidrBlock": {
            "Type": "String"
        },
        "NtpServers": {
          "Description": "Timeserver address to append to chrony",
          "Type": "String"
        },
    "AppVersion": {
          "Type": "String"
        }
  },
  "Resources": {
    "Server": {
      "Type": "AWS::EC2::Instance",
      "CreationPolicy": {
        "ResourceSignal": {
          "Count": "1",
          "Timeout": "PT90M"
        }
      },
      "Properties": {
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "DeleteOnTermination": true,
              "VolumeSize": 50,
              "VolumeType": "gp2"
            }
          },
          {
            "DeviceName": "/dev/xvdg",
            "Ebs": {
              "DeleteOnTermination": true,
              "VolumeSize": {
                "Ref": "AppSize"
              },
              "VolumeType": "gp2"
            }
          }
        ],
        "IamInstanceProfile": {
          "Ref": "IamInstanceProfile"
        },
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "InstanceType"
        },
        "NetworkInterfaces": [
          {
            "AssociatePublicIpAddress": false,
            "DeviceIndex": "0",
            "GroupSet": {
              "Ref": "GroupSet"
            },
            "SubnetId": {
              "Ref": "SubnetId"
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "ParentStack"
            }
          },
          {
            "Key": "Version",
            "Value": {"Ref": "AppVersion"}
          },
          {
                        "Fn::If": [
                            "PROD",
                            {
                                "Fn::If": [
                                    "UNCLASS",
                                    {
                                        "Key": "CT_CLAP_IGNORE",
                                        "Value": "true"
                                    },

                                    {
                                        "Ref": "AWS::NoValue"
                                    }
                                ]
                            },
                            {
                                "Key": "CLAP_OFF",
                                "Value": "18:00"
                            }
                        ]
                    }
        ],
        "UserData": {
          "Fn::Base64": {
            "Fn::Join": [
              "",
              [
                "#!/bin/bash -xe",
                "\n",
                "exec > >(tee /var/log/user-data.log 2> /dev/console) 2>&1 \n",
                "### Adding PARAMS file \n",
                "\nmkdir -p /etc/cfn\n",
                "\ncat > /etc/cfn/params <<STACK_PARAMS",
                "\nDEPLOY_TYPE=",
                {
                  "Ref": "DeployType"
                },
                "\nBUCKET=",
                {
                  "Ref": "Bucket"
                },
                "\nDATABASE=",
                {
                  "Ref": "DBName"
                },
                "\nDBUSER=",
                {
                  "Ref": "DBUsername"
                },
                "\nDBPASSWORD=",
                {
                  "Ref": "DBPassword"
                },
                "\nDBHOST=",
                {
                  "Ref": "DBHost"
                },
                "\nLOG_GROUP=",
                {
                  "Ref": "LogGroup"
                },
                "\nPARENT_STACK=",
                {
                  "Ref": "ParentStack"
                },
                "\nPARTITION=",
                {
                  "Ref": "AWS::Partition"
                },
                "\nURL_SUFFIX=",
                {
                  "Ref": "AWS::URLSuffix"
                },
                "\nHOSTNAME=",
                {
                  "Ref": "Hostname"
                },
                "\nAF_USER=",
                {
                  "Ref": "AFUser"
                },
                "\nAF_PASS=",
                {
                  "Ref": "AFPass"
                },
                "\nCREDS_BUCKET=",
                {
                  "Ref": "CredsBucket"
                },
                "\nAF_URL=",
                {
                  "Ref": "ArtUrl"
                },
                "\nAF_REPO=",
                {
                  "Ref": "ArtRepo"
                },
                "\nWAM_CONFIG=",
                {
                  "Ref": "WamConfig"
                },
                "\nENVIRONMENT=",
                {
                  "Ref": "Environment"
                },
                "\nLDAPUSER=",
                {
                  "Ref": "LDAPUser"
                },
                "\nLDAPPASS=",
                {
                  "Ref": "LDAPPass"
                },
                "\nLDAPURL=",
                {
                  "Ref": "LDAPURL"
                },
                "\nAPP_SIZE=",
                {
                  "Ref": "AppSize"
                },
                                "\nEC2_DOMAIN=",
                                {
                                    "Ref": "EC2Domain"
                                },
                "\nBANNER_TEXT=\"",
                {
                  "Ref": "BannerText"
                },
                "\"",
                "\nBANNER_BG=",
                {
                  "Ref": "BannerBg"
                },
                "\nBANNER_TEXT_COLOR=",
                {
                  "Ref": "BannerTextColor"
                                },
                                "\nCIDR_BLOCK=",
                                {
                                  "Ref": "CidrBlock"
                                },
                                "\nNTP_SERVERS=",
                                {
                                  "Ref": "NtpServers"
                                },
                "\nSTACK_PARAMS\n",
                                "mkdir -p /root/.aws\n",
                                "echo [default] >> /root/.aws/config\n",
                                "echo region = us-east-1 >> /root/.aws/config\n",
                                "echo export AWS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt >> /etc/profile \n",
                                "echo export REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt >> /etc/profile \n",
                "source /etc/profile \n",
                                "### Run bootstrap.sh \n",
                "aws s3 cp s3://",
                {
                  "Ref": "Bucket"
                },
                "/SupportFiles/bootstrap.sh /etc/cfn/ \n",
                "chmod +x /etc/cfn/bootstrap.sh \n",
                "/etc/cfn/bootstrap.sh \n",
                "### CFN Signal \n",
                "/opt/aws/bin/cfn-signal -e $?",
                " --stack ",
                {
                  "Ref": "AWS::StackName"
                },
                " --resource Server",
                " --region ",
                {
                  "Ref": "AWS::Region"
                },
                " --role=",
                {
                  "Ref": "IamInstanceProfile"
                },
                " --url=",
                {
                  "Ref": "CfnEndpointUrl"
                }
              ]
            ]
          }
        }
      }
    },
    "LogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Join": [
            "",
            [
              "/aws/ec2/lx/",
              {
                "Ref": "AWS::StackName"
              }
            ]
          ]
        }
      }
    }
  }
}