    "# cfn_benchmark_builder.ipynb's cell 10 (DEPLOY_MODE='stack'), just pointed\n",
    "# at the frozen 250-row set instead of the raw candidate pool, and using the\n",
    "# 'default' named AWS profile explicitly rather than ambient credentials.\n",
    "#\n",
    "# Every deployed stack is torn down again immediately after its outcome is\n",
    "# recorded -- WHETHER THE DEPLOY SUCCEEDED, FAILED, OR ERRORED -- and the\n",
    "# teardown itself is waited on and logged (destroy_pass/destroy_error/\n",
    "# deployed_stack_name), not just fire-and-forget. If a stack ever fails to\n",
    "# delete cleanly (deletion-protected resource, stuck dependency, etc.) this\n",
    "# prints a loud warning with the exact stack name + region so it can be\n",
    "# cleaned up by hand, and that row is recorded with destroy_pass=False so it\n",
    "# surfaces in the analytics cell below rather than silently leaking an\n",
    "# orphaned resource in a \"dummy\" account.\n",
    "#\n",
    "# \u26a0\ufe0f  SAFETY GATE \u2014 this creates and destroys REAL, POSSIBLY BILLABLE AWS\n",
    "# resources up to 250 times in whatever account 'default' points to. It is\n",
    "# NOT run automatically. To actually execute it:\n",
    "#   1. Confirm `aws sts get-caller-identity --profile default` resolves to\n",
    "#      the AWS account you intend to test against.\n",
    "#   2. Set RUN_DEPLOYMENT = True below.\n",
    "#   3. Optionally narrow DEPLOY_ROW_NUMBERS to a subset first (e.g. a few\n",
    "#      rows per difficulty level) before committing to a full 250-row pass.\n",
    "# Resumable: results are cached by content_hash in DEPLOY_CACHE_PATH, so an\n",
    "# interrupted run (Ctrl-C, kernel restart) picks up where it left off on\n",
    "# the next run rather than re-testing already-checked rows.\n",
    "RUN_DEPLOYMENT = True\n",
    "DEPLOY_ROW_NUMBERS = None  # e.g. [1, 2, 3] to scope to specific rows; None = all 250\n",
    "\n",
    "import os\n",
