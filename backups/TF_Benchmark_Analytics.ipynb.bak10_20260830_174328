    "            scenarios_dropped.append(row_to_drop['folder_path'])\n",
    "            df_lvl_kept = df_lvl_kept[df_lvl_kept['folder_path'] != row_to_drop['folder_path']]\n",
    "        df_lvl_kept = df_lvl_kept.reset_index()\n",
    "        print(f\"  ➖ Level {level}: dropped {excess} excess (redundant-first) to reach {target}.\")\n",
    "\n",
    "    elif n_kept < target:\n",
    "        shortfall = target - n_kept\n",
    "        candidates = df_deployable_real[\n",
    "            (df_deployable_real['difficulty'] == level) &\n",
    "            (~df_deployable_real['folder_path'].isin(df_kept['folder_path'])) &\n",
    "            (~df_deployable_real['folder_path'].isin(MANUAL_EXCLUDE_SET))\n",
    "        ].copy()\n",
    "\n",
    "        # Order the backfill so aws_services combinations NOT YET present in this level's\n",
