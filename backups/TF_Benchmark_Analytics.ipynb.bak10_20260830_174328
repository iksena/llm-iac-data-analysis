   "source": [
    "# ── 4. Real-AWS Deploy Check ──────────────────────────────────────────────────\n",
    "# Runs real `terraform init` -> `terraform apply` -> `terraform destroy`\n",
    "# against a live AWS account for candidates in the real-AWS testing queue\n",
    "# (section 2), using plain vanilla Terraform (no tflocal, no LocalStack\n",
    "# endpoint overrides -- this is the whole point). This is the ONLY place in\n",
    "# this notebook that creates/destroys real, possibly-billable AWS resources.\n",
    "#\n",
    "# Targets candidates by `folder_path` (from the pool built in section 1),\n",
    "# not by any row_number from a frozen benchmark file -- this notebook's\n",
    "# real-AWS pipeline has no dependency on final_benchmark_with_prompts.csv,\n",
    "# only on the raw TFLint/Trivy/deploy caches the builder notebook produces.\n",
    "# `scenario_id` is the actual join key everywhere (mirrors content_hash's\n",
    "# role in the CFN track).\n",
    "#\n",
    "# Every deployed stack of resources is torn down immediately after its\n",
    "# outcome is recorded -- success, failure, OR error -- and the teardown\n",
    "# itself is waited on and logged (destroy_pass/destroy_error), not\n",
    "# fire-and-forget. A destroy that fails prints a loud warning with the exact\n",
    "# scenario + working directory so it can be found and cleaned up by hand,\n",
    "# and is recorded with destroy_pass=False so it surfaces in the failure\n",
    "# analytics below rather than silently leaking.\n",
    "#\n",
    "# ⚠️  SAFETY GATE — this creates and destroys REAL, POSSIBLY BILLABLE AWS\n",
    "# resources. It is NOT run automatically. To actually execute it:\n",
    "#   1. Confirm `aws sts get-caller-identity --profile <profile>` (the cell\n",
    "#      above) resolves to the AWS account you intend to test against.\n",
    "#   2. Optionally narrow TARGET_FOLDER_PATHS below (default: section 2's\n",
    "#      whole queue) to a smaller batch first.\n",
    "#   3. Set RUN_DEPLOYMENT = True.\n",
    "# Resumable: results are cached by scenario_id in DEPLOY_CACHE_PATH, so an\n",
    "# interrupted run (Ctrl-C, kernel restart) picks up where it left off on the\n",
    "# next run rather than re-testing already-checked rows.\n",
    "RUN_DEPLOYMENT = True\n",
    "TARGET_FOLDER_PATHS = REAL_AWS_TEST_QUEUE  # from section 2 -- narrow this for a smaller batch\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "import tempfile\n",
    "import subprocess\n",
    "import re\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "AWS_PROFILE = os.environ.get('AWS_PROFILE', 'default')  # e.g. export AWS_PROFILE=senatwo\n",
    "AWS_REGION = os.environ.get('AWS_REGION', 'us-east-1')\n",
    "DEPLOY_TIMEOUT_MIN = 20\n",
    "DESTROY_TIMEOUT_MIN = 15\n",
    "DESTROY_AFTER_DEPLOY = True\n",
    "SAVE_EVERY = 5\n",
    "\n",
    "DEPLOY_CACHE_PATH = DATASET_DIR / 'tf_ground_truth_deploy_check_aws.csv'\n",
    "\n",
    "_run_env = os.environ.copy()\n",
    "_run_env['AWS_PROFILE'] = AWS_PROFILE\n",
    "_run_env['AWS_DEFAULT_REGION'] = AWS_REGION\n",
    "# Real terraform registry provider downloads benefit from the same plugin\n",
    "# cache this project already configured in ~/.terraformrc for the\n",
    "# LocalStack track's tflocal calls -- terraform (not just tflocal) honors it\n",
    "# too, so repeated inits across many scenarios reuse already-downloaded\n",
    "# provider binaries instead of re-downloading a fresh copy per scenario.\n",
    "_run_env['PATH'] = f\"/opt/homebrew/bin:{_run_env.get('PATH', '')}\"\n",
    "\n",
    "\n",
    "def _extract_error(text: str) -> str:\n",
    "    # 2026-08-30: was a flat [:1500] truncation -- for scenarios with many \"No value for\n",
    "    # required variable\" errors (Terraform lists one full block per missing variable,\n",
    "    # ~150-250 chars each), this silently hid every variable past the first 5-8, which\n",
    "    # repeatedly cost a whole extra round of \"re-derive the true list by reading .tf\n",
    "    # source directly\" work across this project's triage sessions. Fixed two ways:\n",
    "    # (1) when the error is a list of missing-variable blocks, compress each block down\n",
    "    # to just the variable name (the only piece that's actually actionable) so dozens of\n",
    "    # variables fit in the space a flat truncation used to waste on repeating the same\n",
    "    # boilerplate sentence every time; (2) the plain fallback truncation is raised from\n",
    "    # 1500 to 6000, since most non-list error shapes (schema errors, external-dependency\n",
    "    # failures, provider errors) are self-contained well under that and rarely need the\n",
    "    # missing-variable-specific compression above.\n",
    "    text = (text or '').strip()\n",
    "    if not text:\n",
    "        return ''\n",
    "    missing_vars = re.findall(\n",
    "        r'Error:\\s*No value for required variable\\s*\\n\\s*\\n\\s*on\\s+\\S+\\s+line\\s+\\d+:\\s*\\n\\s*\\d+:\\s*variable\\s+\"([^\"]+)\"',\n",
    "        text,\n",
    "    )\n",
    "    if len(missing_vars) >= 3:\n",
    "        preamble = text[:text.find('Error:')].strip()\n",
    "        summary = (\n",
    "            f\"Error: No value for required variable(s) -- {len(missing_vars)} total: \"\n",
    "            + ', '.join(missing_vars)\n",
    "        )\n",
    "        combined = (preamble + '\\n\\n' + summary).strip() if preamble else summary\n",
    "        return combined[:4000]\n",
    "    return text[:6000]\n",
    "\n",
    "\n",
    "def _deploy_timeout_multiplier(content: str) -> int:\n",
    "    \"\"\"Mirrors the CFN track's own per-content timeout scaling -- a handful\n",
    "    of resource types routinely need much longer than DEPLOY_TIMEOUT_MIN to\n",
    "    finish on real AWS (EKS control-plane creation, ImageBuilder AMI builds,\n",
    "    large Route53 zones).\"\"\"\n",
    "    if 'aws_eks_cluster' in content or 'aws_eks_node_group' in content:\n",
    "        return 3\n",
    "    if 'aws_imagebuilder_image' in content or 'aws_imagebuilder_distribution_configuration' in content:\n",
    "        return 3\n",
    "    if content.count('aws_route53_record') > 20:\n",
    "        return 2\n",
    "    return 1\n",
    "\n",
    "\n",
    "def _run_terraform(args, cwd, timeout_sec):\n",
    "    try:\n",
    "        r = subprocess.run(['terraform'] + args, cwd=cwd, env=_run_env,\n",
    "                            capture_output=True, text=True, timeout=timeout_sec)\n",
    "        return r.returncode, r.stdout, r.stderr\n",
    "    except subprocess.TimeoutExpired:\n",
    "        return None, '', f'TIMEOUT after {timeout_sec}s running: terraform {\" \".join(args)}'\n",
    "    except FileNotFoundError:\n",
    "        return None, '', 'terraform CLI not found on PATH'\n",
    "\n",
    "\n",
    "def _deploy_scenario(folder_path: str) -> dict:\n",
    "    src_folder = BASE_DIR / folder_path if not str(folder_path).startswith(str(BASE_DIR)) else Path(folder_path)\n",
    "    if not src_folder.exists():\n",
    "        return {'init_pass': None, 'init_error': 'ground truth folder missing',\n",
    "                'deploy_pass': None, 'deploy_status': 'skipped', 'apply_error': 'ground truth folder missing',\n",
    "                'destroy_pass': None, 'destroy_error': 'not_attempted'}\n",
    "\n",
    "    with tempfile.TemporaryDirectory(prefix='tf_real_aws_') as tmpdir:\n",
    "        for f in src_folder.glob('*.tf'):\n",
    "            shutil.copy2(f, Path(tmpdir) / f.name)\n",
    "        content = \"\\n\\n\".join(f.read_text(encoding='utf-8', errors='ignore') for f in src_folder.glob('*.tf'))\n",
    "\n",
    "        rc, out, err = _run_terraform(['init', '-input=false', '-no-color'], tmpdir, 300)\n",
    "        if rc != 0:\n",
    "            return {'init_pass': False, 'init_error': _extract_error(out + err),\n",
    "                    'deploy_pass': None, 'deploy_status': 'init_failed', 'apply_error': '',\n",
    "                    'destroy_pass': None, 'destroy_error': 'not_attempted (init never succeeded)'}\n",
    "\n",
    "        timeout_sec = DEPLOY_TIMEOUT_MIN * 60 * _deploy_timeout_multiplier(content)\n",
    "        rc, out, err = _run_terraform(['apply', '-auto-approve', '-input=false', '-no-color'], tmpdir, timeout_sec)\n",
    "        stack_existed = True  # apply attempted -- something MAY now exist, even on failure/timeout\n",
    "        if rc == 0:\n",
    "            result = {'init_pass': True, 'init_error': '', 'deploy_pass': True,\n",
    "                      'deploy_status': 'CREATE_COMPLETE', 'apply_error': ''}\n",
    "        else:\n",
    "            result = {'init_pass': True, 'init_error': '', 'deploy_pass': False,\n",
    "                      'deploy_status': 'APPLY_FAILED' if rc is not None else 'APPLY_TIMEOUT',\n",
    "                      'apply_error': _extract_error(out + err)}\n",
    "\n",
    "        if DESTROY_AFTER_DEPLOY:\n",
    "            drc, dout, derr = _run_terraform(['destroy', '-auto-approve', '-input=false', '-no-color'],\n",
    "                                              tmpdir, DESTROY_TIMEOUT_MIN * 60)\n",
    "            if drc == 0:\n",
    "                result['destroy_pass'] = True\n",
    "                result['destroy_error'] = ''\n",
    "            else:\n",
    "                result['destroy_pass'] = False\n",
    "                result['destroy_error'] = _extract_error(dout + derr)\n",
    "                print(f\"\\n🚨 FAILED TO CLEAN UP resources for {folder_path!r} \"\n",
