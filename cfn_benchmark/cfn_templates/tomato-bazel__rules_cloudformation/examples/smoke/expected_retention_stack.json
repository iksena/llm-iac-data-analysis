{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DeletionPolicy/UpdateReplacePolicy render beside Properties, and only where asked.",
  "Resources": {
    "SmokeDefaultRepo": {
      "Properties": {
        "RepositoryName": "smoke/default"
      },
      "Type": "AWS::ECR::Repository"
    },
    "SmokeKeptRepo": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "RepositoryName": "smoke/kept"
      },
      "Type": "AWS::ECR::Repository",
      "UpdateReplacePolicy": "Retain"
    }
  }
}