    "#      whole queue) to a smaller batch first.\n",
    "#   3. Set RUN_DEPLOYMENT = True.\n",
    "# Resumable: results are cached by scenario_id in DEPLOY_CACHE_PATH, so an\n",
    "# interrupted run (Ctrl-C, kernel restart) picks up where it left off on the\n",
    "# next run rather than re-testing already-checked rows.\n",
    "RUN_DEPLOYMENT = False\n",
    "TARGET_FOLDER_PATHS = REAL_AWS_TEST_QUEUE  # from section 2 -- narrow this for a smaller batch\n",
    "\n",
    "import os\n",
    "import shutil\n",
    "import tempfile\n",
    "import subprocess\n",
    "import pandas as pd\n",
