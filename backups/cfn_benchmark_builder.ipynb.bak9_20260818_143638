    "# %%\n",
    "# ── Utility: Purge Transient Failures from Deploy Cache for Retry ───────────\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "# Find the most recently modified deploy cache\n",
    "cache_files = sorted(DATASET_DIR.glob('deploy_cache_*.csv'), key=lambda f: f.stat().st_mtime, reverse=True)\n",
    "\n",
    "if not cache_files:\n",
    "    print(\"⚠️ No deploy cache files found in dataset directory.\")\n",
    "else:\n",
    "    target_cache = cache_files[0]\n",
    "    print(f\"📂 Loading deploy cache: {target_cache.name}\")\n",
    "\n",
    "    df_deploy = pd.read_csv(target_cache)\n",
    "    original_len = len(df_deploy)\n",
    "\n",
    "    # Deploy cache has no difficulty column -- pull it in via content_hash\n",
    "    df_difficulty = pd.read_csv(DATASET_DIR / 'df_aws_cache.csv', usecols=['content_hash', 'difficulty'])\n",
    "    df_deploy = df_deploy.merge(df_difficulty, on='content_hash', how='left')\n",
    "    mask_difficulty = df_deploy['difficulty'].isin([5])\n",
    "\n",
    "    # Re-extract core error for filtering\n",
    "    def extract_core_error(row):\n",
    "        if row.get('validate_pass') == False:\n",
    "            err = str(row.get('validate_error', ''))\n",
    "            return f\"[VALIDATION] {err.strip().split(chr(10))[0][:150]}\"\n",
    "        if row.get('deploy_pass') == False:\n",
    "            err = str(row.get('deploy_error', ''))\n",
    "            return f\"[DEPLOY] {err.strip().split(chr(10))[0][:150]}\"\n",
    "        return \"\"\n",
    "\n",
    "    df_deploy['core_error'] = df_deploy.apply(extract_core_error, axis=1)\n",
    "\n",
    "    # Substrings that mark an error as TRANSIENT (retriable)\n",
    "    TRANSIENT_SIGNATURES = [\n",
    "        \"nan\",\n",
    "        \"connection was closed before we received a valid response\",\n",
    "        \"could not connect to the endpoint url\",\n",
    "        \"service unavailable\",\n",
    "        \"(503)\",\n",
    "        \"(502)\",\n",
    "        \"timeout\",\n",
    "        \"waiter stackcreatecomplete failed\",\n",
    "        \"failed to delete\"\n",
    "    ]\n",
    "\n",
    "    def is_transient(err_str):\n",
    "        err_str = str(err_str).lower().strip()\n",
    "        # Explicit check for the \"nan\" error strings\n",
    "        if err_str in [\"[deploy] nan\", \"[validation] nan\", \"nan\"]:\n",
    "            return True\n",
    "        for sig in TRANSIENT_SIGNATURES:\n",
    "            if sig in err_str:\n",
    "                return True\n",
    "        return False\n",
    "\n",
    "    # Find the rows that failed AND match our transient signatures, L5 only\n",
    "    mask_failed = (df_deploy['validate_pass'] == False) | (df_deploy['deploy_pass'] == False)\n",
    "    mask_to_drop = mask_failed & mask_difficulty & df_deploy['core_error'].apply(is_transient)\n",
    "\n",
    "    dropped_count = mask_to_drop.sum()\n",
    "\n",
    "    if dropped_count > 0:\n",
    "        # Show a quick breakdown of what is being dropped\n",
    "        print(\"\\n🗑️ Purging the following transient errors for retry (difficulty=5 only):\")\n",
    "        print(df_deploy[mask_to_drop]['core_error'].value_counts().head(10).to_string())\n",
    "\n",
    "        # Drop them and save the clean cache. 'difficulty' was only merged in\n",
    "        # for filtering here -- it isn't part of the deploy cache's real schema,\n",
    "        # so it must not be written back or cell 10's cache reindex will break.\n",
    "        df_cleaned = df_deploy[~mask_to_drop].drop(columns=['core_error', 'difficulty'])\n",
    "        df_cleaned.to_csv(target_cache, index=False)\n",
    "\n",
    "        print(f\"\\n✅ Cleaned successfully!\")\n",
    "        print(f\"  -> Original cache size : {original_len}\")\n",
    "        print(f\"  -> Scenarios purged    : {dropped_count}\")\n",
    "        print(f\"  -> New cache size      : {len(df_cleaned)}\")\n",
    "        print(\"\\n🚀 Next Step: Scroll up and re-run Cell 10 (Deployability Check). It will automatically re-test the missing scenarios.\")\n",
    "    else:\n",
    "        print(\"\\n✅ No transient errors found matching the signatures. Nothing to clean.\")\n"
   ]
