    "# ── 3. Pre-flight: Enable AWS Services Required By The Benchmark ────────────\n",
    "# Some ground-truth scenarios use resource types/data sources that fail even\n",
    "# with a perfectly correct template, because a supporting AWS service isn't\n",
    "# already active in a fresh account -- same class of account-level\n",
    "# prerequisite already documented for the CFN track (CFN_Benchmark_Analytics.ipynb\n",
    "# section 3): AWS Config needs an active recorder+delivery channel before a\n",
    "# `aws_config_config_rule`/conformance-pack resource can attach to it,\n",
    "# Security Hub needs to already be enabled before an automation-rule\n",
    "# resource can reference it, ImageBuilder distribution needs Amazon\n",
    "# Inspector enabled for EC2 and the account's AMI block-public-access\n",
    "# setting disabled. Do NOT pre-enable GuardDuty -- an account can only have\n",
    "# one detector per region, and any scenario that creates its own\n",
    "# `aws_guardduty_detector` would then fail with a conflict instead of\n",
    "# succeeding. These are plain AWS-account-level settings, independent of\n",
    "# whether the template creating resources on top of them is CFN or\n",
    "# Terraform -- reused verbatim from CFN_Benchmark_Analytics.ipynb's own\n",
    "# pre-flight cell, just with a distinct stack name to avoid any collision.\n",
    "#\n",
    "# Cost note: same as the CFN pre-flight cell -- Config bills per\n",
    "# configuration-item-recorded + per-rule-evaluation, Security Hub has a\n",
    "# 30-day free trial then bills per check/finding, Inspector for EC2 bills\n",
    "# per instance-hour scanned (free first 15 days). Expect well under $1 for\n",
    "# one pass. Everything created here is torn down by section 6 below (or the\n",
    "# nuke sweep in section 5) -- there is no separate teardown step in this cell.\n",
    "RUN_PREFLIGHT_SETUP = False\n",
    "\n",
    "import os\n",
    "import boto3\n",
    "import botocore\n",
    "\n",
    "AWS_PROFILE = 'default'\n",
    "AWS_REGION = os.environ.get('AWS_REGION', 'us-east-1')\n",
    "\n",
    "_PREFLIGHT_STACK_NAME = 'tf-eval-gt-config-prereq'\n",
    "\n",
    "_CONFIG_PREREQ_TEMPLATE = \"\"\"\n",
    "AWSTemplateFormatVersion: '2010-09-09'\n",
    "Description: Minimal AWS Config recorder + delivery channel prerequisite, so\n",
    "  Config-rule-based ground-truth scenarios have something to attach to.\n",
    "Resources:\n",
    "  ConfigBucket:\n",
    "    Type: AWS::S3::Bucket\n",
    "    Properties:\n",
    "      BucketName: !Sub 'tf-eval-gt-config-${AWS::AccountId}-${AWS::Region}'\n",
    "  ConfigRole:\n",
    "    Type: AWS::IAM::Role\n",
    "    Properties:\n",
    "      AssumeRolePolicyDocument:\n",
    "        Version: '2012-10-17'\n",
    "        Statement:\n",
    "          - Effect: Allow\n",
    "            Principal:\n",
    "              Service: config.amazonaws.com\n",
    "            Action: sts:AssumeRole\n",
    "      ManagedPolicyArns:\n",
    "        - arn:aws:iam::aws:policy/service-role/AWS_ConfigRole\n",
    "      Policies:\n",
    "        - PolicyName: ConfigBucketDelivery\n",
    "          PolicyDocument:\n",
    "            Version: '2012-10-17'\n",
    "            Statement:\n",
    "              - Effect: Allow\n",
    "                Action:\n",
    "                  - s3:PutObject\n",
    "                  - s3:GetBucketAcl\n",
    "                Resource:\n",
    "                  - !GetAtt ConfigBucket.Arn\n",
    "                  - !Sub '${ConfigBucket.Arn}/*'\n",
    "  ConfigRecorder:\n",
    "    Type: AWS::Config::ConfigurationRecorder\n",
    "    Properties:\n",
    "      Name: default\n",
    "      RoleARN: !GetAtt ConfigRole.Arn\n",
    "      RecordingGroup:\n",
    "        AllSupported: true\n",
    "        IncludeGlobalResourceTypes: true\n",
    "  DeliveryChannel:\n",
    "    Type: AWS::Config::DeliveryChannel\n",
    "    Properties:\n",
    "      S3BucketName: !Ref ConfigBucket\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "def _preflight_config():\n",
    "    cfn = boto3.Session(profile_name=AWS_PROFILE, region_name=AWS_REGION).client('cloudformation')\n",
    "    configservice = boto3.Session(profile_name=AWS_PROFILE, region_name=AWS_REGION).client('config')\n",
    "\n",
    "    existing = configservice.describe_configuration_recorders().get('ConfigurationRecorders', [])\n",
    "    if existing:\n",
    "        print(f\"✅ AWS Config already has a recorder ({existing[0]['name']}) -- nothing to do.\")\n",
    "        return\n",
    "\n",
    "    try:\n",
    "        desc = cfn.describe_stacks(StackName=_PREFLIGHT_STACK_NAME)\n",
    "        status = desc['Stacks'][0]['StackStatus']\n",
    "        print(f\"✅ Prereq stack {_PREFLIGHT_STACK_NAME!r} already exists (status={status}).\")\n",
    "        return\n",
    "    except botocore.exceptions.ClientError:\n",
    "        pass\n",
    "\n",
    "    print(f'🔧 Creating AWS Config prerequisite stack {_PREFLIGHT_STACK_NAME!r}...')\n",
    "    cfn.create_stack(\n",
    "        StackName=_PREFLIGHT_STACK_NAME,\n",
    "        TemplateBody=_CONFIG_PREREQ_TEMPLATE,\n",
    "        Capabilities=['CAPABILITY_IAM', 'CAPABILITY_NAMED_IAM'],\n",
