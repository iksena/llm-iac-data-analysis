{
     "AWSTemplateFormatVersion": "2010-09-09",
     "Description": "Creates one public subnet per availability zone.",
     "Resources": {
          "RedVPC": {
               "Type": "AWS::EC2::VPC",
               "Properties": {
                    "CidrBlock": "10.24.24.0/21",
                    "EnableDnsSupport": true,
                    "EnableDnsHostnames": true,
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "synapse-dev-vpc-2"
                         }
                    ]
               }
          },
          "RedInternetGateway": {
               "Type": "AWS::EC2::InternetGateway",
               "Properties": {
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "synapse-dev-vpc-2-igw"
                         }
                    ]
               }
          },
          "RedVPCGatewayAttachment": {
               "Type": "AWS::EC2::VPCGatewayAttachment",
               "Properties": {
                    "VpcId": {"Ref": "RedVPC"},
                    "InternetGatewayId": {"Ref": "RedInternetGateway"}
               }
          },
          "RedPublicUsEast1a": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.27.0/26",
                    "AvailabilityZone": "us-east-1a",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPublicUsEast1a"
                         }
                    ]
               }
          },
          "RedPublicUsEast1b": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.27.64/26",
                    "AvailabilityZone": "us-east-1b",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPublicUsEast1b"
                         }
                    ]
               }
          },
          "RedPublicUsEast1c": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.27.128/26",
                    "AvailabilityZone": "us-east-1c",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPublicUsEast1c"
                         }
                    ]
               }
          },
          "RedPublicRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "RedVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPublicRouteTable"
                         }
                    ]
               }
          },
          "RedPublicDefaultRoute": {
               "Type": "AWS::EC2::Route",
               "DependsOn": "RedVPCGatewayAttachment",
               "Properties": {
                    "RouteTableId": {"Ref": "RedPublicRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "GatewayId": {"Ref": "RedInternetGateway"}
               }
          },
          "RedPublicUsEast1aRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPublicUsEast1a"},
                    "RouteTableId": {"Ref": "RedPublicRouteTable"}
               }
          },
          "RedPublicUsEast1bRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPublicUsEast1b"},
                    "RouteTableId": {"Ref": "RedPublicRouteTable"}
               }
          },
          "RedPublicUsEast1cRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPublicUsEast1c"},
                    "RouteTableId": {"Ref": "RedPublicRouteTable"}
               }
          },
          "RedPublicUsEast1aEIP": {
               "Type": "AWS::EC2::EIP",
               "DependsOn": "RedVPCGatewayAttachment",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "RedPublicUsEast1bEIP": {
               "Type": "AWS::EC2::EIP",
               "DependsOn": "RedVPCGatewayAttachment",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "RedPublicUsEast1cEIP": {
               "Type": "AWS::EC2::EIP",
               "DependsOn": "RedVPCGatewayAttachment",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "PublicUsEast1aNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["RedPublicUsEast1aEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "RedPublicUsEast1a"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1aNATGatway"
                         }
                    ]
               }
          },
          "PublicUsEast1bNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["RedPublicUsEast1bEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "RedPublicUsEast1b"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1bNATGatway"
                         }
                    ]
               }
          },
          "PublicUsEast1cNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["RedPublicUsEast1cEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "RedPublicUsEast1c"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1cNATGatway"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1a": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.24.0/24",
                    "AvailabilityZone": "us-east-1a",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1a"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1aRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "RedVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1a"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1aPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "RedPrivateUsEast1aRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1aNATGatway"}
               }
          },
          "RedPrivateUsEast1aRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1a"},
                    "RouteTableId": {"Ref": "RedPrivateUsEast1aRouteTable"}
               }
          },
          "RedPrivateUsEast1aNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1a"},
                    "NetworkAclId": {"Fn::GetAtt": ["RedVPC", "DefaultNetworkAcl"]}
               }
          },
          "RedPrivateUsEast1b": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.25.0/24",
                    "AvailabilityZone": "us-east-1b",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1b"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1bRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "RedVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1b"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1bPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "RedPrivateUsEast1bRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1bNATGatway"}
               }
          },
          "RedPrivateUsEast1bRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1b"},
                    "RouteTableId": {"Ref": "RedPrivateUsEast1bRouteTable"}
               }
          },
          "RedPrivateUsEast1bNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1b"},
                    "NetworkAclId": {"Fn::GetAtt": ["RedVPC", "DefaultNetworkAcl"]}
               }
          },
          "RedPrivateUsEast1c": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "RedVPC"},
                    "CidrBlock": "10.24.26.0/24",
                    "AvailabilityZone": "us-east-1c",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1c"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1cRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "RedVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "RedPrivateUsEast1c"
                         }
                    ]
               }
          },
          "RedPrivateUsEast1cPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "RedPrivateUsEast1cRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1cNATGatway"}
               }
          },
          "RedPrivateUsEast1cRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1c"},
                    "RouteTableId": {"Ref": "RedPrivateUsEast1cRouteTable"}
               }
          },
          "RedPrivateUsEast1cNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "RedPrivateUsEast1c"},
                    "NetworkAclId": {"Fn::GetAtt": ["RedVPC", "DefaultNetworkAcl"]}
               }
          },
          "VPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": "*",
                              "Action": ["*"],
                              "Resource": ["*"]
                         }]
                    },
                    "RouteTableIds": [
                         {"Ref": "RedPrivateUsEast1aRouteTable"},
                         {"Ref": "RedPrivateUsEast1bRouteTable"},
                         {"Ref": "RedPrivateUsEast1cRouteTable"}
                    ],
                    "ServiceName": {"Fn::Join": [
                         "",
                         [
                              "com.amazonaws.",
                              {"Ref": "AWS::Region"},
                              ".s3"
                         ]
                    ]},
                    "VpcId": {"Ref": "RedVPC"}
               }
          }
     },
     "Outputs": {
          "PrivateSubnets": {
               "Description": "Comma separated list of all private sub-nets",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "RedPrivateUsEast1a"},
                         {"Ref": "RedPrivateUsEast1b"},
                         {"Ref": "RedPrivateUsEast1c"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets"
                    ]
               ]}}
          },
          "PrivateSubnetRouteTableIds": {
               "Description": "Comma separated list of all private sub-net route table IDs",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "RedPrivateUsEast1aRouteTable"},
                         {"Ref": "RedPrivateUsEast1bRouteTable"},
                         {"Ref": "RedPrivateUsEast1cRouteTable"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets-RouteTableIds"
                    ]
               ]}}
          },
          "SubnetGroupCIDR": {
               "Description": "CIDR for this subnetgroup",
               "Value": "10.24.24.0/21",
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "CIDR"
                    ]
               ]}}
          }
     }
}
