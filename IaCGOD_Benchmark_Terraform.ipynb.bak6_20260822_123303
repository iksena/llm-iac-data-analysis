    "# %%\n",
    "# ── 2. Discover & Merge Top Terraform Repositories ────────────────────────────\n",
    "import os, json, time, hashlib, requests\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "DISCOVERED_CACHE_FILE = DATASET_DIR / 'discovered_repos_cache.json'\n",
    "HASH_CACHE_FILE = DATASET_DIR / 'discovered_queries_hash.txt'\n",
    "QUERY_CACHE_FILE = DATASET_DIR / 'query_history_cache.json'\n",
    "\n",
    "DISCOVERED_REPOS_DICT = {}\n",
    "QUERY_HISTORY = {}\n",
    "\n",
    "# ── 1. Define the Search Queries (Terraform Specific) ──\n",
    "REPO_SEARCH_QUERIES = [\n",
    "    \"topic:terraform stars:>10\",\n",
    "    \"topic:aws-terraform stars:>10\",\n",
    "    \"terraform aws in:name,description,topics stars:>10\",\n",
    "    \"tf aws in:name,description,topics stars:>10\",\n",
    "    \"terraform examples aws stars:>10\",\n",
    "\n",
    "    # Strategy E: License-biased discovery (mirrors cfn_benchmark_builder.ipynb).\n",
    "    # GitHub's license: qualifier only matches repos that already declare a\n",
    "    # licence, so this spends discovery effort on repos the ethical licence\n",
    "    # filter (Cell 3) can actually approve -- unlike the CODE_SEARCH_QUERIES\n",
    "    # complexity strategies below, where a large share of hits turn out to\n",
    "    # be unlicensed and get correctly excluded (absence of a LICENSE file\n",
    "    # means all rights reserved by default under GitHub's ToS, NOT an\n",
    "    # implicit permissive grant -- see CLAUDE.md; this filter should not be\n",
    "    # relaxed to work around that). This doesn't touch the ethical filter\n",
    "    # itself, it just improves the discovery hit rate against it.\n",
    "    \"topic:terraform license:mit stars:>5\",\n",
    "    \"topic:terraform license:apache-2.0 stars:>5\",\n",
    "    \"topic:terraform license:mit-0 stars:>5\",\n",
