    "# ── 3. Joint LOC x Resource-Count Difficulty Boundary (this benchmark's own\n",
    "#      classifier, visualized directly) ──────────────────────────────────────\n",
    "plt.figure(figsize=(10, 7))\n",
    "scatter = sns.scatterplot(\n",
    "    data=df, x='loc', y='n_resources', hue='difficulty', palette='viridis',\n",
    "    s=60, alpha=0.75, edgecolor='white', linewidth=0.5,\n",
    ")\n",
    "\n",
    "# Draw the joint LOC x #Resource thresholds actually used by\n",
    "# calculate_difficulty_cfn() (cell 6 of cfn_benchmark_builder.ipynb) so the\n",
    "# scatter directly shows *why* each point landed at its difficulty level.\n",
    "thresholds = [(80, 2), (150, 4), (250, 8), (400, 12)]\n",
    "for loc_t, res_t in thresholds:\n",
    "    plt.axvline(loc_t, color='gray', linestyle='--', linewidth=0.8, alpha=0.6)\n",
    "    plt.axhline(res_t, color='gray', linestyle='--', linewidth=0.8, alpha=0.6)\n",
    "\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.title('Difficulty Assignment: Joint LOC x #Resources Thresholds', fontsize=14)\n",
    "plt.xlabel('Lines of Code (log scale)')\n",
    "plt.ylabel('# Resources (log scale)')\n",
    "plt.legend(title='Difficulty', bbox_to_anchor=(1.02, 1), loc='upper left')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
