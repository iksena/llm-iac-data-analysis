    "# ── Utility: Delete .git Folders to Recover Disk Space ────────────────────────\n",
    "import shutil\n",
    "import pathlib\n",
    "from tqdm.notebook import tqdm\n",
    "\n",
    "# Ensure REPOS_DIR is defined\n",
