{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Conditions": {
        "SetSonarqubeBucketName": {
            "Fn::Not": [
                {
                    "Fn::Equals": [
                        {
                            "Ref": "BucketName"
                        },
                        ""
                    ]
                }
            ]
        },
        "UseSonarqubeBucketInventoryTracking": {
            "Fn::Equals": [
                {
                    "Ref": "BucketInventoryTracking"
                },
                "true"
            ]
        },
        "UseBackupReportingLocation": {
            "Fn::Not": [
                {
                    "Fn::Equals": [
                        {
                            "Ref": "ReportingBucket"
                        },
                        ""
                    ]
                }
            ]
        }
    },
    "Description": "This template sets up the Buckets used by Sonarqube for S3-based storage",
    "Outputs": {
        "BucketArn": {
            "Description": "Sonarqube S3 bucket ARN.",
            "Export": {
                "Name": {
                    "Fn::Sub": "${AWS::StackName}-SonarqubeBucketArn"
                }
            },
            "Value": {
                "Fn::GetAtt": [
                    "SonarqubeS3Bucket",
                    "Arn"
                ]
            }
        },
        "BucketName": {
            "Description": "Sonarqube S3 backup bucket name.",
            "Export": {
                "Name": {
                    "Fn::Sub": "${AWS::StackName}-SonarqubeBucket"
                }
            },
            "Value": {
                "Ref": "SonarqubeS3Bucket"
            }
        }
    },
    "Parameters": {
        "BucketInventoryTracking": {
            "Type": "String"
        },
        "BucketName": {
            "Type": "String"
        },
        "FinalExpirationDays": {
            "Type": "Number"
        },
        "ReportingBucket": {
            "Type": "String"
        },
        "RetainIncompleteDays": {
            "Type": "Number"
        },
        "TierToGlacierDays": {
            "Type": "Number"
        },
        "VpcId": {
            "Type": "String"
        }
    },
    "Resources": {
        "SonarqubeS3Bucket": {
            "Type": "AWS::S3::Bucket",
            "Properties": {
                "AccessControl": "BucketOwnerFullControl",
                "AnalyticsConfigurations": [
                    {
                        "Id": "Archivable",
                        "Prefix": "Backups/",
                        "StorageClassAnalysis": {
                            "DataExport": {
                                "Fn::If": [
                                    "UseBackupReportingLocation",
                                    {
                                        "Destination": {
                                            "BucketArn": {
                                                "Ref": "ReportingBucket"
                                            },
                                            "Format": "CSV",
                                            "Prefix": "StorageReporting/Analytics"
                                        },
                                        "OutputSchemaVersion": "V_1"
                                    },
                                    {
                                        "Ref": "AWS::NoValue"
                                    }
                                ]
                            }
                        }
                    }
                ],
                "BucketName": {
                    "Fn::If": [
                        "SetSonarqubeBucketName",
                        {
                            "Ref": "BucketName"
                        },
                        {
                            "Ref": "AWS::NoValue"
                        }
                    ]
                },
                "BucketEncryption": {
                    "ServerSideEncryptionConfiguration": [
                        {
                            "ServerSideEncryptionByDefault": {
                                "SSEAlgorithm": "AES256"
                            }
                        }
                    ]
                },
                "InventoryConfigurations": [
                    {
                        "Fn::If": [
                            "UseSonarqubeBucketInventoryTracking",
                            {
                                "Destination": {
                                    "BucketArn": {
                                        "Ref": "ReportingBucket"
                                    },
                                    "Format": "CSV",
                                    "Prefix": "StorageReporting/Inventory"
                                },
                                "Enabled": true,
                                "Id": "Inventory",
                                "IncludedObjectVersions": "Current",
                                "Prefix": "Backups/",
                                "ScheduleFrequency": "Weekly"
                            },
                            {
                                "Ref": "AWS::NoValue"
                            }
                        ]
                    }
                ],
                "LifecycleConfiguration": {
                    "Rules": [
                        {
                            "AbortIncompleteMultipartUpload": {
                                "DaysAfterInitiation": {
                                    "Ref": "RetainIncompleteDays"
                                }
                            },
                            "ExpirationInDays": {
                                "Ref": "FinalExpirationDays"
                            },
                            "Id": "Tiering",
                            "Prefix": "Backups/",
                            "Status": "Enabled",
                            "Transitions": [
                                {
                                    "StorageClass": "GLACIER",
                                    "TransitionInDays": {
                                        "Ref": "TierToGlacierDays"
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        },
        "BucketPolicy": {
            "Type": "AWS::S3::BucketPolicy",
            "DeletionPolicy": "Retain",
            "Properties": {
                "Bucket": {
                    "Ref": "SonarqubeS3Bucket"
                },
                "PolicyDocument": {
                    "Id": "Policy1551191669608",
                    "Version": "2012-10-17",
                    "Statement": [
                        {
                            "Sid": "DenyUnsecureS3Endpoint",
                            "Effect": "Deny",
                            "Principal": "*",
                            "Action": [
                                "s3:GetObject",
                                "s3:PutObject"
                            ],
                            "Resource": [
                                {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":s3:::",
                                            {
                                                "Ref": "BucketName"
                                            }
                                        ]
                                    ]
                                },
                                {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":s3:::",
                                            {
                                                "Ref": "BucketName"
                                            },
                                            "/*"
                                        ]
                                    ]
                                }
                            ],
                            "Condition": {
                                "Bool": {
                                    "aws:SecureTransport": "false"
                                }
                            }
                        },
                        {
                            "Sid": "SonarqubeBackupPolicy20190910",
                            "Action": [
                                "s3:GetObject",
                                "s3:PutObject"
                            ],
                            "Effect": "Allow",
                            "Resource": [
                                {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":s3:::",
                                            {
                                                "Ref": "BucketName"
                                            }
                                        ]
                                    ]
                                },
                                {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":s3:::",
                                            {
                                                "Ref": "BucketName"
                                            },
                                            "/*"
                                        ]
                                    ]
                                }
                            ],
                            "Principal": "*",
                            "Condition": {
                                "StringLike": {
                                    "aws:SourceVpc": {
                                        "Ref": "VpcId"
                                    }
                                }
                            }
                        }
                    ]
                }
            }
        }
    }
}