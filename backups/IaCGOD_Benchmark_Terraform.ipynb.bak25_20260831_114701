    "# %%\n",
    "# \u2500\u2500 14b. Post-Resample Near-Duplicate Check \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Cell 14's dedup-aware sampling loop only guards against introducing a NEW\n",
    "# near-duplicate alongside the currently-kept set *for that run's shortfall\n",
    "# fill* -- it never re-scans the full assembled set against itself. Two rows\n",
    "# that each independently entered \"kept\" at different points in time (e.g.\n",
    "# one carried forward across many reruns, another added in a more recent\n",
    "# resample) are never compared against each other, so a pre-existing\n",
    "# near-duplicate pair can silently persist across future resamples. This\n",
    "# cell runs TWO complementary checks against the freshly-assembled\n",
    "# final_benchmark_with_prompts.csv, mirroring cfn_benchmark_builder.ipynb's\n",
    "# Cell 14b (see CLAUDE.md's \"Dedup is layered, not duplicated\" convention):\n",
    "#\n",
    "#   1. Content-similarity: same blocking-key ((n_resources, aws_services))\n",
    "#      + difflib.quick_ratio >= 0.90, checked across ALL pairs (not just\n",
    "#      new-vs-kept).\n",
    "#   2. Same-folder-path: flags any folder_path used by more than one row --\n",
    "#      should never happen if Cell 14 is working correctly, but is cheap to\n",
    "#      check and catches a class of bookkeeping bug directly (Terraform has\n",
    "#      no dual-root \"manual-fix\" convention like CFN's cfn_templates_greenfield/,\n",
    "#      so this simpler check is the TF-side equivalent).\n",
    "#\n",
    "# Remedy once a pair is confirmed: add the folder_path you want dropped to\n",
    "# MANUAL_EXCLUDE_FOLDER_PATHS in Cell 14 above and rerun it -- the resample\n",
    "# loop will backfill a fresh, truly distinct replacement at the same\n",
    "# row_number.\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "from pathlib import Path\n",
    "import pandas as pd\n",
    "\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "PROMPTS_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "\n",
    "df_check = pd.read_csv(PROMPTS_CSV)\n",
    "\n",
    "def read_tf_content(folder_path_str):\n",
    "    folder = Path(folder_path_str)\n",
    "    if not folder.exists(): return \"\"\n",
    "    tf_files = sorted(folder.glob('*.tf'))\n",
    "    return \"\\n\\n\".join(f.read_text(encoding='utf-8', errors='ignore').strip() for f in tf_files)\n",
    "\n",
    "df_check['content'] = df_check['folder_path'].apply(read_tf_content)\n",
    "\n",
    "# \u2500\u2500 Check 1: content-similarity, block-key optimized \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row.get('aws_services', '')).split(', ')))\n",
    "\n",
    "blocks = defaultdict(list)\n",
    "for _, row in df_check.iterrows():\n",
    "    blocks[_block_key(row)].append(row)\n",
    "\n",
    "DUP_THRESHOLD = 0.90\n",
    "content_dup_pairs = []\n",
    "for key, rows in blocks.items():\n",
    "    if len(rows) < 2:\n",
    "        continue\n",
    "    for i in range(len(rows)):\n",
    "        for j in range(i + 1, len(rows)):\n",
    "            a, b = rows[i], rows[j]\n",
    "            ratio = difflib.SequenceMatcher(None, a['content'], b['content']).quick_ratio()\n",
    "            if ratio >= DUP_THRESHOLD:\n",
    "                content_dup_pairs.append((a, b, ratio))\n",
    "\n",
    "# \u2500\u2500 Check 2: same folder_path used more than once \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "path_groups = defaultdict(list)\n",
    "for _, row in df_check.iterrows():\n",
    "    path_groups[row['folder_path']].append(row)\n",
    "\n",
    "path_dups = {p: rows for p, rows in path_groups.items() if len(rows) > 1}\n",
    "\n",
    "any_found = bool(content_dup_pairs) or bool(path_dups)\n",
    "\n",
    "if content_dup_pairs:\n",
    "    print(f\"\u26a0\ufe0f Content-similarity check: {len(content_dup_pairs)} near-duplicate pair(s) (quick_ratio >= {DUP_THRESHOLD}):\")\n",
    "    for a, b, ratio in sorted(content_dup_pairs, key=lambda t: -t[2]):\n",
    "        print(f\"\\n  similarity={ratio:.3f}\")\n",
    "        print(f\"    row {a['row_number']} (difficulty {a['difficulty']}): {a['folder_path']}\")\n",
    "        print(f\"    row {b['row_number']} (difficulty {b['difficulty']}): {b['folder_path']}\")\n",
    "else:\n",
    "    print(f\"\u2705 Content-similarity check: no pairs found (quick_ratio >= {DUP_THRESHOLD}).\")\n",
    "\n",
    "print()\n",
    "if path_dups:\n",
    "    print(f\"\u26a0\ufe0f Same-folder-path check: {len(path_dups)} folder(s) used by more than one row:\")\n",
    "    for p, rows in path_dups.items():\n",
    "        print(f\"\\n  folder: {p}\")\n",
    "        for row in rows:\n",
    "            print(f\"    row {row['row_number']} (difficulty {row['difficulty']})\")\n",
    "else:\n",
    "    print(\"\u2705 Same-folder-path check: no folder is used by more than one row.\")\n",
    "\n",
    "if any_found:\n",
    "    print(\"\\nTo resolve: add the folder_path you want dropped to MANUAL_EXCLUDE_FOLDER_PATHS in Cell 14 above and rerun it.\")\n"
   ]
