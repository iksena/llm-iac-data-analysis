    "    # Deploy cache only stores content_hash + validate/deploy results -- pull\n",
    "    # difficulty back in via content_hash so we can filter to L5 retries.\n",
    "    df_difficulty = pd.read_csv(DATASET_DIR / 'df_aws_cache.csv', usecols=['content_hash', 'difficulty'])\n",
    "    df_deploy = df_deploy.merge(df_difficulty, on='content_hash', how='left')\n",
    "\n",
    "    # Identify failures (either failed template validation OR failed stack deployment)\n",
    "    mask_val_fail = df_deploy['validate_pass'] == False\n",
    "    mask_dep_fail = df_deploy['deploy_pass'] == False\n",
    "    mask_difficulty = df_deploy['difficulty'].isin([5])\n",
    "\n",
    "    df_failed = df_deploy[(mask_val_fail | mask_dep_fail) & mask_dep_fail & mask_difficulty].copy()\n",
    "\n",
    "    print(f\"\ud83d\udd0d Found {len(df_failed)} total failed scenarios out of {len(df_deploy)} attempts (difficulty=5 only).\")\n",
    "\n",
    "    # \u2500\u2500 Extract and Clean Error Messages \u2500\u2500\n",
    "    def extract_core_error(row):\n",
    "        # If it failed validation, return the validate error\n",
    "        if row.get('validate_pass') == False:\n",
    "            err = row.get('validate_error')\n",
    "            err = 'Unknown Validation Error' if pd.isna(err) or str(err).strip() == '' else str(err)\n",
    "            return f\"[VALIDATION] {err.strip().split(chr(10))[0][:150]}\"\n",
    "\n",
    "        # If it failed deployment, return the deploy error\n",
    "        if row.get('deploy_pass') == False:\n",
    "            err = row.get('deploy_error')\n",
    "            err = 'Unknown Deployment Error (no StackStatusReason captured)' if pd.isna(err) or str(err).strip() == '' else str(err)\n",
    "            return f\"[DEPLOY] {err.strip().split(chr(10))[0][:150]}\"\n",
    "\n",
    "        return \"Unknown Error\"\n",
    "\n",
    "    if not df_failed.empty:\n",
    "        df_failed['core_error'] = df_failed.apply(extract_core_error, axis=1)\n",
    "\n",
    "        print(\"\\n\ud83d\udcca Top Deployment & Validation Errors:\")\n",
    "        error_counts = df_failed['core_error'].value_counts()\n",
    "\n",
    "        for err, count in error_counts.head(20).items():\n",
    "            print(f\"  [{count:3d}] {err}\")\n",
    "\n",
    "        # \u2500\u2500 Optional: Export failures for review \u2500\u2500\n",
    "        export_path = DATASET_DIR / 'cfn_deploy_failures_review.csv'\n",
    "        cols_to_export = ['content_hash', 'validate_pass', 'deploy_pass', 'core_error']\n",
    "\n",
    "        # Include difficulty if available to see which levels are failing the most\n",
    "        if 'difficulty' in df_failed.columns:\n",
    "            cols_to_export.insert(1, 'difficulty')\n",
    "\n",
    "        df_failed[cols_to_export].to_csv(export_path, index=False)\n",
    "        print(f\"\\n\ud83d\udcc1 Exported detailed failure list to: {export_path.name}\")\n",
    "\n",
