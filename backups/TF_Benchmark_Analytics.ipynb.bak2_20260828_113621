    "# %%\n",
    "# ── 7b. Real-AWS Post-Resample Near-Duplicate Check ───────────────────────\n",
    "# Section 1's dedup-aware sampling loop only guards against introducing a NEW\n",
    "# near-duplicate alongside the EXISTING kept set -- it never re-scans the\n",
    "# kept set against itself. Runs two checks against the freshly-assembled\n",
    "# final_benchmark_real_aws_with_prompts.csv: content-similarity (same\n",
    "# blocking-key + difflib.quick_ratio>=0.90 methodology used everywhere else\n",
    "# in this pipeline) and same-folder-path (a manual-fix scenario whose\n",
    "# original source file is ALSO still sitting in the general candidate pool\n",
    "# would otherwise get counted twice -- same failure mode already documented\n",
    "# for the LocalStack track, see CLAUDE.md).\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "\n",
    "PROMPTS_CSV = DATASET_DIR / 'final_benchmark_real_aws_with_prompts.csv'\n",
    "\n",
    "df_check = pd.read_csv(PROMPTS_CSV)\n",
    "df_check['content'] = df_check['folder_path'].apply(read_tf_content)\n",
    "\n",
    "blocks = defaultdict(list)\n",
    "for _, row in df_check.iterrows():\n",
    "    blocks[_block_key(row)].append(row)\n",
    "\n",
    "DUP_THRESHOLD = 0.90\n",
    "content_dup_pairs = []\n",
    "for key, rows in blocks.items():\n",
    "    if len(rows) < 2:\n",
    "        continue\n",
    "    for i in range(len(rows)):\n",
    "        for j in range(i + 1, len(rows)):\n",
    "            a, b = rows[i], rows[j]\n",
    "            ratio = difflib.SequenceMatcher(None, a['content'], b['content']).quick_ratio()\n",
    "            if ratio >= DUP_THRESHOLD:\n",
    "                content_dup_pairs.append((a, b, ratio))\n",
    "\n",
    "path_groups = defaultdict(list)\n",
    "for _, row in df_check.iterrows():\n",
    "    path_groups[row['folder_path']].append(row)\n",
    "path_dups = {p: rows for p, rows in path_groups.items() if len(rows) > 1}\n",
    "\n",
    "any_found = bool(content_dup_pairs) or bool(path_dups)\n",
    "\n",
    "if content_dup_pairs:\n",
