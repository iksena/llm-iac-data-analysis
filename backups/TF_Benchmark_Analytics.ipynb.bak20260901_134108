    "\n",
    "    file_has_header = DEPLOY_CACHE_PATH.exists() and DEPLOY_CACHE_PATH.stat().st_size > 0\n",
    "    batch_data = []\n",
    "    new_count = 0\n",
    "    n_orphaned = 0\n",
    "\n",
    "    try:\n",
    "        from tqdm.notebook import tqdm\n",
