    "            time.sleep(min(2 ** attempt, 30))\n",
    "            last_status = f'EXC:{e}'\n",
    "            continue\n",
    "\n",
    "        last_status = r.status_code\n",
    "        remaining = r.headers.get('X-RateLimit-Remaining')\n",
    "        reset_at  = r.headers.get('X-RateLimit-Reset')\n",
    "\n",
    "        if r.status_code == 200:\n",
