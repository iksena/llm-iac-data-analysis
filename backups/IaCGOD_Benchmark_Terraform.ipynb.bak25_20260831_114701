    "else:\n",
    "    df_deploy = pd.read_csv(DEPLOY_PASSED_CSV)\n",
    "    df_final = pd.read_csv(PROMPTS_CSV)\n",
    "\n",
    "    # \u2500\u2500 0. Reconcile against the EXISTING frozen benchmark (stable row_number) \u2500\u2500\n",
