    "# %%\n",
    "# ── 13b. Recalculate Difficulty for the Full Pipeline ─────────────────────\n",
    "# Difficulty is normally computed exactly once (cell 6, calculate_difficulty_cfn)\n",
    "# from freshly-scraped content before any pipeline gates run, and is supposed\n",
    "# to be carried through unchanged downstream. In practice, cfn_benchmark.csv\n",
    "# (the deploy-verified candidate pool cell 14 reads as df_deployable) is a\n",
    "# CACHED export that can predate a calculate_difficulty_cfn threshold rewrite\n",
    "# -- its loc/n_resources are still correct (structural properties of the\n",
    "# content, independent of the formula), but the difficulty LABEL derived from\n",
    "# them can be stale. Relabeling from already-stored loc/n_resources is safe\n",
    "# and cheap (no re-read of 2500+ files, no re-lint/re-security/re-deploy --\n",
    "# difficulty is a stratification label, not a validity gate).\n",
    "#\n",
    "# Manually-authored/hand-edited ground truth (source_category == 'manual-fix',\n",
    "# stored under cfn_templates_greenfield/) never enters cfn_benchmark.csv at\n",
    "# all -- it's not part of the deploy-verified pool -- so it needs its own\n",
    "# pass, re-reading actual current dest_file content, against\n",
    "# final_benchmark_with_prompts.csv directly.\n",
    "#\n",
    "# This is NOT a general override of cell 6's authority -- content that was\n",
    "# already labeled under the CURRENT formula recomputes to the same value, so\n",
    "# this is a no-op for it either way.\n",
    "import json as _json, re as _re\n",
    "import pandas as pd\n",
    "import yaml\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "CFN_BENCHMARK_CSV = DATASET_DIR / 'cfn_benchmark.csv'\n",
    "PROMPTS_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "\n",
    "def calculate_difficulty_cfn_metrics(loc, res):\n",
    "    if   loc >= 200 and res >= 12: return 5\n",
    "    elif loc >= 150 and res >= 8:  return 4\n",
    "    elif loc >= 100 and res >= 4:  return 3\n",
    "    elif loc >= 50  and res >= 2:  return 2\n",
    "    else: return 1\n",
    "\n",
    "# ── Part A: cfn_benchmark.csv (the deploy-verified pool) -- cheap relabel\n",
    "# from already-stored loc/n_resources, no file I/O needed. ──────────────────\n",
    "if CFN_BENCHMARK_CSV.exists():\n",
    "    df_pool = pd.read_csv(CFN_BENCHMARK_CSV)\n",
    "    recalculated = df_pool.apply(lambda r: calculate_difficulty_cfn_metrics(r['loc'], r['n_resources']), axis=1)\n",
    "    pool_drift_mask = recalculated != df_pool['difficulty']\n",
    "    n_pool_drift = pool_drift_mask.sum()\n",
    "    if n_pool_drift:\n",
    "        print(f\"⚠️ cfn_benchmark.csv: {n_pool_drift} / {len(df_pool)} row(s) had a stale difficulty -- corrected.\")\n",
    "        print('  Old distribution:', df_pool['difficulty'].value_counts().sort_index().to_dict())\n",
    "        df_pool['difficulty'] = recalculated\n",
    "        print('  New distribution:', df_pool['difficulty'].value_counts().sort_index().to_dict())\n",
    "        df_pool.to_csv(CFN_BENCHMARK_CSV, index=False)\n",
    "        print(f\"💾 Saved corrected difficulty back to {CFN_BENCHMARK_CSV.name}\")\n",
    "    else:\n",
    "        print(f\"✅ {CFN_BENCHMARK_CSV.name}: no difficulty drift found.\")\n",
    "else:\n",
    "    print(f\"⚠️ {CFN_BENCHMARK_CSV.name} not found -- skipping pool relabel.\")\n",
    "\n",
    "# ── Part B: final_benchmark_with_prompts.csv (the frozen output) -- re-read\n",
    "# actual current dest_file content, since this file includes manually-edited\n",
    "# rows that aren't part of cfn_benchmark.csv at all. ─────────────────────────\n",
    "class _DifficultyAuditLoader(yaml.SafeLoader):\n",
    "    pass\n",
    "\n",
    "def _construct_cfn_tag_audit(loader, node):\n",
    "    if isinstance(node, yaml.ScalarNode):\n",
    "        return loader.construct_scalar(node)\n",
    "    elif isinstance(node, yaml.SequenceNode):\n",
    "        return loader.construct_sequence(node)\n",
    "    elif isinstance(node, yaml.MappingNode):\n",
    "        return loader.construct_mapping(node)\n",
    "\n",
    "for _tag in ['!Ref','!Sub','!GetAtt','!Join','!Select','!Split','!Equals','!If',\n",
    "             '!FindInMap','!GetAZs','!Base64','!Cidr','!Transform','!ImportValue',\n",
    "             '!Not','!And','!Or','!Condition','!ForEach','!ValueOf','!Rain::Embed']:\n",
    "    _DifficultyAuditLoader.add_constructor(_tag, _construct_cfn_tag_audit)\n",
    "\n",
    "def _parse_cfn_for_audit(content):\n",
    "    try:\n",
    "        if content.strip().startswith('{'):\n",
    "            return _json.loads(content)\n",
    "        return yaml.load(content, Loader=_DifficultyAuditLoader)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "def _normalise_for_loc(text):\n",
    "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n",
    "    text = '\\n'.join(line.rstrip() for line in text.split('\\n'))\n",
    "    text = _re.sub(r'\\n{3,}', '\\n\\n', text)\n",
    "    return text.strip()\n",
    "\n",
    "df_freeze = pd.read_csv(PROMPTS_CSV)\n",
    "\n",
    "drift_rows = []\n",
    "for idx, row in df_freeze.iterrows():\n",
    "    p = BASE_DIR / str(row['dest_file'])\n",
    "    if not p.exists():\n",
    "        continue\n",
    "    content = p.read_text(encoding='utf-8', errors='ignore')\n",
    "    content_norm = _normalise_for_loc(content)\n",
    "    parsed = _parse_cfn_for_audit(content)\n",
    "    resources = parsed.get('Resources', {}) if isinstance(parsed, dict) else {}\n",
    "    if not isinstance(resources, dict):\n",
    "        resources = {}\n",
    "    loc = content_norm.count('\\n') + 1\n",
    "    n_resources = len(resources)\n",
    "    recalc = calculate_difficulty_cfn_metrics(loc, n_resources)\n",
    "\n",
    "    if recalc != int(row['difficulty']):\n",
    "        drift_rows.append({\n",
    "            'row_number': row['row_number'],\n",
    "            'dest_file': row['dest_file'],\n",
    "            'recorded_difficulty': int(row['difficulty']),\n",
    "            'recalculated_difficulty': recalc,\n",
    "            'loc': loc,\n",
    "            'n_resources': n_resources,\n",
    "        })\n",
    "        df_freeze.at[idx, 'difficulty'] = recalc\n",
    "        df_freeze.at[idx, 'loc'] = loc\n",
    "        df_freeze.at[idx, 'n_resources'] = n_resources\n",
    "\n",
    "if drift_rows:\n",
    "    print(f\"\\n⚠️ {PROMPTS_CSV.name}: {len(drift_rows)} row(s) had a stale difficulty -- corrected:\")\n",
    "    for d in drift_rows:\n",
    "        print(f\"   row {d['row_number']}: difficulty {d['recorded_difficulty']} -> {d['recalculated_difficulty']} \"\n",
    "              f\"(loc={d['loc']}, n_resources={d['n_resources']}) -- {d['dest_file']}\")\n",
    "    df_freeze.to_csv(PROMPTS_CSV, index=False)\n",
    "    print(f\"\\n💾 Saved corrected difficulty back to {PROMPTS_CSV.name}\")\n",
    "else:\n",
    "    print(f\"\\n✅ {PROMPTS_CSV.name}: no difficulty drift found.\")\n"
   ]
