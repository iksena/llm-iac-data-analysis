{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "UseSnapshot": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "DBSnapshotId"
            },
            ""
          ]
        }
      ]
    },
    "PROD": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "PROD"
      ]
    },
    "UNCLASS": {
      "Fn::Equals": [
        {
          "Ref": "AWS::Partition"
        },
        "aws"
      ]
    }
  },
  "Description": "This template deploys a PGSQL database to host configuration data.",
  "Outputs": {
    "DBName": {
      "Description": "RDS DB's instance-name.",
      "Value": {
        "Ref": "DBName"
      }
    },
    "DBUsername": {
      "Description": "RDS DB's root user name.",
      "Value": {
        "Ref": "DBUsername"
      }
    },
    "DBPassword": {
      "Description": "RDS DB's root user's password.",
      "Value": {
        "Ref": "DBPassword"
      }
    },
    "EndpointAddress": {
      "Description": "RDS DB's endpoint FQDN.",
      "Value": {
        "Fn::GetAtt": [
          "DBInstance",
          "Endpoint.Address"
        ]
      }
    }
  },
  "Parameters": {
    "ParentStack": {
      "Type": "String"
    },
    "DBUsername": {
      "Type": "String"
    },
    "DBPassword": {
      "NoEcho": "true",
      "Type": "String"
    },
    "DBName": {
      "Type": "String"
        },
        "DBEngineVersion": {
            "Type": "String"
        },
        "DBParameterFamily": {
            "Type": "String"
        },
        "DBSize": {
            "Type": "String"
        },
    "VPCSecurityGroups": {
      "Type": "List<AWS::EC2::SecurityGroup::Id>"
    },
    "DBSnapshotId": {
      "Type": "String",
      "Default": ""
    },
    "SubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "RDSInstanceClass": {
      "Type": "String"
    },
    "Environment": {
      "Type": "String"
    }
  },
  "Resources": {
    "DBInstance": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Delete",
      "Properties": {
        "AllocatedStorage": {
                    "Fn::If": [
                        "UseSnapshot",
                        {
                            "Ref": "AWS::NoValue"
                        },
                        {
                            "Ref": "DBSize"
                        }
                    ]
                },
        "AllowMajorVersionUpgrade": true,
        "AutoMinorVersionUpgrade": false,
        "BackupRetentionPeriod": "7",
        "DBInstanceClass": {
          "Ref": "RDSInstanceClass"
        },
        "DBInstanceIdentifier": {
          "Ref": "ParentStack"
        },
        "DBName": {
          "Fn::If": [
            "UseSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            {
              "Ref": "DBName"
            }
          ]
        },
        "MasterUsername": {
          "Fn::If": [
            "UseSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            {
              "Ref": "DBUsername"
            }
          ]
        },
        "MasterUserPassword": {
          "Fn::If": [
            "UseSnapshot",
            {
              "Ref": "AWS::NoValue"
            },
            {
              "Ref": "DBPassword"
            }
          ]
        },
        "DBSnapshotIdentifier": {
          "Fn::If": [
            "UseSnapshot",
            {
              "Ref": "DBSnapshotId"
            },
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "DBParameterGroupName": {
          "Ref": "DBParameterGroup"
        },
        "DBSubnetGroupName": {
          "Ref": "DBSubnetGroup"
        },
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "DBEngineVersion"
        },
        "MultiAZ": {
          "Fn::If": [
            "PROD",
            true,
            false
          ]
        },
        "PreferredBackupWindow": "23:30-00:00",
        "PreferredMaintenanceWindow": "sun:00:30-sun:01:00",
        "PubliclyAccessible": false,
        "StorageType": "gp2",
        "VPCSecurityGroups": {
          "Ref": "VPCSecurityGroups"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Ref": "ParentStack"
            }
          },
          {
            "Fn::If": [
              "PROD",
              {
                "Fn::If": [
                  "UNCLASS",
                  {
                    "Key": "CT_CLAP_IGNORE",
                    "Value": "true"
                  },
                  {
                    "Ref": "AWS::NoValue"
                  }
                ]
              },
              {
                "Key": "CLAP_OFF",
                "Value": "18:00"
              }
            ]
          }
        ]
      }
    },
    "DBParameterGroup": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Parameters used to modify database behavior and performance characteristics",
        "Family": {
                    "Ref": "DBParameterFamily"
                },
        "Parameters": {
          "work_mem": 65536
        }
      }
    },
    "DBSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Subnets available for the RDS DB Instance",
        "SubnetIds": {
          "Ref": "SubnetIds"
        }
      }
    }
  }
}