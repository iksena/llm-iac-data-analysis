    "# ── CFN metrics: n_resources, n_parameters, resource_types, cfn_description ───\n",
    "from tqdm import tqdm\n",
    "tqdm.pandas()\n",
    "\n",
    "# ── CFN-aware YAML loader ──────────────────────────────────────────────────────\n",
    "# Plain yaml.safe_load throws on CloudFormation's short-form intrinsic-function\n",
    "# tags (!Ref, !GetAtt, !Sub, !Join, ...), which are extremely common in\n",
    "# real-world templates. Without a fix, every template using them silently\n",
    "# fails to parse and is undercounted (n_resources -> 0). We register\n",
    "# constructors that map each short tag back to its long Fn:: form as a 1-key\n",
    "# dict, so the result is structurally identical to what json.loads would\n",
    "# produce for the equivalent JSON template.\n",
    "class CfnYamlLoader(yaml.SafeLoader):\n",
    "    pass\n",
    "\n",
    "def _cfn_multi_constructor(loader, tag_suffix, node):\n",
    "    key = tag_suffix if tag_suffix == 'Ref' else f'Fn::{tag_suffix}'\n",
    "    if isinstance(node, yaml.ScalarNode):\n",
    "        value = loader.construct_scalar(node)\n",
    "        if key == 'Fn::GetAtt' and isinstance(value, str) and '.' in value:\n",
    "            value = value.split('.')\n",
    "    elif isinstance(node, yaml.SequenceNode):\n",
    "        value = loader.construct_sequence(node)\n",
    "    else:\n",
    "        value = loader.construct_mapping(node)\n",
    "    return {key: value}\n",
    "\n",
    "CfnYamlLoader.add_multi_constructor('!', _cfn_multi_constructor)\n",
    "\n",
    "def parse_cfn_metrics(row):\n",
    "    content = row.get('content') or row.get('template_body') or ''\n",
    "    if not isinstance(content, str) or not content.strip():\n",
    "        return {'n_resources': 0, 'n_parameters': 0,\n",
    "                'resource_types': '', 'cfn_description': ''}\n",
    "\n",
    "    parsed = None\n",
    "    for loader in [json.loads, lambda c: yaml.load(c, Loader=CfnYamlLoader)]:\n",
    "        try:\n",
    "            parsed = loader(content)\n",
    "            if isinstance(parsed, dict):\n",
    "                break\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "    if not isinstance(parsed, dict):\n",
    "        return {'n_resources': 0, 'n_parameters': 0,\n",
    "                'resource_types': '', 'cfn_description': ''}\n",
    "\n",
    "    resources  = parsed.get('Resources', {}) or {}\n",
    "    parameters = parsed.get('Parameters', {}) or {}\n",
    "    if not isinstance(resources, dict):  resources = {}\n",
    "    if not isinstance(parameters, dict): parameters = {}\n",
    "\n",
    "    resource_types = sorted({\n",
    "        str(v.get('Type', '')) for v in resources.values()\n",
    "        if isinstance(v, dict)\n",
    "    })\n",
    "\n",
    "    return {\n",
    "        'n_resources'    : len(resources),\n",
    "        'n_parameters'   : len(parameters),\n",
    "        'resource_types' : ' | '.join(t for t in resource_types if t),\n",
    "        'cfn_description': str(parsed.get('Description', ''))[:200],\n",
    "    }\n",
    "\n",
    "# ── Drop stale columns from any previous failed run ───────────────────────────\n",
    "stale = ['n_resources', 'n_parameters', 'resource_types', 'cfn_description']\n",
    "df_raw = df_raw.drop(columns=[c for c in stale if c in df_raw.columns])\n",
