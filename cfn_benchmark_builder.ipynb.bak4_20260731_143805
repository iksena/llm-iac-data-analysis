    "# %%\n",
    "# ── 2.5. Discover Top CloudFormation Repositories on GitHub ───────────────────\n",
    "import requests\n",
    "import pandas as pd\n",
    "\n",
    "# ── 1. Define the Search Query ────────────────────────────────────────────────\n",
    "# We search for repos with the 'cloudformation' topic or keyword, \n",
    "# written primarily in YAML/JSON, and having at least 50 stars.\n",
    "SEARCH_QUERY = \"topic:cloudformation OR cloudformation language:yaml stars:>10\"\n",
    "SEARCH_URL = f\"https://api.github.com/search/repositories?q={SEARCH_QUERY}&sort=stars&order=desc&per_page=30\"\n",
    "\n",
    "print(f\"Searching GitHub for top CFN repositories...\")\n",
    "response = requests.get(SEARCH_URL, headers=GH_HEADERS)\n",
    "\n",
    "if response.status_code == 200:\n",
    "    items = response.json().get('items', [])\n",
    "    print(f\"✅ Found {len(items)} top repositories.\\n\")\n",
    "    \n",
    "    # ── 2. Format as a DataFrame for easy viewing ─────────────────────────────\n",
    "    discovered_repos = []\n",
    "    for repo in items:\n",
    "        discovered_repos.append({\n",
    "            'slug': repo['full_name'],\n",
    "            'stars': repo['stargazers_count'],\n",
    "            'description': (repo['description'] or '')[:100] + ('...' if len(repo['description'] or '') > 100 else ''),\n",
    "            'url': repo['html_url']\n",
    "        })\n",
    "        \n",
    "    df_discovered = pd.DataFrame(discovered_repos)\n",
    "    \n",
    "    # In Jupyter, this will render as a nice HTML table\n",
    "    display(df_discovered.head(15)) \n",
    "    \n",
    "    # ── 3. Print Copy-Paste Ready Code ────────────────────────────────────────\n",
    "    print(\"\\n\" + \"─\"*60)\n",
    "    print(\"📋 COPY-PASTE READY FORMAT FOR REPO_REGISTRY (Top 10)\")\n",
    "    print(\"─\"*60)\n",
    "    \n",
    "    for repo in items[:10]:\n",
    "        # Clean quotes out of the description so it doesn't break Python strings\n",
    "        clean_desc = str(repo['description'] or '').replace(\"'\", \"\").replace('\"', '').strip()\n",
    "        \n",
    "        print(f\"    dict(\")\n",
    "        print(f\"        slug='{repo['full_name']}',\")\n",
    "        print(f\"        subdir='',\")\n",
    "        print(f\"        category='discovered',\")\n",
    "        print(f\"        description='{clean_desc}'\")\n",
    "        print(f\"    ),\")\n",
    "        \n",
    "else:\n",
    "    print(f\"❌ GitHub API Error: {response.status_code}\")\n",
    "    print(response.json())"
