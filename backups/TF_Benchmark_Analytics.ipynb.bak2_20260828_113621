   "source": [
    "# ── 5. Cost-Safety Sweep (aws-nuke) ───────────────────────────────────────────\n",
    "# The deploy-check cell above already destroys everything it creates and\n",
    "# waits to confirm. This is the backstop for anything that survives anyway --\n",
    "# a destroy that failed and was already flagged, a resource created outside\n",
    "# Terraform's own state tracking, or anything left over from an interrupted\n",
    "# run. Runs a FULL-ACCOUNT aws-nuke sweep against the configured AWS_PROFILE\n",
    "# using `nuke-config.yml` -- the exact same config and account already used\n",
    "# by the CFN track's own nuke-sweep cell (this project has one dummy/sandbox\n",
    "# AWS account shared by both tracks).\n",
    "#\n",
    "# Run this either right after a deploy-check session, or on its own, less\n",
    "# frequently -- this cell doesn't depend on anything the deploy-check cell\n",
    "# defined.\n",
    "#\n",
    "# ⚠️  UNLIKE a manual `aws-nuke run`, this uses --no-prompt: once\n",
    "# RUN_NUKE_SWEEP is True there is NO interactive confirmation before it\n",
    "# deletes things. Test manually first (`aws-nuke run --profile <profile> -c\n",
    "# nuke-config.yml --no-alias-check`, plain dry-run, review the output)\n",
    "# before ever flipping this to True. Every run's full output is saved to a\n",
    "# timestamped log under dataset/nuke_logs/ regardless of outcome.\n",
    "#\n",
    "# ⚠️  IMPORTANT if you've pointed AWS_PROFILE at a NEW account (e.g. one not\n",
    "# already 386347569109 or 649872913223): nuke-config.yml's `accounts:` map\n",
    "# only lists exclusions for accounts it already knows about. aws-nuke\n",
    "# refuses to run against an account with no entry there at all -- add one\n",
    "# (see the file's own comments for the pattern) before flipping\n",
    "# RUN_NUKE_SWEEP on for a new account, otherwise this cell will just error.\n",
    "RUN_NUKE_SWEEP = False\n",
    "\n",
    "import os\n",
    "import subprocess\n",
    "from datetime import datetime\n",
    "\n",
    "AWS_PROFILE = os.environ.get('AWS_PROFILE', 'default')  # e.g. export AWS_PROFILE=senatwo\n",
    "NUKE_CONFIG_PATH = Path('nuke-config.yml')\n",
    "NUKE_LOG_DIR = DATASET_DIR / 'nuke_logs'\n",
    "\n",
    "if not RUN_NUKE_SWEEP:\n",
    "    print('⏸️  RUN_NUKE_SWEEP is False -- skipping. This is a full-account, unattended')\n",
    "    print('   `aws-nuke run --no-dry-run --no-prompt` -- test manually with a plain dry run')\n",
    "    print(\"   first, then set RUN_NUKE_SWEEP = True when you're confident in the config.\")\n",
    "else:\n",
    "    if not NUKE_CONFIG_PATH.exists():\n",
    "        raise FileNotFoundError(f'{NUKE_CONFIG_PATH} not found -- expected it next to this notebook.')\n",
    "\n",
    "    NUKE_LOG_DIR.mkdir(parents=True, exist_ok=True)\n",
    "    _ts = datetime.now().strftime('%Y%m%dT%H%M%S')\n",
    "    log_path = NUKE_LOG_DIR / f\"nuke_{_ts}.log\"\n",
    "\n",
    "    cmd = [\n",
    "        'aws-nuke', 'run',\n",
    "        '--profile', AWS_PROFILE,\n",
    "        '-c', str(NUKE_CONFIG_PATH),\n",
    "        '--no-alias-check',\n",
    "        '--no-dry-run',\n",
    "        '--no-prompt',\n",
    "    ]\n",
    "    print(f'🧨 Running: {\" \".join(cmd)}')\n",
    "    print(f'   Full output -> {log_path}')\n",
    "\n",
    "    result = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)\n",
    "    _cmd_str = \" \".join(cmd)\n",
    "    log_path.write_text(f\"$ {_cmd_str}\\n\\n--- stdout ---\\n{result.stdout}\\n\\n--- stderr ---\\n{result.stderr}\\n\")\n",
    "\n",
    "    print(f'\\nExit code: {result.returncode}')\n",
    "    print('--- last 40 lines of output ---')\n",
    "    for line in (result.stdout + result.stderr).splitlines()[-40:]:\n",
    "        print(line)\n",
    "\n",
    "    if result.returncode != 0:\n",
    "        print(f'\\n🚨 aws-nuke exited non-zero -- read the full log at {log_path} before assuming the account is clean.')\n",
    "    else:\n",
    "        print(f'\\n✅ Sweep completed. Full log at {log_path}.')\n"
   ]
