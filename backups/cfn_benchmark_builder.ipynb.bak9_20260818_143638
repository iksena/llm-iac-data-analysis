    "# %%\n",
    "# ── 14. Final Benchmark Assembly & Visualisation ──────────────────────────────\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "from pathlib import Path\n",
    "\n",
    "# Ensure paths are defined\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "CFN_BENCHMARK_CSV   = DATASET_DIR / 'cfn_benchmark.csv'\n",
    "FINAL_BENCHMARK_CSV = DATASET_DIR / 'final_benchmark_custom.csv'\n",
    "PROMPTS_CSV         = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "FINAL_EVAL_CSV      = DATASET_DIR / 'cfn_eval_benchmark.csv'\n",
    "\n",
    "if not CFN_BENCHMARK_CSV.exists():\n",
    "    raise FileNotFoundError(f\"Benchmark batch not found at {CFN_BENCHMARK_CSV}. Run Cell 11 first.\")\n",
    "\n",
    "df_deployable = pd.read_csv(CFN_BENCHMARK_CSV)\n",
    "print(f\"Loaded {len(df_deployable)} successfully validated/deployed scenarios from the fresh pipeline run.\")\n",
    "\n",
    "# Read the CFN content dynamically from disk since it's not saved in the CSV\n",
    "def read_cfn_content(dest_file):\n",
    "    p = BASE_DIR / str(dest_file)\n",
    "    return p.read_text(encoding='utf-8', errors='ignore') if p.exists() else ''\n",
    "\n",
    "df_deployable['content'] = df_deployable['dest_file'].apply(read_cfn_content)\n",
    "\n",
    "TARGETS_PER_LEVEL = {1: 50, 2: 50, 3: 50, 4: 50, 5: 50}\n",
    "\n",
    "# ── 0. Reconcile against the EXISTING frozen benchmark ────────────────────────\n",
    "existing_row_map   = {}   # dest_file -> row_number\n",
    "existing_prompt_map = {}  # dest_file -> user_prompt\n",
    "existing_difficulty_map = {}  # dest_file -> difficulty (from the frozen benchmark)\n",
    "max_existing_row_number = -1\n",
    "old_dest_files = set()\n",
    "\n",
    "# Pick whichever candidate file was actually modified most recently, not just\n",
    "# whichever exists first. FINAL_EVAL_CSV is normally the more \"final\" export\n",
    "# (written by cell 15, after this cell runs), but if PROMPTS_CSV has been\n",
    "# hand-edited since (e.g. manual ground-truth fixes, difficulty corrections)\n",
    "# without re-running cell 15, FINAL_EVAL_CSV goes stale and must not win by\n",
    "# default -- doing so silently discards every edit made directly to\n",
    "# PROMPTS_CSV, including source_category/cfn_code/dest_file changes it alone\n",
    "# carries.\n",
    "_sync_candidates = [p for p in (FINAL_EVAL_CSV, PROMPTS_CSV) if p.exists()]\n",
    "sync_source = max(_sync_candidates, key=lambda p: p.stat().st_mtime, default=None)\n",
    "\n",
    "if sync_source:\n",
    "    df_old = pd.read_csv(sync_source)\n",
    "    # Handle column variations gracefully\n",
    "    path_col = 'ground_truth_path' if 'ground_truth_path' in df_old.columns else 'dest_file'\n",
    "    prompt_col = 'final_user_prompt' if 'final_user_prompt' in df_old.columns and df_old['final_user_prompt'].notna().any() else ('user_prompt' if 'user_prompt' in df_old.columns else 'prompt')\n",
    "    \n",
    "    if 'row_number' in df_old.columns:\n",
    "        existing_row_map = dict(zip(df_old[path_col], df_old['row_number']))\n",
    "        max_existing_row_number = int(df_old['row_number'].max())\n",
    "        \n",
    "    if prompt_col in df_old.columns:\n",
    "        existing_prompt_map = dict(zip(df_old[path_col], df_old[prompt_col]))\n",
    "\n",
    "    if 'difficulty' in df_old.columns:\n",
    "        existing_difficulty_map = dict(zip(df_old[path_col], df_old['difficulty']))\n",
    "        \n",
    "    old_dest_files = set(df_old[path_col])\n",
    "    print(f\"\\nLoaded existing prompts from {sync_source.name}: {len(df_old)} scenarios.\")\n",
    "else:\n",
    "    print(\"\\nNo existing benchmark found -- building from scratch.\")\n",
    "\n",
    "# Any other downstream-generated column that lives in the old frozen file but\n",
    "# isn't part of df_deployable's own schema (cfn_code, final_cfn_code,\n",
    "# final_user_prompt, cfn_code_greenfield, user_prompt_greenfield,\n",
    "# greenfield_inlined, final_ground_truth_path, ...). Without this, every\n",
    "# rerun of this cell silently drops whatever review/greenfield columns a\n",
    "# downstream script had added, because df_kept is rebuilt fresh from\n",
    "# df_deployable's columns and previously only row_number/user_prompt were\n",
    "# carried over. 'user_prompt' is excluded here since it's already handled\n",
    "# above via prompt_col (which may source from 'final_user_prompt').\n",
    "existing_extra_maps = {}\n",
    "if sync_source:\n",
    "    extra_cols = [c for c in df_old.columns if c not in df_deployable.columns and c not in (path_col, 'row_number', 'user_prompt')]\n",
    "    existing_extra_maps = {c: dict(zip(df_old[path_col], df_old[c])) for c in extra_cols}\n",
    "    if extra_cols:\n",
    "        print(f\"Carrying over {len(extra_cols)} enrichment column(s) for kept rows: {extra_cols}\")\n",
    "\n",
    "# ── Manual exclusion list: hand-reviewed scenarios to drop from the frozen\n",
    "# benchmark regardless of whether they still pass the deployable pool.\n",
    "# Grouped by reason for traceability. A replacement is resampled below for\n",
    "# each excluded scenario and reuses the EXACT SAME row_number (see\n",
    "# freed_row_numbers_by_level) instead of being appended as a new tail\n",
    "# row_number -- this keeps the frozen benchmark's row_number set stable\n",
    "# (no growth, no gaps) and only swaps out the occupant of that row.\n",
    "MANUAL_EXCLUDE_DEST_FILES = {\n",
    "    'manual_quality_review': [\n",
    "        'cfn_templates/cloudtools__troposphere/tests/examples_output/WAF_Common_Attacks_Sample.template',\n",
    "        'cfn_templates/cloudtools__troposphere/tests/examples_output/WAF_Regional_Common_Attacks_Sample.template',\n",
    "        'cfn_templates/aws__aws-app-mesh-examples/walkthroughs/howto-mutual-tls-file-provided-by-acm/infrastructure/mesh.yaml',\n",
    "    ],\n",
    "    # Same degenerate pattern the cell-6 mask_rule_list filter now excludes at\n",
    "    # the source (dozens of near-identical AWS::Config::ConfigRule resources\n",
    "    # transcribing a compliance checklist) -- these rows were assembled into\n",
    "    # the frozen benchmark before that filter existed, so they need a manual\n",
    "    # drop here rather than disappearing on the next full pipeline rerun.\n",
    "    'compliance_rule_list': [\n",
    "        'cfn_templates/Tianyi2__IRIS/data/cloudformation_collected_templates_new/template_11820_Cyber-Resilience-Best-Practices-for-S3-EBS-DynamoDB.yml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-Encryption-and-Keys.yaml',\n",
    "        'cfn_templates/antoniasouza__aws1/aws-config-conformance-packs/Operational-Best-Practices-for-CIS-AWS-v1.4-Level1.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-CIS-AWS-FB-v1.3-Level1.yaml',\n",
    "        'cfn_templates/antoniasouza__aws1/aws-config-conformance-packs/Operational-Best-Practices-for-AWS-Well-Architected-Reliability-Pillar.yaml',\n",
    "        'cfn_templates/antoniasouza__aws1/aws-config-conformance-packs/Operational-Best-Practices-for-AI-and-ML.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-CIS-AWS-v1.3-Level2.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-CIS-AWS-v1.4-Level2.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Security-and-Governance-Best-Practices-for-Amazon-Bedrock.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-Datalakes-and-Analytics-Services.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-For-Security-Identity-and-Compliance-Services.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-NIST-800-172.yaml',\n",
    "        'cfn_templates/mewil__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-Security-Services.yaml',\n",
    "        'cfn_templates/antoniasouza__aws1/aws-config-conformance-packs/Operational-Best-Practices-for-MAS-Notice-655.yaml',\n",
    "        'cfn_templates/awslabs__aws-config-rules/aws-config-conformance-packs/Operational-Best-Practices-for-ACSC-Essential8.yaml',\n",
    "    ],\n",
    "}\n",
    "MANUAL_EXCLUDE_SET = {p for paths in MANUAL_EXCLUDE_DEST_FILES.values() for p in paths}\n",
    "\n",
    "_not_found = MANUAL_EXCLUDE_SET - old_dest_files\n",
    "if _not_found:\n",
    "    print(f\"\\n⚠️ {len(_not_found)} manually-excluded path(s) not found in the frozen benchmark (already gone or typo'd):\")\n",
    "    for f in sorted(_not_found): print(f\"   - {f}\")\n",
    "\n",
    "freed_row_numbers_by_level = defaultdict(list)\n",
    "for dest_file in MANUAL_EXCLUDE_SET & old_dest_files:\n",
    "    lvl = existing_difficulty_map.get(dest_file)\n",
    "    if lvl is not None and dest_file in existing_row_map:\n",
    "        freed_row_numbers_by_level[int(lvl)].append(existing_row_map[dest_file])\n",
    "\n",
    "# Manually-fixed rows (source_category == 'manual-fix', see cell 13b) are\n",
    "# hand-edited and stored under cfn_templates_greenfield/ -- they never went\n",
    "# through THIS pipeline run's lint/security/deploy gates under their current\n",
    "# dest_file, so they will never appear in df_deployable. Without this\n",
    "# carve-out they'd be silently treated as dropped-from-deploy and replaced\n",
    "# by resampling. They're pulled directly from the frozen CSV below instead,\n",
    "# using their own already-computed metadata (including the difficulty\n",
    "# cell 13b just corrected) rather than df_deployable's.\n",
    "manual_fix_dest_files = set()\n",
    "if sync_source and 'source_category' in df_old.columns:\n",
    "    manual_fix_dest_files = set(df_old.loc[df_old['source_category'] == 'manual-fix', path_col])\n",
    "\n",
    "# We only keep existing scenarios if they STILL exist in the valid deployable\n",
    "# pool AND are not on the manual exclusion list above.\n",
    "surviving_dest_files = (old_dest_files & set(df_deployable['dest_file'])) - MANUAL_EXCLUDE_SET\n",
    "dropped_from_deploy = (old_dest_files - set(df_deployable['dest_file']) - manual_fix_dest_files) | (old_dest_files & MANUAL_EXCLUDE_SET)\n",
    "\n",
    "# ── 1. Create the base 'Kept' dataframe with UPDATED difficulty ───────────────\n",
    "df_kept = df_deployable[df_deployable['dest_file'].isin(surviving_dest_files)].copy()\n",
    "df_kept['row_number'] = df_kept['dest_file'].map(existing_row_map)\n",
    "df_kept['user_prompt'] = df_kept['dest_file'].map(existing_prompt_map)\n",
    "for _col, _mapping in existing_extra_maps.items():\n",
    "    df_kept[_col] = df_kept['dest_file'].map(_mapping)\n",
    "\n",
    "# Add manually-fixed rows straight from the frozen CSV -- they aren't in\n",
    "# df_deployable's pool at all (see note above). Excludes any that df_deployable\n",
    "# already covers naturally (e.g. once re-validated by a future full rerun),\n",
    "# so this carve-out stops applying on its own once that happens.\n",
    "manual_fix_to_keep = manual_fix_dest_files - MANUAL_EXCLUDE_SET - surviving_dest_files\n",
    "if manual_fix_to_keep:\n",
    "    df_manual_kept = df_old[df_old[path_col].isin(manual_fix_to_keep)].copy()\n",
    "    if path_col != 'dest_file':\n",
    "        df_manual_kept = df_manual_kept.rename(columns={path_col: 'dest_file'})\n",
    "    df_manual_kept['content'] = df_manual_kept['dest_file'].apply(read_cfn_content)\n",
    "    df_kept = pd.concat([df_kept, df_manual_kept], ignore_index=True, sort=False)\n",
    "    print(f\"Carried over {len(df_manual_kept)} manually-fixed row(s) directly from the frozen CSV (not in df_deployable):\")\n",
    "    for f in sorted(df_manual_kept['dest_file']): print(f\"   - {f}\")\n",
    "\n",
    "# ── 2. Enforce Exactly 50 Per Level (Drop Excess & Sample Shortfall) ──────────\n",
    "def sample_diverse(df_candidates, target, group_col='aws_services', seed=42):\n",
    "    df_shuffled = df_candidates.sample(frac=1, random_state=seed).reset_index(drop=True)\n",
    "    group_rows = [g.to_dict('records') for _, g in df_shuffled.groupby(group_col)]\n",
    "    import random\n",
    "    random.seed(seed)\n",
    "    random.shuffle(group_rows)\n",
    "    sampled = []\n",
    "    while len(sampled) < target and group_rows:\n",
    "        next_group_rows = []\n",
    "        for g_list in group_rows:\n",
    "            if len(sampled) >= target: break\n",
    "            if g_list: sampled.append(g_list.pop(0))\n",
    "            if g_list: next_group_rows.append(g_list)\n",
    "        group_rows = next_group_rows\n",
    "    return pd.DataFrame(sampled)\n",
    "\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row.get('resource_types', '')).split(' | ')))\n",
    "\n",
    "kept_by_block = defaultdict(list)\n",
    "for _, row in df_kept.iterrows():\n",
    "    kept_by_block[_block_key(row)].append(row['content'])\n",
    "\n",
    "final_dfs = []\n",
    "next_row_number = max_existing_row_number + 1\n",
    "scenarios_dropped = list(dropped_from_deploy)\n",
    "scenarios_added = []\n",
    "\n",
    "print(\"\\n⚖️ Balancing to exact targets (50 per level)...\")\n",
    "\n",
    "for level in range(1, 6):\n",
    "    target = TARGETS_PER_LEVEL.get(level, 0)\n",
    "    df_lvl_kept = df_kept[df_kept['difficulty'] == level].copy()\n",
    "    n_kept = len(df_lvl_kept)\n",
    "    \n",
    "    # ── CASE A: Too many scenarios (Difficulty shifted UP) ──\n",
    "    if n_kept > target:\n",
    "        excess = n_kept - target\n",
    "        df_lvl_kept = df_lvl_kept.set_index('aws_services')\n",
    "        \n",
    "        for _ in range(excess):\n",
    "            # Find the most overrepresented architecture and drop one\n",
    "            top_arch = df_lvl_kept.index.value_counts().idxmax()\n",
    "            row_to_drop = df_lvl_kept.loc[[top_arch]].iloc[0]\n",
    "            scenarios_dropped.append(row_to_drop['dest_file'])\n",
    "            df_lvl_kept = df_lvl_kept[df_lvl_kept['dest_file'] != row_to_drop['dest_file']]\n",
    "            \n",
    "        df_lvl_kept = df_lvl_kept.reset_index()\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "        print(f\"  ➖ Level {level}: Dropped {excess} excess scenarios (prioritizing redundancy) to reach {target}.\")\n",
    "        \n",
    "    # ── CASE B: Too few scenarios (Difficulty shifted DOWN) ──\n",
    "    elif n_kept < target:\n",
    "        shortfall = target - n_kept\n",
    "        candidates = df_deployable[\n",
    "            (df_deployable['difficulty'] == level) &\n",
    "            (~df_deployable['dest_file'].isin(df_kept['dest_file'])) &\n",
    "            (~df_deployable['dest_file'].isin(MANUAL_EXCLUDE_SET))\n",
    "        ].copy()\n",
    "        \n",
    "        ordered = sample_diverse(candidates, len(candidates), group_col='aws_services').to_dict('records')\n",
    "        \n",
    "        accepted = []\n",
    "        accepted_content_by_block = defaultdict(list)\n",
    "        \n",
    "        for rec in ordered:\n",
    "            if len(accepted) >= shortfall: break\n",
    "            key = _block_key(rec)\n",
    "            against = kept_by_block.get(key, []) + accepted_content_by_block.get(key, [])\n",
    "            is_dup = any(difflib.SequenceMatcher(None, rec['content'], other).quick_ratio() >= 0.90 for other in against)\n",
    "            if not is_dup:\n",
    "                accepted.append(rec)\n",
    "                accepted_content_by_block[key].append(rec['content'])\n",
    "                scenarios_added.append(rec['dest_file'])\n",
    "                \n",
    "        sampled = pd.DataFrame(accepted)\n",
    "        n_reused = 0\n",
    "        if not sampled.empty:\n",
    "            freed_here = freed_row_numbers_by_level.get(level, [])\n",
    "            n_reused = min(len(sampled), len(freed_here))\n",
    "            assigned_row_numbers = list(freed_here[:n_reused])\n",
    "            for _ in range(len(sampled) - n_reused):\n",
    "                assigned_row_numbers.append(next_row_number)\n",
    "                next_row_number += 1\n",
    "            sampled['row_number'] = assigned_row_numbers\n",
    "            sampled['user_prompt'] = np.nan\n",
    "            df_lvl_kept = pd.concat([df_lvl_kept, sampled], ignore_index=True)\n",
    "\n",
    "        print(f\"  ➕ Level {level}: Kept {n_kept}, sampled {len(sampled)} new diverse scenarios to reach {len(df_lvl_kept)} ({n_reused} reused freed row_number(s)).\")\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "        \n",
    "    # ── CASE C: Exactly 50 ──\n",
    "    else:\n",
    "        print(f\"  ✅ Level {level}: Perfect at exactly {target} kept scenarios.\")\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "\n",
    "# ── 3. Combine and Save ───────────────────────────────────────────────────────\n",
    "df_final = pd.concat(final_dfs, ignore_index=True)\n",
    "df_final = df_final.sort_values('row_number').reset_index(drop=True)\n",
