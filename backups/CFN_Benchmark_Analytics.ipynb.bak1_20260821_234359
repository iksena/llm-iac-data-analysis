   "source": [
    "# ── 9. Benchmark Construction Funnel ─────────────────────────────────────────\n",
    "# How the final 250 scenarios were whittled down from the raw discovered pool\n",
    "# across the pipeline's sequential gates (cells 5-14 of\n",
    "# cfn_benchmark_builder.ipynb). Computed fresh from the on-disk caches rather\n",
    "# than hardcoded, so it stays accurate across reruns.\n",
    "AWS_CACHE_PATH = DATASET_DIR / 'df_aws_cache.csv'\n",
    "LINT_CACHE_PATH = DATASET_DIR / 'lint_cache.csv'\n",
    "SEC_CACHE_PATH = DATASET_DIR / 'security_cache.csv'\n",
    "DEPLOY_CACHE_PATH = DATASET_DIR / 'deploy_cache_aws_stack.csv'\n",
    "DEPLOY_POOL_PATH = DATASET_DIR / 'cfn_benchmark.csv'\n",
    "\n",
    "funnel_stages = []\n",
    "\n",
    "if AWS_CACHE_PATH.exists():\n",
    "    df_aws = pd.read_csv(AWS_CACHE_PATH, low_memory=False)\n",
    "    funnel_stages.append(('AWS-targeted candidates', len(df_aws)))\n",
    "\n",
    "    if LINT_CACHE_PATH.exists():\n",
    "        lint = pd.read_csv(LINT_CACHE_PATH, low_memory=False)[['content_hash', 'lint_pass']].drop_duplicates('content_hash')\n",
    "        m = df_aws.merge(lint, on='content_hash', how='left')\n",
    "        lint_passed = m[m['lint_pass'] == True]\n",
    "        funnel_stages.append(('cfn-lint passed', len(lint_passed)))\n",
    "\n",
    "        if SEC_CACHE_PATH.exists():\n",
    "            sec = pd.read_csv(SEC_CACHE_PATH, low_memory=False)[\n",
    "                ['content_hash', 'trivy_critical', 'trivy_high']].drop_duplicates('content_hash')\n",
    "            m2 = lint_passed.merge(sec, on='content_hash', how='left')\n",
    "            sec_clean = m2[(m2['trivy_critical'].fillna(-1) == 0) & (m2['trivy_high'].fillna(-1) == 0)]\n",
    "            funnel_stages.append(('Trivy-clean (0 critical/high)', len(sec_clean)))\n",
    "\n",
    "if DEPLOY_POOL_PATH.exists():\n",
    "    deploy_pool = pd.read_csv(DEPLOY_POOL_PATH, low_memory=False)\n",
    "    funnel_stages.append(('Deploy-verified (full candidate pool)', len(deploy_pool)))\n",
    "\n",
    "funnel_stages.append(('Final sampled benchmark', len(df)))\n",
    "\n",
    "funnel_df = pd.DataFrame(funnel_stages, columns=['Stage', 'Count'])\n",
    "display(funnel_df)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "bars = plt.barh(funnel_df['Stage'], funnel_df['Count'], color=sns.color_palette('rocket', len(funnel_df)))\n",
    "plt.gca().invert_yaxis()\n",
    "plt.xlabel('# Scenarios')\n",
    "plt.title('Benchmark Construction Funnel', fontsize=14)\n",
    "for bar, count in zip(bars, funnel_df['Count']):\n",
    "    plt.text(bar.get_width() + max(funnel_df['Count']) * 0.01, bar.get_y() + bar.get_height() / 2,\n",
    "              f'{count:,}', va='center', fontsize=10)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "if len(funnel_stages) >= 2:\n",
    "    overall_yield = funnel_stages[-1][1] / funnel_stages[0][1]\n",
    "    print(f'\\nOverall yield: {funnel_stages[-1][1]:,} / {funnel_stages[0][1]:,} = {overall_yield:.1%} '\n",
    "          f'of AWS-targeted candidates made it into the final benchmark.')\n",
    "\n"
   ]
  },
