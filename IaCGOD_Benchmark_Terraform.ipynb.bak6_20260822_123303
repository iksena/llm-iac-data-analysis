    "# Now that all TF templates have been collected into 'scenarios', delete 'repos/'\n",
    "import shutil\n",
    "import pathlib\n",
    "\n",
    "def get_dir_size_mb(path: pathlib.Path) -> float:\n",
    "    total_size = 0\n",
    "    for f in path.rglob('*'):\n",
    "        if f.is_file() and not f.is_symlink(): total_size += f.stat().st_size\n",
    "    return total_size / (1024 * 1024)\n",
    "\n",
    "if REPOS_DIR.exists():\n",
    "    initial_size_mb = get_dir_size_mb(REPOS_DIR)\n",
