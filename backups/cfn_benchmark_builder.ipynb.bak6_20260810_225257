    "# %%\n",
    "# ── 14. Final Benchmark Assembly & Visualisation ──────────────────────────────\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "from pathlib import Path\n",
    "\n",
    "# Ensure paths are defined if running as a standalone cell\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "CFN_BENCHMARK_CSV   = DATASET_DIR / 'cfn_benchmark.csv'\n",
    "FINAL_BENCHMARK_CSV = DATASET_DIR / 'final_benchmark_custom.csv'\n",
    "PROMPTS_CSV         = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "FINAL_EVAL_CSV      = DATASET_DIR / 'cfn_eval_benchmark.csv'\n",
    "\n",
    "if not CFN_BENCHMARK_CSV.exists():\n",
    "    raise FileNotFoundError(f\"Benchmark batch not found at {CFN_BENCHMARK_CSV}. Run Cell 11 first.\")\n",
    "\n",
    "df_deployable = pd.read_csv(CFN_BENCHMARK_CSV)\n",
    "print(f\"Loaded {len(df_deployable)} successfully validated/deployed scenarios from the fresh pipeline run.\")\n",
    "print(\"\\nDeployable Distribution Before Balancing:\")\n",
    "print(df_deployable['difficulty'].value_counts().sort_index())\n",
    "\n",
    "TARGETS_PER_LEVEL = {1: 50, 2: 50, 3: 50, 4: 50, 5: 50}\n",
    "\n",
    "# ── 0. Reconcile against the EXISTING frozen benchmark ────────────────────────\n",
    "# Any scenario that is still present in the fresh deployable pool keeps its\n",
    "# original row_number so downstream evaluation results stay comparable across\n",
    "# pipeline re-runs. Scenarios that dropped out (near-duplicate removal, or a\n",
    "# fresh lint/security/deploy failure) are replaced by newly sampled scenarios,\n",
    "# which get NEW row_numbers appended after the existing max -- we never reuse\n",
    "# or shift an existing row_number.\n",
    "existing_row_map   = {}   # dest_file -> row_number\n",
    "existing_prompt_map = {}  # dest_file -> user_prompt (carried over, skips regeneration)\n",
    "max_existing_row_number = -1\n",
    "\n",
    "if FINAL_EVAL_CSV.exists():\n",
    "    df_eval_old = pd.read_csv(FINAL_EVAL_CSV)\n",
    "    existing_row_map = dict(zip(df_eval_old['ground_truth_path'], df_eval_old['row_number']))\n",
    "    if 'prompt' in df_eval_old.columns:\n",
    "        existing_prompt_map = dict(zip(df_eval_old['ground_truth_path'], df_eval_old['prompt']))\n",
    "    max_existing_row_number = int(df_eval_old['row_number'].max())\n",
    "    print(f\"\\nLoaded existing eval benchmark: {len(df_eval_old)} scenarios (row_number 0..{max_existing_row_number}).\")\n",
    "else:\n",
    "    print(\"\\nNo existing cfn_eval_benchmark.csv found -- building the benchmark from scratch (fresh row_numbers).\")\n",
    "\n",
    "deployable_dest_files = set(df_deployable['dest_file'])\n",
    "surviving_dest_files  = set(existing_row_map) & deployable_dest_files\n",
    "dropped_dest_files    = set(existing_row_map) - deployable_dest_files\n",
    "\n",
    "print(f\"\\nExisting scenarios still present in the fresh deployable pool: {len(surviving_dest_files)}\")\n",
    "if dropped_dest_files:\n",
    "    print(f\"Existing scenarios NO LONGER present (near-dup removed / re-lint or re-deploy failed): {len(dropped_dest_files)}\")\n",
    "    for f in sorted(dropped_dest_files):\n",
    "        print(f\"   - {f}\")\n",
    "\n",
    "df_kept = df_deployable[df_deployable['dest_file'].isin(surviving_dest_files)].copy()\n",
    "df_kept['row_number'] = df_kept['dest_file'].map(existing_row_map)\n",
    "df_kept['user_prompt'] = df_kept['dest_file'].map(existing_prompt_map)\n",
    "\n",
    "# ── 1. Sample NEW scenarios only for the shortfall per difficulty level ───────\n",
    "def sample_diverse(df_level, target, group_col='aws_services', seed=42):\n",
    "    \"\"\"Samples rows using a round-robin approach across groups to maximize diversity.\"\"\"\n",
    "    df_shuffled = df_level.sample(frac=1, random_state=seed).reset_index(drop=True)\n",
    "    group_rows = [g.to_dict('records') for _, g in df_shuffled.groupby(group_col)]\n",
    "    import random\n",
    "    random.seed(seed)\n",
    "    random.shuffle(group_rows)\n",
    "    sampled = []\n",
    "    while len(sampled) < target and group_rows:\n",
    "        next_group_rows = []\n",
    "        for g_list in group_rows:\n",
    "            if len(sampled) >= target:\n",
    "                next_group_rows.append(g_list)\n",
    "                continue\n",
    "            if g_list:\n",
    "                sampled.append(g_list.pop(0))\n",
    "            if g_list:\n",
    "                next_group_rows.append(g_list)\n",
    "        group_rows = next_group_rows\n",
    "    return pd.DataFrame(sampled)\n",
    "\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row['resource_types']).split(' | ')))\n",
    "\n",
    "def find_near_duplicate_clusters(df, content_col, threshold=0.90):\n",
    "    \"\"\"Same blocked fuzzy-duplicate scan used pre-Lint (cell 5e), re-applied here\n",
    "    as a final safety net across the kept+newly-sampled combination.\"\"\"\n",
    "    blocks = defaultdict(list)\n",
    "    for idx, row in df.iterrows():\n",
    "        blocks[_block_key(row)].append(idx)\n",
    "    pairs = []\n",
    "    for key, idxs in blocks.items():\n",
    "        if len(idxs) < 2:\n",
    "            continue\n",
    "        for i in range(len(idxs)):\n",
    "            for j in range(i + 1, len(idxs)):\n",
    "                a, b = idxs[i], idxs[j]\n",
    "                ca, cb = df.at[a, content_col], df.at[b, content_col]\n",
    "                if not isinstance(ca, str) or not isinstance(cb, str):\n",
    "                    continue\n",
    "                r = difflib.SequenceMatcher(None, ca, cb).quick_ratio()\n",
    "                if r >= threshold:\n",
    "                    pairs.append((a, b, r))\n",
    "    return pairs\n",
    "\n",
    "def read_dest_content(dest_file):\n",
    "    p = BASE_DIR / dest_file\n",
    "    return p.read_text(encoding='utf-8', errors='ignore') if p.exists() else ''\n",
    "\n",
    "next_row_number = max_existing_row_number + 1\n",
    "new_rows_dfs = []\n",
    "\n",
    "# Dedup-aware greedy sampling: a candidate is rejected (and another one tried)\n",
    "# if it is a near-duplicate (ratio >= 0.90, same n_resources+resource_types\n",
    "# block) of either an already-KEPT row or an already-ACCEPTED new row at that\n",
    "# level. This is checked DURING sampling -- not as a post-hoc filter -- so a\n",
    "# rejected candidate is immediately replaced rather than silently shrinking\n",
    "# the level below its target. Kept-vs-kept pairs are never compared here:\n",
    "# those were already reviewed (see cell 5e's NEAR_DUPLICATE_DROP_HASHES) and\n",
    "# intentionally include clusters judged legitimately distinct, e.g. the\n",
    "# subfuzion voting-app/fargate-chat pair and the four independent\n",
    "# cluster-api-provider-aws IAM fixtures -- re-adjudicating them here would\n",
    "# silently re-open a decision already made.\n",
    "df_kept['__content'] = df_kept['dest_file'].apply(read_dest_content)\n",
    "kept_by_block = defaultdict(list)\n",
    "for _, row in df_kept.iterrows():\n",
    "    kept_by_block[_block_key(row)].append(row['__content'])\n",
    "\n",
    "print(\"\\nFilling shortfall with newly sampled scenarios...\")\n",
    "for level in range(1, 6):\n",
    "    target = TARGETS_PER_LEVEL.get(level, 0)\n",
    "    n_kept = (df_kept['difficulty'] == level).sum()\n",
    "    shortfall = max(0, target - n_kept)\n",
    "\n",
    "    if shortfall == 0:\n",
    "        print(f\"  \\u2705 Level {level}: {n_kept}/{target} already satisfied by kept scenarios -- no new sampling needed.\")\n",
    "        continue\n",
    "\n",
    "    candidates = df_deployable[\n",
    "        (df_deployable['difficulty'] == level) &\n",
    "        (~df_deployable['dest_file'].isin(surviving_dest_files))\n",
    "    ].copy()\n",
    "    candidates['__content'] = candidates['dest_file'].apply(read_dest_content)\n",
    "    n_avail = len(candidates)\n",
    "\n",
    "    # Diversity-ordered candidate queue (round-robin across aws_services, same\n",
    "    # ordering sample_diverse would produce), then walk it and greedily accept\n",
    "    # non-duplicate rows until the shortfall is filled or the queue is empty.\n",
    "    ordered = sample_diverse(candidates, n_avail, group_col='aws_services').to_dict('records')\n",
    "\n",
    "    accepted = []\n",
    "    accepted_content_by_block = defaultdict(list)\n",
    "    n_rejected = 0\n",
    "    for rec in ordered:\n",
    "        if len(accepted) >= shortfall:\n",
    "            break\n",
    "        key = _block_key(rec)\n",
    "        against = kept_by_block.get(key, []) + accepted_content_by_block.get(key, [])\n",
    "        is_dup = any(\n",
    "            difflib.SequenceMatcher(None, rec['__content'], other).quick_ratio() >= 0.90\n",
    "            for other in against\n",
    "        )\n",
    "        if is_dup:\n",
    "            n_rejected += 1\n",
    "            continue\n",
    "        accepted.append(rec)\n",
    "        accepted_content_by_block[key].append(rec['__content'])\n",
    "\n",
    "    sampled = pd.DataFrame(accepted)\n",
    "    n_to_sample = len(sampled)\n",
    "    if n_to_sample > 0:\n",
    "        sampled['row_number'] = range(next_row_number, next_row_number + n_to_sample)\n",
    "        sampled['user_prompt'] = np.nan  # to be generated by generate_cfn_prompts.py\n",
    "        next_row_number += n_to_sample\n",
    "        new_rows_dfs.append(sampled)\n",
    "\n",
    "    status = '\\u2705' if n_to_sample == shortfall else '\\u26a0\\ufe0f'\n",
    "    dup_note = f\", {n_rejected} candidate(s) skipped as near-duplicates\" if n_rejected else \"\"\n",
    "    print(f\"  {status} Level {level}: kept {n_kept}, sampled {n_to_sample} new (shortfall was {shortfall}, {n_avail} candidates available{dup_note}).\")\n",
    "\n",
    "df_new = pd.concat(new_rows_dfs, ignore_index=True) if new_rows_dfs else pd.DataFrame(columns=df_kept.columns)\n",
    "if '__content' in df_new.columns:\n",
    "    df_new = df_new.drop(columns=['__content'])\n",
    "df_kept_clean = df_kept.drop(columns=['__content'])\n",
    "\n",
    "# ── 2. Final combine ──────────────────────────────────────────────────────────\n",
    "# No post-hoc safety-net filter needed: dedup is now enforced during sampling\n",
    "# above (new-vs-kept and new-vs-new), so kept rows are never touched and every\n",
    "# accepted new row has already been checked against everything else.\n",
    "df_final = pd.concat([df_kept_clean, df_new], ignore_index=True)\n",
    "df_final = df_final.sort_values('row_number').reset_index(drop=True)\n",
    "print(f\"\\n\\u2705 Dedup-aware sampling complete: {len(df_kept_clean)} kept + {len(df_new)} newly sampled = {len(df_final)} total.\")\n",
    "\n",
    "# ── 3. Save Final Benchmark ───────────────────────────────────────────────────\n",
    "df_final.to_csv(FINAL_BENCHMARK_CSV, index=False)\n",
    "print(f\"\\n\\U0001F389 Final custom benchmark assembled with {len(df_final)} scenarios ({len(df_kept)} kept + {len(df_final) - len(df_kept)} newly sampled).\")\n",
    "print(f\"\\U0001F4C1 Saved to: {FINAL_BENCHMARK_CSV}\")\n",
    "print(f\"   Rows carrying a prior prompt (kept):        {df_final['user_prompt'].notna().sum()}\")\n",
    "print(f\"   Rows needing prompt generation (new):       {df_final['user_prompt'].isna().sum()}\")\n",
    "\n",
    "# Seed final_benchmark_with_prompts.csv with the merged state so that\n",
    "# generate_cfn_prompts.py's \"resume from OUTPUT_CSV if present\" logic sees\n",
    "# the carried-over prompts and only generates for the new, empty-prompt rows.\n",
    "df_seed = df_final.copy()\n",
    "df_seed['cfn_code'] = df_seed['dest_file'].apply(read_dest_content)\n",
    "df_seed.to_csv(PROMPTS_CSV, index=False)\n",
    "print(f\"   Seeded {PROMPTS_CSV.name} for generate_cfn_prompts.py (run it now to backfill the {df_final['user_prompt'].isna().sum()} new rows' prompts).\")\n",
    "\n",
    "# ── 4. Visualisations ─────────────────────────────────────────────────────────\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "fig.suptitle(f'Final Benchmark Distribution (N={len(df_final)})', fontsize=16, fontweight='bold', y=1.05)\n",
    "\n",
    "sns.countplot(data=df_final, x='difficulty', ax=axes[0], palette='viridis')\n",
    "axes[0].set_title('Scenarios per Difficulty Level')\n",
    "axes[0].set_xlabel('Difficulty Level (1 = Easiest, 5 = Hardest)')\n",
    "axes[0].set_ylabel('Count')\n",
    "\n",
    "sns.boxplot(data=df_final, x='difficulty', y='loc', ax=axes[1], palette='viridis')\n",
    "axes[1].set_title('Lines of Code (LoC) by Difficulty')\n",
    "axes[1].set_xlabel('Difficulty Level')\n",
    "axes[1].set_ylabel('Lines of Code (LoC)')\n",
    "\n",
    "sns.boxplot(data=df_final, x='difficulty', y='n_resources', ax=axes[2], palette='viridis')\n",
    "axes[2].set_title('Resource Count by Difficulty')\n",
    "axes[2].set_xlabel('Difficulty Level')\n",
    "axes[2].set_ylabel('Number of Resources')\n",
    "\n",
    "fig_div, ax_div = plt.subplots(figsize=(10, 5))\n",
    "from collections import Counter\n",
    "svc_counter = Counter()\n",
    "for s in df_final['aws_services']:\n",
    "    for svc in str(s).split(', '):\n",
    "        if svc and svc != 'nan':\n",
    "            svc_counter[svc] += 1\n",
    "top_svcs = dict(svc_counter.most_common(10))\n",
    "sns.barplot(x=list(top_svcs.values()), y=list(top_svcs.keys()), ax=ax_div, palette='magma')\n",
    "ax_div.set_title('Top 10 AWS Services Represented in Final Benchmark')\n",
    "ax_div.set_xlabel('Count of Scenarios Using Service')\n",
    "ax_div.set_ylabel('AWS Service')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# ── 5. Median Summary Table ───────────────────────────────────────────────────\n",
    "print(\"Median Statistics by Difficulty Level:\")\n",
    "summary_table = df_final.groupby('difficulty')[['loc', 'n_resources', 'n_parameters']].median().round(1).rename(columns={\n",
    "    'loc': 'Median LoC',\n",
    "    'n_resources': 'Median Resources',\n",
    "    'n_parameters': 'Median Params'\n",
    "})\n",
    "display(summary_table)\n"
