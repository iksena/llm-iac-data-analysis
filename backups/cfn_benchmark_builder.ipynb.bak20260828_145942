    "# %%\n",
    "# \u2500\u2500 Inspect: Re-Evaluate Minimal-Fix L5 Scenarios After Deploy Check \u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Run this after cell 10 (Deployability Check) to see the final lint/\n",
    "# security/deploy verdict for the minimal-fix scenarios registered by the\n",
    "# \"Register Minimal-Fix L5 Scenarios & Add to Deploy-Ready\" cell above.\n",
    "# Self-contained -- re-reads the already-fixed files from\n",
    "# cfn_templates_greenfield/ and looks their content_hash up directly in the\n",
    "# three on-disk caches, so it works in a fresh kernel too, as long as cell\n",
    "# 10 has actually run on them at some point (no in-memory state required).\n",
    "import hashlib\n",
    "import re as _re\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "MANUAL_FIX_DEST_FILES = [\n",
    "    'cfn_templates_greenfield/Tianyi2__IRIS/data/cloudformation_collected_templates_new/template_05405_cf-example-10.json',\n",
    "    'cfn_templates_greenfield/aws-samples__aws-cloudformation-security-automation-for-wazuh/vpc-management.template',\n",
    "    'cfn_templates_greenfield/aws-samples__sample-aws-sa-genai/2_Quick_Admin_Suite/CFT/Final_Version/With_DDL/quick_admin_suite_vended_logs.yaml',\n",
    "    'cfn_templates_greenfield/eijikominami__aws-cloudformation-templates/notification/sam-app/template.yaml',\n",
    "    'cfn_templates_greenfield/Yoshiki0705__FSx-for-ONTAP-S3AccessPoints-Serverless-Patterns/shared/cfn/flexclone-serverless-pipeline.yaml',\n",
    "    'cfn_templates_greenfield/aws-samples__amazon-guardduty-automated-response-sample/template.yml',\n",
    "    'cfn_templates_greenfield/aws-samples__sample-ai-campaign-orchestrator/template.yaml',\n",
    "    'cfn_templates_greenfield/SWO-GS__auto-tag/cloud_formation/event_multi_region_template/autotag_event_main-template.json',\n",
    "    'cfn_templates_greenfield/aws-samples__sample-nih-genai-assistant/bucketfiles/nih-grants-ws-api.yaml',\n",
    "]\n",
    "\n",
    "def _normalise_cfn(text):\n",
    "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n",
    "    text = text.replace('\\t', '  ')\n",
    "    text = '\\n'.join(line.rstrip() for line in text.split('\\n'))\n",
    "    text = _re.sub(r'\\n{3,}', '\\n\\n', text)\n",
    "    return text.strip()\n",
    "\n",
    "rows = []\n",
    "for dest_file in MANUAL_FIX_DEST_FILES:\n",
    "    p = BASE_DIR / dest_file\n",
    "    if not p.exists():\n",
    "        rows.append({'dest_file': dest_file, 'content_hash': None})\n",
    "        continue\n",
    "    content = p.read_text(encoding='utf-8', errors='ignore')\n",
    "    h = hashlib.sha256(_normalise_cfn(content).encode('utf-8')).hexdigest()\n",
    "    rows.append({'dest_file': dest_file, 'content_hash': h})\n",
    "\n",
    "df_check = pd.DataFrame(rows)\n",
    "\n",
    "lint = pd.read_csv(DATASET_DIR / 'lint_cache.csv')[['content_hash', 'lint_pass', 'lint_errors']]\n",
    "sec = pd.read_csv(DATASET_DIR / 'security_cache.csv')[['content_hash', 'trivy_pass', 'trivy_critical', 'trivy_high']]\n",
    "df_check = df_check.merge(lint, on='content_hash', how='left').merge(sec, on='content_hash', how='left')\n",
    "\n",
    "DEPLOY_CACHE_PATH = DATASET_DIR / 'deploy_cache_aws_stack.csv'\n",
    "if DEPLOY_CACHE_PATH.exists():\n",
    "    dep = pd.read_csv(DEPLOY_CACHE_PATH)[['content_hash', 'validate_pass', 'deploy_pass', 'deploy_error']]\n",
    "    df_check = df_check.merge(dep, on='content_hash', how='left')\n",
    "else:\n",
    "    df_check['validate_pass'] = None\n",
    "    df_check['deploy_pass'] = None\n",
    "    df_check['deploy_error'] = None\n",
    "\n",
    "def _status(row):\n",
    "    if pd.isna(row.get('lint_pass')):\n",
    "        return 'NOT YET LINTED'\n",
    "    if row['lint_pass'] != True:\n",
    "        return 'LINT FAILED'\n",
    "    if pd.isna(row.get('trivy_pass')):\n",
    "        return 'NOT YET SCANNED'\n",
    "    if row['trivy_pass'] != True:\n",
    "        return 'SECURITY FAILED'\n",
    "    if pd.isna(row.get('deploy_pass')):\n",
    "        return 'NOT YET DEPLOY-TESTED'\n",
    "    if row['deploy_pass'] != True:\n",
    "        return f\"DEPLOY FAILED: {str(row.get('deploy_error'))[:100]}\"\n",
    "    return 'DEPLOYABLE, LINT-CLEAN, SECURE'\n",
    "\n",
    "df_check['status'] = df_check.apply(_status, axis=1)\n",
    "\n",
    "print(f\"Minimal-fix L5 scenarios: {len(df_check)}\")\n",
    "for _, r in df_check.iterrows():\n",
    "    print(f\"\\n  {r['dest_file']}\")\n",
    "    print(f\"    lint_pass={r.get('lint_pass')}  trivy_pass={r.get('trivy_pass')}  deploy_pass={r.get('deploy_pass')}\")\n",
    "    print(f\"    -> {r['status']}\")\n",
    "\n",
    "n_ready = (df_check['status'] == 'DEPLOYABLE, LINT-CLEAN, SECURE').sum()\n",
    "print(f\"\\n\u2705 {n_ready} / {len(df_check)} fully verified (lint + security + deploy).\")\n",
    "if n_ready < len(df_check):\n",
    "    print(\"Re-run cell 10 (Deployability Check) for any row still showing 'NOT YET DEPLOY-TESTED'.\")\n"
   ]
  },
