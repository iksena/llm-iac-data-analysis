    "df_prov = pd.read_csv(AWS_CACHE_PATH, usecols=_prov_cols, low_memory=False).drop_duplicates('dest_file')\n",
    "df_prov = df_prov.set_index('dest_file')\n",
    "\n",
    "_MANUAL_FIXES = []\n",
    "for scen in MANUAL_FIX_SCENARIOS:\n",
