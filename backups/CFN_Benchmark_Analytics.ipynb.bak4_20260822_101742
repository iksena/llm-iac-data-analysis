    "# \u2500\u2500 4. AWS Service Distribution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Mirrors DPIaC-Eval Fig. 3a (top 20 of 58 AWS services by template frequency).\n",
    "service_counter = Counter()\n",
    "for services in df['aws_services'].dropna():\n",
    "    for svc in str(services).split(', '):\n",
    "        if svc:\n",
    "            service_counter[svc] += 1\n",
    "\n",
    "n_unique_services = len(service_counter)\n",
    "top_services = pd.DataFrame(service_counter.most_common(20), columns=['Service', 'Templates'])\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.barplot(data=top_services, y='Service', x='Templates', hue='Service', palette='Blues_r', legend=False)\n",
    "plt.title(f'Top 20 AWS Services (of {n_unique_services} unique services in benchmark)', fontsize=14)\n",
    "plt.xlabel('# Templates Using This Service')\n",
    "plt.ylabel('')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f'Unique AWS services represented: {n_unique_services}')\n",
    "print(f'Avg services per template: {df[\"aws_services\"].dropna().apply(lambda s: len(str(s).split(\", \"))).mean():.1f}')\n",
    "\n"
   ]
