    "# %%\n",
    "# \u2500\u2500 Utility: Clean Deploy Cache (Fix Columns & Remove Bad Regex) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Adjust this path if your DATASET_DIR is defined differently in this isolated cell\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset') \n",
    "DEPLOY_CACHE_FILE = DATASET_DIR / 'deploy_cache.csv'\n",
    "\n",
    "if DEPLOY_CACHE_FILE.exists():\n",
    "    df_cache = pd.read_csv(DEPLOY_CACHE_FILE)\n",
    "    original_count = len(df_cache)\n",
    "    \n",
    "    # \u2500\u2500 1. Fix Swapped Columns \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    # Find rows where 'deploy_log' accidentally contains the boolean values\n",
    "    swapped_mask = df_cache['deploy_log'].astype(str).str.strip().isin(['True', 'False', 'true', 'false'])\n",
    "    swapped_count = swapped_mask.sum()\n",
    "    \n",
    "    if swapped_count > 0:\n",
    "        # Swap the values between deploy_passed and deploy_log\n",
    "        temp_logs = df_cache.loc[swapped_mask, 'deploy_passed'].copy()\n",
    "        df_cache.loc[swapped_mask, 'deploy_passed'] = df_cache.loc[swapped_mask, 'deploy_log']\n",
    "        df_cache.loc[swapped_mask, 'deploy_log'] = temp_logs\n",
    "\n",
    "    # \u2500\u2500 2. Remove Regex-Mutilated Rows \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    def has_regex_bug_error(log_text):\n",
    "        if not isinstance(log_text, str) or not log_text.strip():\n",
    "            return False\n",
    "            \n",
    "        # The exact signature left behind when the regex stripped 'version = ...' \n",
    "        # out of the 'required_version' block\n",
    "        signature_1 = \"Unexpected token Token('NAME', 'required_providers')\"\n",
    "        signature_2 = \"Unable to parse\"\n",
    "        \n",
    "        return signature_1 in log_text and signature_2 in log_text\n",
    "\n",
    "    # Keep rows that do NOT match the regex bug signature\n",
    "    mask_to_keep = ~df_cache['deploy_log'].apply(has_regex_bug_error)\n",
    "    df_cleaned = df_cache[mask_to_keep].copy()\n",
    "    \n",
    "    # Save the cleaned cache back to disk\n",
    "    df_cleaned.to_csv(DEPLOY_CACHE_FILE, index=False)\n",
    "    \n",
    "    dropped_count = original_count - len(df_cleaned)\n",
    "    print(f\"\ud83e\uddf9 Deploy cache cleaned successfully!\")\n",
    "    print(f\"  -> Original rows : {original_count}\")\n",
    "    print(f\"  -> Fixed swapped columns : {swapped_count} rows\")\n",
    "    print(f\"  -> Dropped rows  : {dropped_count} (failed due to bad regex)\")\n",
    "    print(f\"  -> New cache size: {len(df_cleaned)}\\n\")\n",
    "    print(\"Next step: Re-run Cell 13 to re-evaluate the dropped scenarios using the pristine files.\")\n",
    "else:\n",
    "    print(f\"\u26a0\ufe0f Cache file not found at {DEPLOY_CACHE_FILE}\")"
   ]
