    "# %%\n",
    "# ── 1. Configuration ──────────────────────────────────────────────────────────\n",
    "import os\n",
    "import pathlib\n",
    "import tiktoken\n",
    "\n",
    "# ── Paths ─────────────────────────────────────────────────────────────────────\n",
    "BASE_DIR       = pathlib.Path('./iac_benchmark')          \n",
    "REPOS_DIR      = BASE_DIR / 'repos'                       \n",
    "DATASET_DIR    = BASE_DIR / 'dataset'                     \n",
    "MULTI_ROOT_DIR = BASE_DIR / 'scenarios'                          # Folders for each scenario\n",
    "# NOTE (2026-08-20): was 'pathlib.Path(\"../scenarios\")' -- an independent relative path that\n",
    "# resolves differently depending on the CWD a run happens to start from, unlike every other\n",
    "# path above which is anchored under BASE_DIR. That mismatch let new GitHub-scenario collections\n",
    "# (Cell 9) silently land one level outside this project in a directory none of the downstream\n",
    "# caches (tflint/trivy/deploy/final assembly, all of which reference 'iac_benchmark/scenarios/')\n",
    "# ever read from -- confirmed via ast_parse_cache.csv, where every GitHub-sourced row pointed at\n",
    "# the old '../scenarios' location while every TerraDS row correctly pointed here. Anchoring under\n",
    "# BASE_DIR makes this deterministic regardless of the CWD a given run starts from.\n",
    "\n",
    "for d in [REPOS_DIR, DATASET_DIR, MULTI_ROOT_DIR]:\n",
    "    d.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# ── GitHub API Token ──────────────────────────────────────────────────────────\n",
    "GITHUB_TOKEN = os.environ.get('GITHUB_TOKEN', '')\n",
    "GH_HEADERS   = {'Authorization': f'token {GITHUB_TOKEN}'} if GITHUB_TOKEN else {}\n",
    "\n",
    "# ── Filter Thresholds (No Max LoC) ────────────────────────────────────────────\n",
    "MIN_LOC    = 5\n",
    "MAX_TOKENS = 8_000\n",
    "\n",
    "# ── Tokenizer ─────────────────────────────────────────────────────────────────\n",
    "TOKENIZER = tiktoken.get_encoding('cl100k_base')\n",
    "\n",
    "print('✅ Configuration loaded.')\n",
    "print(f'  Workspace : {BASE_DIR.resolve()}')\n",
    "print(f'  Limits    : MIN_LOC={MIN_LOC}, MAX_TOKENS={MAX_TOKENS}')"
   ]
