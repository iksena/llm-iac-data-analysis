    "            'checkov_checks_with_severity' : checks_with_severity,\n",
    "            'checkov_error'                : '',\n",
    "        }\n",
    "\n",
    "    except subprocess.TimeoutExpired:\n",
    "        return {\n",
    "            'checkov_pass': None,\n",
    "            'checkov_failed': -1,\n",
    "            'checkov_passed': 0,\n",
