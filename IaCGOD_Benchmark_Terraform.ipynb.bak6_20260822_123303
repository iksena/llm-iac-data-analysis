    "\n",
    "if not DEPLOY_PASSED_CSV.exists() or not PROMPTS_CSV.exists():\n",
    "    print(f\"⚠️ Required files not found. Ensure both {DEPLOY_PASSED_CSV.name} and {PROMPTS_CSV.name} exist.\")\n",
    "else:\n",
    "    df_deploy = pd.read_csv(DEPLOY_PASSED_CSV)\n",
    "    df_final = pd.read_csv(PROMPTS_CSV)\n",
    "\n",
    "    # ── 0. Reconcile against the EXISTING frozen benchmark (stable row_number) ──\n",
    "    existing_row_map = dict(zip(df_final['folder_path'], df_final['row_number']))\n",
