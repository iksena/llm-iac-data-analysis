    "\n",
    "print(\"\\n\ud83e\uddf9 Scrubbing caches...\")\n",
    "for cache_name in caches:\n",
    "    cache_file = DATASET_DIR / cache_name\n",
    "    if cache_file.exists():\n",
    "        df = pd.read_csv(cache_file)\n",
    "        if 'scenario_id' in df.columns:\n",
    "            original_len = len(df)\n",
    "            # Filter strictly by valid AWS scenario IDs\n",
    "            df_clean = df[df['scenario_id'].isin(valid_aws_ids)].copy()\n",
    "            dropped = original_len - len(df_clean)\n",
    "            df_clean.to_csv(cache_file, index=False)\n",
    "            print(f\"  -> {cache_name}: Dropped {dropped} non-AWS scenarios. Kept {len(df_clean)}.\")\n",
    "        else:\n",
    "            print(f\"  -> {cache_name}: Skipped (no scenario_id column found).\")\n",
    "\n",
