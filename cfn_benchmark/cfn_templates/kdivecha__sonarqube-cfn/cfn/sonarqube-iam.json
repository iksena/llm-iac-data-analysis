{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "inAwsPartition": {
        "Fn::Equals": [
            {
                "Ref": "AWS::Partition"
            },
            "aws"
        ]
    }
  },
  "Description": "This template sets up the IAM role needed by a Sonarqube instance",
  "Outputs": {
    "InstanceRoleArn": {
      "Description": "ARN of the instance role",
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InstanceRoleArn"
        }
      },
      "Value": {
        "Fn::GetAtt": [
          "InstanceRole",
          "Arn"
        ]
      }
    },
    "InstanceRoleName": {
      "Description": "Name of the instance role",
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InstanceRoleName"
        }
      },
      "Value": {
        "Ref": "InstanceRole"
      }
    },
    "InstanceProfile": {
      "Description": "Profile of the instance role",
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-InstanceProfile"
        }
      },
      "Value": {
        "Ref": "InstanceProfile"
      }
    }
  },
  "Parameters": {
    "Bucket1": {
      "Default": "dicelab-watchmaker",
      "Type": "String"
    },
    "Bucket2": {
      "Default": "code-[env]-common",
      "Type": "String"
    },
    "Bucket3": {
      "Default": "code-[env]-sonarqube",
      "Type": "String"
    }
  },
  "Resources": {
    "InstancePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": {
          "Ref": "AWS::StackName"
        },
        "Path": "/",
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "s3:*"
              ],
              "Effect": "Allow",
              "Resource": [

                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket1" }        ] ] },
                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket2" }        ] ] },
                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket3" }        ] ] },
                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket1" }, "/*"  ] ] },
                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket2" }, "/*"  ] ] },
                { "Fn::Join": [ "", [  "arn:", { "Ref": "AWS::Partition" }, ":s3:::", { "Ref": "Bucket3" }, "/*"  ] ] }

              ],
              "Sid": "BackupsAccess"
            },
            {
              "Action": [
                "cloudformation:SignalResource",
                "ec2:CreateTags",
                "ec2:CreateSnapshot",
                "ec2:DescribeSnapshots",
                "ec2:DescribeVolumes",
                "rds:CreateDbSnapshot",
                "rds:DescribeDBSnapshots",
                "logs:DescribeLogGroups",
                "logs:CreateLogGroup",
                "logs:PutLogEvents",
                "logs:CreateLogDelivery",
                "logs:CreateLogStream"
              ],
              "Resource": "*",
              "Effect": "Allow",
              "Sid": "MiscEnablement"
            },
            {
              "Effect": "Deny",
              "Action": [
                "kms:CreateGrant",
                "kms:RevokeGrant"
              ],
              "Resource": "*",
              "Condition": {
                "Bool": {
                  "kms:GrantIsForAWSResource": "false"
                }
              }
            },
            {
              "Effect": "Deny",
              "Action": [
                "kms:CancelKeyDeletion",
                "kms:CreateAlias",
                "kms:CreateKey",
                "kms:Delete*",
                "kms:Disable*",
                "kms:Enable*",
                "kms:Put*",
                "kms:Update*",
                "kms:ScheduleKeyDeletion"
              ],
              "Resource": "*"
            },
            {
              "Effect": "Deny",
              "Action": [
                "logs:DeleteLog"
              ],
              "Resource": [
                {
                  "Fn::Join": [
                    "",
                    [
                      "arn:",
                      {
                        "Ref": "AWS::Partition"
                      },
                      ":logs:*:*:log-group:vpc-*-flowlogs:*"
                    ]
                  ]
                }
              ]
            },
            {
              "Effect": "Deny",
              "Action": [
                "dynamodb:Purchase*",
                "elasticache:Purchase*",
                "rds:Purchase*",
                "redshift:Purchase*"
              ],
              "Resource": "*"
            }
          ],
          "Version": "2012-10-17"
        },
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Properties": {
        "InstanceProfileName": {
          "Ref": "AWS::StackName"
        },
        "Path": "/",
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      },
      "Type": "AWS::IAM::InstanceProfile"
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "PermissionsBoundary": {
          "Fn::If": [
            "inAwsPartition",
            {
                "Fn::Join": [
                    "",
                    [
                        "arn:aws:iam::",
                        {
                            "Ref": "AWS::AccountId"
                        },
                        ":policy/T_PROJADMIN_U"
                    ]
                ]
            },
            {
                "Ref": "AWS::NoValue"
            }
          ]
        },
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": {
                  "Fn::Join": [
                    ".",
                    [
                      "ec2",
                      {
                        "Ref": "AWS::URLSuffix"
                      }
                    ]
                  ]
                }
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Path": "/",
        "RoleName": {
          "Ref": "AWS::StackName"
        }
      }
    }
  }
}