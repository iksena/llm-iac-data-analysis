    "    '\"resource \\\\\"aws_batch_compute_environment\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_dms_replication_instance\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_sagemaker_pipeline\\\\\"\" extension:tf',\n",
    "\n",
    "    # Strategy D: Multi-resource co-occurrence (AND-combined quoted terms) --\n",
    "    # a lone \"resource \\\"aws_eks_cluster\\\"\" mention can be a minimal\n",
    "    # single-resource example; requiring two-plus heavyweight resource\n",
    "    # declarations to co-occur in the same file is a much stronger signal of\n",
