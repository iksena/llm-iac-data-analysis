    "# %%\n",
    "# \u2500\u2500 Utility: Analyze Resource Counts & Top Resources per Difficulty Level \u2500\u2500\u2500\u2500\u2500\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "import re\n",
    "import hcl2\n",
    "import io\n",
    "from collections import Counter\n",
    "\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "DEPLOY_PASSED_CSV = DATASET_DIR / 'deploy_passed_batch.csv'\n",
    "\n",
    "if not DEPLOY_PASSED_CSV.exists():\n",
    "    print(f\"\u26a0\ufe0f {DEPLOY_PASSED_CSV.name} not found. Please ensure it exists.\")\n",
    "else:\n",
    "    df_deploy = pd.read_csv(DEPLOY_PASSED_CSV)\n",
    "    \n",
    "    print(\"\ud83d\udcca Resource Count Statistics by Difficulty Level (Deploy Passed Batch):\")\n",
    "    # Group by difficulty and calculate stats for n_resources\n",
    "    stats = df_deploy.groupby('difficulty')['n_resources'].agg(\n",
    "        ['count', 'min', 'median', 'mean', 'max']\n",
    "    ).round(1)\n",
    "    display(stats)\n",
    "    \n",
    "    print(\"\\n\ud83c\udfc6 Top 5 AWS Resources per Difficulty Level:\")\n",
    "    \n",
    "    def extract_full_resources(folder_path_str):\n",
    "        \"\"\"Extracts exact AWS resource types (e.g., aws_instance) from .tf files.\"\"\"\n",
    "        resources = []\n",
    "        folder = Path(folder_path_str)\n",
    "        if not folder.exists(): \n",
    "            return resources\n",
    "            \n",
    "        for tf_file in folder.glob('*.tf'):\n",
    "            content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "            \n",
    "            # Try AST first\n",
    "            try:\n",
    "                ast = hcl2.load(io.StringIO(content))\n",
    "                for res_block in ast.get('resource', []):\n",
    "                    for res_type in res_block.keys():\n",
    "                        if str(res_type).startswith('aws_'):\n",
    "                            resources.append(str(res_type))\n",
    "                continue\n",
    "            except Exception:\n",
    "                pass\n",
    "                \n",
    "            # Regex Fallback\n",
    "            matches = re.findall(r'resource\\s+\"(aws_[a-zA-Z0-9_]+)\"', content)\n",
    "            resources.extend(matches)\n",
    "            \n",
    "        return resources\n",
    "\n",
    "    # Iterate through each difficulty level and aggregate resource types\n",
    "    for level in sorted(df_deploy['difficulty'].dropna().unique()):\n",
    "        level_df = df_deploy[df_deploy['difficulty'] == level]\n",
    "        all_resources = []\n",
    "        \n",
    "        for fp in level_df['folder_path']:\n",
    "            all_resources.extend(extract_full_resources(fp))\n",
    "        \n",
    "        top_res = Counter(all_resources).most_common(5)\n",
    "        \n",
    "        print(f\"\\nLevel {int(level)} (n={len(level_df)} scenarios):\")\n",
    "        for res_type, count in top_res:\n",
    "            print(f\"  - {res_type}: {count} occurrences\")"
   ]
