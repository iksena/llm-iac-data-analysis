    "# %%\n",
    "# \u2500\u2500 Utility: Purge Non-AWS Scenarios (Batch, Resumable, AST-based) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import pandas as pd\n",
    "import re\n",
    "import io\n",
    "import hcl2\n",
    "import signal\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "AWS_CHECK_CACHE = DATASET_DIR / 'aws_scrub_cache.csv'\n",
    "\n",
    "# Fallback regex in case AST parsing fails due to invalid syntax\n",
    "AWS_PATTERN = re.compile(r'(provider\\s+\"aws\"|resource\\s+\"aws_|data\\s+\"aws_)', re.MULTILINE)\n",
    "\n",
    "class TimeoutException(Exception):\n",
    "    pass\n",
    "\n",
    "def timeout_handler(signum, frame):\n",
    "    raise TimeoutException(\"Parser timed out!\")\n",
    "\n",
    "def parse_hcl2_safe(content, timeout_sec=2):\n",
    "    \"\"\"Safely parse HCL2 with a strict timeout to prevent catastrophic deadlocks.\"\"\"\n",
    "    if len(content.encode('utf-8')) > 150_000:\n",
    "        return None\n",
    "    old_handler = signal.signal(signal.SIGALRM, timeout_handler)\n",
    "    signal.alarm(timeout_sec)\n",
    "    try:\n",
    "        return hcl2.load(io.StringIO(content))\n",
    "    except Exception:\n",
    "        return None\n",
    "    finally:\n",
    "        signal.alarm(0)\n",
    "        signal.signal(signal.SIGALRM, old_handler)\n",
    "\n",
    "def is_aws_scenario(folder_path_str):\n",
    "    \"\"\"Checks if a scenario targets AWS using AST, falling back to regex.\"\"\"\n",
    "    folder = Path(folder_path_str)\n",
    "    if not folder.exists():\n",
    "        return False\n",
    "        \n",
    "    for tf_file in folder.glob('*.tf'):\n",
    "        content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "        \n",
    "        # 1. Try AST Parsing\n",
    "        ast = parse_hcl2_safe(content)\n",
    "        if ast:\n",
    "            # Check providers\n",
    "            for p in ast.get('provider', []):\n",
    "                if 'aws' in p: return True\n",
    "            # Check resources\n",
    "            for r in ast.get('resource', []):\n",
    "                if any(rtype.startswith('aws_') for rtype in r.keys()): return True\n",
    "            # Check data sources\n",
