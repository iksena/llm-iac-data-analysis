    "# ── CFN metrics: n_resources, n_parameters, resource_types, cfn_description ───\n",
    "from tqdm import tqdm\n",
    "from collections import Counter\n",
    "tqdm.pandas()\n",
    "\n",
    "# Reuses _parse_cfn_content(content) defined in cell 5 (Collect Templates).\n",
    "# That function already handles format-agnostic parsing (JSON first, then\n",
    "# the CFN-aware YAML loader that understands !Ref/!GetAtt/!Sub/... short\n",
    "# tags) — defining a second, separate loader here would let the two stages\n",
    "# silently drift out of sync (a template rejected at collection time but\n",
    "# parsed differently here, or vice versa).\n",
    "\n",
    "def parse_cfn_metrics(row):\n",
    "    empty = {'n_resources': 0, 'n_parameters': 0,\n",
    "              'resource_types': '', 'cfn_description': '',\n",
    "              'dominant_resource_type': '', 'dominant_resource_count': 0,\n",
    "              'dominant_resource_frac': 0.0}\n",
    "\n",
    "    content = row.get('content') or row.get('template_body') or ''\n",
    "    if not isinstance(content, str) or not content.strip():\n",
    "        return empty\n",
    "\n",
    "    parsed = _parse_cfn_content(content)\n",
    "\n",
    "    if not isinstance(parsed, dict):\n",
    "        return empty\n",
    "\n",
    "    resources  = parsed.get('Resources', {}) or {}\n",
    "    parameters = parsed.get('Parameters', {}) or {}\n",
    "    if not isinstance(resources, dict):  resources = {}\n",
    "    if not isinstance(parameters, dict): parameters = {}\n",
    "\n",
    "    # Counts (not just presence) per resource type -- needed downstream to\n",
    "    # detect \"rule-list\" scenarios (e.g. AWS Config Conformance Packs) where\n",
    "    # one type is repeated dozens of times. See cell 6 for the filter that\n",
    "    # consumes dominant_resource_type/_count/_frac.\n",
    "    type_counts = Counter(\n",
    "        str(v.get('Type', '')) for v in resources.values()\n",
    "        if isinstance(v, dict) and v.get('Type')\n",
    "    )\n",
    "    resource_types = sorted(type_counts)\n",
    "    dominant_type, dominant_count = type_counts.most_common(1)[0] if type_counts else ('', 0)\n",
    "\n",
    "    return {\n",
    "        'n_resources'    : len(resources),\n",
    "        'n_parameters'   : len(parameters),\n",
    "        'resource_types' : ' | '.join(t for t in resource_types if t),\n",
    "        'cfn_description': str(parsed.get('Description', ''))[:200],\n",
    "        'dominant_resource_type' : dominant_type,\n",
    "        'dominant_resource_count': dominant_count,\n",
    "        'dominant_resource_frac' : round(dominant_count / len(resources), 4) if resources else 0.0,\n",
    "    }\n",
    "\n",
    "# ── Drop stale columns from any previous failed run ───────────────────────────\n",
    "stale = ['n_resources', 'n_parameters', 'resource_types', 'cfn_description',\n",
    "         'dominant_resource_type', 'dominant_resource_count', 'dominant_resource_frac']\n",
