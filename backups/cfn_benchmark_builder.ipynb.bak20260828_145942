    "# %%\n",
    "# \u2500\u2500 13b. Recalculate Difficulty for Manually-Authored Ground Truth \u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Difficulty is normally computed exactly once (cell 6, calculate_difficulty_cfn)\n",
    "# and carried through unchanged. Manually-authored/hand-edited ground truth\n",
    "# (source_category == 'manual-fix', stored under cfn_templates_greenfield/)\n",
    "# never enters cfn_benchmark.csv at all -- it's not part of the deploy-verified\n",
    "# pool -- so it needs its own pass here, re-reading actual current dest_file\n",
    "# content, against final_benchmark_with_prompts.csv directly.\n",
    "#\n",
    "# IMPORTANT: the formula below MUST always match cell 6's calculate_difficulty_cfn\n",
    "# exactly (copy it here again whenever cell 6's thresholds change -- there is\n",
    "# no way to share the function across cells in a linear notebook without\n",
    "# re-running cell 6 itself). A prior version of this cell ALSO bulk-relabeled\n",
    "# cfn_benchmark.csv from stored metrics using its own hardcoded copy of the\n",
    "# thresholds; that copy went stale on 2026-08-18 when the thresholds were\n",
    "# updated to match Terraform exactly (loc>=400/250/150/80) and was left\n",
    "# holding the OLD CFN-specific values (loc>=200/150/100/50) -- rerunning it\n",
    "# would have silently mislabeled the whole pool right back to the wrong\n",
    "# thresholds. That relabel step has been removed entirely: cfn_benchmark.csv's\n",
    "# difficulty must only ever come from actually rerunning cells 8->11 after a\n",
    "# cell-6 threshold change (the \"Retroactively Update CFN Difficulty\" utility\n",
    "# only touches df_aws_cache.csv -- cells 8->11 still need to run afterward to\n",
    "# propagate it, though they're cache-hit-fast since content_hash is\n",
    "# unchanged). This cell now only WARNS if cfn_benchmark.csv looks stale,\n",
    "# it never patches it.\n",
    "import json as _json, re as _re\n",
    "import pandas as pd\n",
    "import yaml\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "CFN_BENCHMARK_CSV = DATASET_DIR / 'cfn_benchmark.csv'\n",
    "PROMPTS_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "\n",
    "def calculate_difficulty_cfn_metrics(loc, res):\n",
    "    # Keep this in exact sync with cell 6's calculate_difficulty_cfn.\n",
    "    if   loc >= 400 and res >= 12: return 5\n",
    "    elif loc >= 250 and res >= 8:  return 4\n",
    "    elif loc >= 150 and res >= 4:  return 3\n",
    "    elif loc >= 80  and res >= 2:  return 2\n",
    "    else: return 1\n",
    "\n",
    "# \u2500\u2500 Sanity check only: cfn_benchmark.csv should already reflect the current\n",
    "# formula via cells 8->11 (or an equivalent cache-only merge). This cell\n",
    "# does NOT recompute/patch it -- only warns if it looks stale. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "if CFN_BENCHMARK_CSV.exists():\n",
    "    df_pool = pd.read_csv(CFN_BENCHMARK_CSV)\n",
    "    recalculated = df_pool.apply(lambda r: calculate_difficulty_cfn_metrics(r['loc'], r['n_resources']), axis=1)\n",
    "    n_pool_drift = (recalculated != df_pool['difficulty']).sum()\n",
    "    if n_pool_drift:\n",
    "        print(f\"\u26a0\ufe0f {CFN_BENCHMARK_CSV.name}: {n_pool_drift} / {len(df_pool)} row(s) don't match the current \"\n",
    "              f\"difficulty formula. Re-run cells 8->11 before cell 14 -- do NOT let this cell patch it directly.\")\n",
    "    else:\n",
    "        print(f\"\u2705 {CFN_BENCHMARK_CSV.name}: difficulty matches the current formula for all {len(df_pool):,} rows.\")\n",
    "else:\n",
    "    print(f\"\u26a0\ufe0f {CFN_BENCHMARK_CSV.name} not found.\")\n",
    "\n",
    "# \u2500\u2500 final_benchmark_with_prompts.csv (the frozen output) -- re-read actual\n",
    "# current dest_file content, since this file includes manually-edited rows\n",
    "# that aren't part of cfn_benchmark.csv at all. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "class _DifficultyAuditLoader(yaml.SafeLoader):\n",
    "    pass\n",
    "\n",
    "def _construct_cfn_tag_audit(loader, node):\n",
    "    if isinstance(node, yaml.ScalarNode):\n",
    "        return loader.construct_scalar(node)\n",
    "    elif isinstance(node, yaml.SequenceNode):\n",
    "        return loader.construct_sequence(node)\n",
    "    elif isinstance(node, yaml.MappingNode):\n",
    "        return loader.construct_mapping(node)\n",
    "\n",
    "for _tag in ['!Ref','!Sub','!GetAtt','!Join','!Select','!Split','!Equals','!If',\n",
    "             '!FindInMap','!GetAZs','!Base64','!Cidr','!Transform','!ImportValue',\n",
    "             '!Not','!And','!Or','!Condition','!ForEach','!ValueOf','!Rain::Embed']:\n",
    "    _DifficultyAuditLoader.add_constructor(_tag, _construct_cfn_tag_audit)\n",
    "\n",
    "def _parse_cfn_for_audit(content):\n",
    "    try:\n",
    "        if content.strip().startswith('{'):\n",
    "            return _json.loads(content)\n",
    "        return yaml.load(content, Loader=_DifficultyAuditLoader)\n",
    "    except Exception:\n",
    "        return None\n",
    "\n",
    "def _normalise_for_loc(text):\n",
    "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n",
    "    text = '\\n'.join(line.rstrip() for line in text.split('\\n'))\n",
    "    text = _re.sub(r'\\n{3,}', '\\n\\n', text)\n",
    "    return text.strip()\n",
    "\n",
    "df_freeze = pd.read_csv(PROMPTS_CSV)\n",
    "\n",
    "drift_rows = []\n",
    "for idx, row in df_freeze.iterrows():\n",
    "    p = BASE_DIR / str(row['dest_file'])\n",
    "    if not p.exists():\n",
    "        continue\n",
    "    content = p.read_text(encoding='utf-8', errors='ignore')\n",
    "    content_norm = _normalise_for_loc(content)\n",
    "    parsed = _parse_cfn_for_audit(content)\n",
    "    resources = parsed.get('Resources', {}) if isinstance(parsed, dict) else {}\n",
    "    if not isinstance(resources, dict):\n",
    "        resources = {}\n",
    "    loc = content_norm.count('\\n') + 1\n",
    "    n_resources = len(resources)\n",
    "    recalc = calculate_difficulty_cfn_metrics(loc, n_resources)\n",
    "\n",
    "    if recalc != int(row['difficulty']):\n",
    "        drift_rows.append({\n",
    "            'row_number': row['row_number'],\n",
    "            'dest_file': row['dest_file'],\n",
    "            'recorded_difficulty': int(row['difficulty']),\n",
    "            'recalculated_difficulty': recalc,\n",
    "            'loc': loc,\n",
    "            'n_resources': n_resources,\n",
    "        })\n",
    "        df_freeze.at[idx, 'difficulty'] = recalc\n",
    "        df_freeze.at[idx, 'loc'] = loc\n",
    "        df_freeze.at[idx, 'n_resources'] = n_resources\n",
    "\n",
    "if drift_rows:\n",
    "    print(f\"\\n\u26a0\ufe0f {PROMPTS_CSV.name}: {len(drift_rows)} row(s) had a stale difficulty -- corrected:\")\n",
    "    for d in drift_rows:\n",
    "        print(f\"   row {d['row_number']}: difficulty {d['recorded_difficulty']} -> {d['recalculated_difficulty']} \"\n",
    "              f\"(loc={d['loc']}, n_resources={d['n_resources']}) -- {d['dest_file']}\")\n",
    "    df_freeze.to_csv(PROMPTS_CSV, index=False)\n",
    "    print(f\"\\n\ud83d\udcbe Saved corrected difficulty back to {PROMPTS_CSV.name}\")\n",
    "else:\n",
    "    print(f\"\\n\u2705 {PROMPTS_CSV.name}: no difficulty drift found.\")\n"
   ]
