    "# ── 2. Template Complexity Distributions (LOC / Resources / Parameters / Tokens) ─\n",
    "metrics = ['loc', 'n_resources', 'n_parameters', 'tokens']\n",
    "metric_labels = {'loc': 'Lines of Code', 'n_resources': '# Resources',\n",
    "                  'n_parameters': '# Parameters', 'tokens': '# Tokens'}\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(13, 9))\n",
    "for ax, m in zip(axes.flat, metrics):\n",
    "    sns.histplot(df[m], bins=25, kde=True, ax=ax, color='steelblue')\n",
    "    ax.set_title(f'Distribution of {metric_labels[m]}', fontsize=12)\n",
    "    ax.set_xlabel(metric_labels[m])\n",
    "    ax.axvline(df[m].mean(), color='crimson', linestyle='--', linewidth=1.2,\n",
    "               label=f'mean = {df[m].mean():.1f}')\n",
    "    ax.axvline(df[m].median(), color='darkorange', linestyle=':', linewidth=1.2,\n",
    "               label=f'median = {df[m].median():.1f}')\n",
    "    ax.legend(fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(df[metrics].describe().round(1).to_string())\n",
    "\n",
    "# ── Complexity by difficulty level (validates the stratification visually) ──\n",
    "fig, axes = plt.subplots(1, 4, figsize=(18, 5))\n",
    "for ax, m in zip(axes, metrics):\n",
    "    sns.boxplot(data=df, x='difficulty', y=m, hue='difficulty', ax=ax, palette='muted', legend=False)\n",
    "    ax.set_title(metric_labels[m], fontsize=12)\n",
    "    ax.set_xlabel('Difficulty Level')\n",
    "    ax.set_ylabel(metric_labels[m])\n",
    "plt.suptitle('Template Complexity by Difficulty Level', fontsize=14, y=1.03)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
