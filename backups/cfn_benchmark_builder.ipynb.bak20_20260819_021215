    "    time.sleep(wait_s)\n",
    "\n",
    "def fetch_licence(slug: str) -> dict:\n",
    "    \"\"\"Fetch a repo's licence, retrying on rate-limit responses.\"\"\"\n",
    "    url = f'https://api.github.com/repos/{slug}/license'\n",
    "    last_status = None\n",
    "    for attempt in range(LICENCE_API_MAX_RETRIES):\n",
    "        try:\n",
