    "        licence_map = {}\n",
    "        print(\"⚠️ licence_cache.csv not found -- run Cell 3 first. Treating every non-exempt GitHub source as ineligible until it exists.\")\n",
    "\n",
    "    def is_licence_eligible(source):\n",
