    "# %%\n",
    "# ── 2.5. Discover Top CloudFormation Repositories on GitHub ───────────────────\n",
    "import requests\n",
    "import pandas as pd\n",
    "import time\n",
    "\n",
    "# ── 1. Define the Search Queries ──────────────────────────────────────────────\n",
    "# NOTE: GitHub's search API rejects `OR` when either side is qualifier-only\n",
    "# (e.g. `topic:cloudformation OR cloudformation language:yaml stars:>50`) —\n",
    "# it doesn't error, it silently returns total_count=0. Also, `language:yaml`\n",
    "# alone returns 0 here: most CFN template repos are dominated by Python/Shell/\n",
    "# other glue code, not YAML, so filtering on dominant language excludes them.\n",
    "# Fix: run two separate qualifier-only queries and merge/dedupe by full_name.\n",
    "SEARCH_QUERIES = [\n",
    "    \"topic:cloudformation stars:>10\",\n",
    "    \"cloudformation in:name,description,topics stars:>10\",\n",
    "]\n",
    "\n",
    "# GitHub's search API hard-caps at 1,000 results per query (any page beyond\n",
    "# that returns empty), and its per_page max is 100 — so a single `per_page=30`\n",
    "# request was silently truncating each query to its first 30 hits out of\n",
    "# hundreds. This fetches every page up to that 1,000-result ceiling.\n",
    "GITHUB_SEARCH_RESULT_CAP = 1000\n",
    "SEARCH_PER_PAGE = 100\n",
    "SEARCH_PAGE_SLEEP_S = 2.0  # be polite between pages of the same query\n",
    "\n",
    "def fetch_all_repos(query, per_page=SEARCH_PER_PAGE, max_results=GITHUB_SEARCH_RESULT_CAP,\n",
    "                     sleep_s=SEARCH_PAGE_SLEEP_S):\n",
    "    \"\"\"Fetch every page of a GitHub repo-search query, up to GitHub's 1,000-result cap.\"\"\"\n",
    "    all_items = []\n",
    "    total_count = None\n",
    "    page = 1\n",
    "    while True:\n",
    "        url = (f\"https://api.github.com/search/repositories?q={requests.utils.quote(query)}\"\n",
    "               f\"&sort=stars&order=desc&per_page={per_page}&page={page}\")\n",
    "        response = requests.get(url, headers=GH_HEADERS)\n",
    "        if response.status_code != 200:\n",
    "            print(f\"    ❌ GitHub API Error for {query!r} (page {page}): {response.status_code}\")\n",
    "            print(f\"       {response.json()}\")\n",
    "            break\n",
    "\n",
    "        payload = response.json()\n",
    "        if total_count is None:\n",
    "            total_count = payload.get('total_count', 0)\n",
    "        items = payload.get('items', [])\n",
    "        all_items.extend(items)\n",
    "\n",
    "        capped_total = min(total_count, max_results)\n",
    "        print(f\"    page {page}: +{len(items)} repos (cumulative {len(all_items)}/{capped_total})\")\n",
    "\n",
    "        # Stop once: this page was short (last page), we've hit the cap,\n",
    "        # or we've collected everything GitHub reports exists.\n",
