    "# ── 6. Post-Deploy: Disable AWS Services Enabled By Pre-flight ──────────────\n",
    "# Reverses everything the pre-flight cell (section 3) turns on, run AFTER the\n",
    "# nuke sweep (so the Config recorder's own CFN stack is already gone before\n",
    "# this tries to disable the service around it). Idempotent (checks current\n",
    "# state before acting) -- safe to run even if some/all of these were never\n",
    "# enabled. Reused verbatim from the CFN track's own post-flight cell, just\n",
    "# targeting this notebook's own pre-flight stack name.\n",
    "RUN_POSTFLIGHT_TEARDOWN = True\n",
    "\n",
    "import os\n",
    "import boto3\n",
