    "# %%\n",
    "# \u2500\u2500 5e. Near-Duplicate Detection & Removal (pre-Lint) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Beyond exact-content-hash dedup (5c), several source repos contributed\n",
    "# near-identical templates: same scenario re-scraped by a different repo\n",
    "# (e.g. Tianyi2/IRIS mirrors PRX/Infrastructure DNS zones and a\n",
    "# DerSalvador/quickstart-amazon-eks template), or the same file copied with\n",
    "# only a version-tag/whitespace change (e.g. aws-samples' Quick Admin Suite\n",
    "# variants). Fuzzy content similarity (difflib SequenceMatcher, blocked by\n",
    "# (n_resources, resource_types) so we never do an O(n^2) scan over the full\n",
    "# candidate pool) finds *candidate* clusters, but similarity alone cannot\n",
    "# distinguish \"same scenario, re-hosted\" from \"different scenario that\n",
    "# happens to share a boilerplate skeleton\" (e.g. subfuzion/voting-app vs\n",
    "# subfuzion/fargate-chat, or four independent WAF/IAM-fixture samples).\n",
    "#\n",
    "# We therefore run the fuzzy scan for visibility/logging, but only ever DROP\n",
    "# the reviewed set of true duplicates below (content_hash-keyed, so the\n",
    "# exclusion is stable across pipeline re-runs and independent of any\n",
    "# non-deterministic row ordering). This runs BEFORE cfn-lint so the\n",
    "# downstream lint/security/deploy stages never spend time on rows we already\n",
    "# know we'll discard.\n",
    "\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row['resource_types']).split(' | ')))\n",
    "\n",
    "def find_near_duplicate_clusters(df, content_col='content_norm', threshold=0.90):\n",
    "    \"\"\"Blocked fuzzy-duplicate scan. Returns list of (idx_a, idx_b, ratio).\"\"\"\n",
    "    blocks = defaultdict(list)\n",
    "    for idx, row in df.iterrows():\n",
    "        blocks[_block_key(row)].append(idx)\n",
    "\n",
    "    pairs = []\n",
    "    for key, idxs in blocks.items():\n",
    "        if len(idxs) < 2:\n",
    "            continue\n",
    "        for i in range(len(idxs)):\n",
    "            for j in range(i + 1, len(idxs)):\n",
    "                a, b = idxs[i], idxs[j]\n",
    "                ca, cb = df.at[a, content_col], df.at[b, content_col]\n",
    "                r = difflib.SequenceMatcher(None, ca, cb).quick_ratio()\n",
    "                if r >= threshold:\n",
    "                    pairs.append((a, b, r))\n",
    "    return pairs\n",
    "\n",
    "near_dup_pairs = find_near_duplicate_clusters(df_raw, threshold=0.90)\n",
    "print(f'Fuzzy near-duplicate scan: {len(near_dup_pairs):,} candidate pairs >= 0.90 similarity found for review.')\n",
    "\n",
    "# \u2500\u2500 Reviewed exclusion list \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Manually reviewed against the fuzzy-scan candidates above. Each hash below is\n",
    "# the LOWER-VALUE member of a confirmed true-duplicate pair/cluster (same\n",
    "# scenario content, kept copy is either the lower-difficulty tie-break or the\n",
    "# original/canonical source repo over a re-scrape). Clusters that turned out to\n",
    "# be legitimately distinct scenarios sharing a boilerplate skeleton (e.g.\n",
    "# subfuzion voting-app vs fargate-chat; WAF Common vs Regional Common Attacks;\n",
    "# the two independent EMR/EKS network-stack repos; the four independent\n",
    "# cluster-api-provider-aws IAM fixtures) are intentionally NOT included here.\n",
    "NEAR_DUPLICATE_DROP_HASHES = {\n",
    "    '7d9bf134d3b589650a967004697f57c8dfe4ee66cdcf365b546021eb2196e109',  # Quick Admin Suite (With_DDL/single_thread) -> kept: With_DDL\n",
    "    '50c461bc13eb0e67d3143fb79fdee4c04e266be4e6dd3898e2aa3df8615e730a',  # Quick Admin Suite (With_Crawler)          -> kept: With_DDL\n",
    "    '8f6ab94e5a2ad4d8215fadedce039333cc5e2e3eb95efb49920455052783d1d5',  # apigw-ses-transformation (Armor-test fork)     -> kept: Tianyi2/IaCGen ground truth\n",
    "    '1529f73e154471e74d75f4a009fba34e8a26277cb992a5a499d5e32aacfa3738',  # apigw-ses-transformation (sasmita1005 fork)    -> kept: Tianyi2/IaCGen ground truth\n",
    "    'db71708c3a4313ae4b903b8e4f8cecb20a4fe0fc83f3934305ae9da36694d954',  # apigw-ses-transformation (Vandita2020 fork)    -> kept: Tianyi2/IaCGen ground truth\n",
    "    '285371dff523ed972fa7d7f462b462633231f4acb936f2bfb21e11e5affcc81d',  # aws-pci-confpack-ssmautomation (baseline-demo) -> kept: org-custom-conformancepacks copy\n",
    "    '1cec1f02587ce41f4550d289be1273ce501aaf3719dd07aebf6fdd79ee2b80f1',  # radiotopia.fm-hosted_zone.yml (Tianyi2/IRIS re-scrape) -> kept: PRX/Infrastructure original\n",
    "    'e58d7d5ce8af80f8468e9ba2a76f1efdce966cf3301614dad3d841fae080a64e',  # trax.fm-hosted_zone.yml (Tianyi2/IRIS re-scrape)       -> kept: PRX/Infrastructure original\n",
    "    'b6595fb73ba50fd7760c9becf1ccbe062a2b5056cc7764715a4b246fb560adb6',  # podcastgarage.org-hosted_zone.yml (Tianyi2/IRIS re-scrape) -> kept: PRX/Infrastructure original\n",
    "    '940efe2e13d8c070188af0fee6d0ea0d30697c16641235a41ad93038ff8cdce1',  # amazon-eks-per-account-resources.template.yaml (Tianyi2/IRIS re-scrape) -> kept: DerSalvador/quickstart-amazon-eks original\n",
    "    'c9e913418cc6cc267976a9f95f8a79ca0ad6f00f8ba695ef0d877d93009df0be',  # subfuzion/fargate-chat fargate_app/recipes/chat-service.yml (nginx placeholder recipe copy) -> kept: subfuzion/fargate-chat cloudformation/chat-service.yml (real deployed config)\n",
    "}\n",
    "\n",
    "n_before_dedup = len(df_raw)\n",
    "df_raw = df_raw[~df_raw['content_hash'].isin(NEAR_DUPLICATE_DROP_HASHES)].copy()\n",
