{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Conditions": {
    "IsProd": {
      "Fn::Equals": [
        {
          "Ref": "Environment"
        },
        "production"
      ]
    }
  },
  "Description": "Conditions + Mappings: a per-env bucket gated by IsProd.",
  "Mappings": {
    "EnvConfig": {
      "development": {
        "RootDomain": "savvifi.dev"
      },
      "production": {
        "RootDomain": "savvifi.com"
      }
    }
  },
  "Parameters": {
    "Environment": {
      "Default": "development",
      "Type": "String"
    }
  },
  "Resources": {
    "EnvBucket": {
      "Condition": "IsProd",
      "Properties": {
        "BucketName": {
          "Fn::FindInMap": [
            "EnvConfig",
            {
              "Ref": "Environment"
            },
            "RootDomain"
          ]
        },
        "VersioningConfiguration": {
          "Fn::If": [
            "IsProd",
            {
              "Status": "Enabled"
            },
            {
              "Status": "Suspended"
            }
          ]
        }
      },
      "Type": "AWS::S3::Bucket"
    }
  }
}