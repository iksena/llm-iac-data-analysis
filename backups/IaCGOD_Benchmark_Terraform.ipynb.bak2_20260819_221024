    "\n",
    "    # Merge content\n",
    "    merged_content = \"\\n\\n\".join(f.read_text(encoding='utf-8', errors='ignore') for f in tf_files)\n",
    "    loc = merged_content.count('\\n') + 1\n",
    "\n",
    "    # Tokenizer step\n",
    "    if len(merged_content) > 1_000_000:\n",
    "        tokens = 999_999\n",
    "    else:\n",
    "        try:\n",
