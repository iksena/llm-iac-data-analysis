    "# (n_resources, resource_types) so we never do an O(n^2) scan over the full\n",
    "# candidate pool) finds *candidate* clusters, but similarity alone cannot\n",
    "# distinguish \"same scenario, re-hosted\" from \"different scenario that\n",
    "# happens to share a boilerplate skeleton\" (e.g. subfuzion/voting-app vs\n",
    "# subfuzion/fargate-chat, or four independent WAF/IAM-fixture samples).\n",
    "#\n",
    "# We therefore run the fuzzy scan for visibility/logging, but only ever DROP\n",
    "# the reviewed set of true duplicates below (content_hash-keyed, so the\n",
    "# exclusion is stable across pipeline re-runs and independent of any\n",
    "# non-deterministic row ordering). This runs BEFORE cfn-lint so the\n",
    "# downstream lint/security/deploy stages never spend time on rows we already\n",
    "# know we'll discard.\n",
    "\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row['resource_types']).split(' | ')))\n",
    "\n",
    "def find_near_duplicate_clusters(df, content_col='content_norm', threshold=0.90):\n",
    "    \"\"\"Blocked fuzzy-duplicate scan. Returns list of (idx_a, idx_b, ratio).\"\"\"\n",
    "    blocks = defaultdict(list)\n",
    "    for idx, row in df.iterrows():\n",
    "        blocks[_block_key(row)].append(idx)\n",
    "\n",
    "    pairs = []\n",
    "    for key, idxs in blocks.items():\n",
    "        if len(idxs) < 2:\n",
    "            continue\n",
    "        for i in range(len(idxs)):\n",
    "            for j in range(i + 1, len(idxs)):\n",
    "                a, b = idxs[i], idxs[j]\n",
    "                ca, cb = df.at[a, content_col], df.at[b, content_col]\n",
    "                r = difflib.SequenceMatcher(None, ca, cb).quick_ratio()\n",
    "                if r >= threshold:\n",
    "                    pairs.append((a, b, r))\n",
    "    return pairs\n",
