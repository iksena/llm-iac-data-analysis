    "# %%\n",
    "# \u2500\u2500 1b. GitHub API Authentication \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# Every downstream cell that talks to the GitHub API (repo discovery, licence\n",
    "# lookups, IaC-Eval/TerraDS-adjacent fetches) shares GH_HEADERS from Cell 1.\n",
    "# Without a token, GitHub's REST API caps you at 60 requests/hour (core) and\n",
    "# 10/min (search) -- nowhere near enough to run Cell 2's ~34 discovery\n",
    "# queries or licence-check ~1,800 registry repos without long stalls. An\n",
    "# authenticated token raises those to 5,000/hour (core) and 30/min (search),\n",
    "# comfortably covering this notebook's call volume in one pass.\n",
    "#\n",
    "# Precedence:\n",
    "#   1. GITHUB_TOKEN already set in the environment (e.g. from .env via\n",
    "#      python-dotenv, `export GITHUB_TOKEN=...` before launching Jupyter, or\n",
    "#      a platform-injected credential) -- used as-is, nothing is prompted or\n",
    "#      overwritten.\n",
    "#   2. Otherwise, prompt once via getpass (input is masked, never echoed or\n",
    "#      logged, and never written to disk or to any cache file).\n",
    "#\n",
    "# Create a token at https://github.com/settings/tokens -- a fine-grained\n",
    "# token with no scopes/permissions (public-repo read access is\n",
    "# unauthenticated-equivalent but still gets the higher authenticated rate\n",
    "# limit) is sufficient; this notebook only reads public repo metadata,\n",
    "# licences, and file contents.\n",
    "\n",
    "import os\n",
    "import requests\n",
    "\n",
    "if os.environ.get('GITHUB_TOKEN'):\n",
    "    GITHUB_TOKEN = os.environ['GITHUB_TOKEN']\n",
    "    print('\u2705 Using GITHUB_TOKEN from environment.')\n",
    "else:\n",
    "    import getpass\n",
    "    print('No GITHUB_TOKEN found in environment.')\n",
    "    GITHUB_TOKEN = getpass.getpass('Paste a GitHub personal access token (leave blank to continue unauthenticated): ').strip()\n",
    "    if GITHUB_TOKEN:\n",
    "        os.environ['GITHUB_TOKEN'] = GITHUB_TOKEN  # so later cells / kernel restarts within this session see it too\n",
    "        print('\u2705 Token captured for this session (not written to disk).')\n",
    "    else:\n",
    "        print('\u26a0\ufe0f  Continuing unauthenticated -- 60 req/hr (core) / 10 req/min (search) limits apply.')\n",
    "\n",
    "GH_HEADERS = {'Authorization': f'token {GITHUB_TOKEN}'} if GITHUB_TOKEN else {}\n",
    "\n",
    "# \u2500\u2500 Validate the token and report actual quota \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "try:\n",
    "    r = requests.get('https://api.github.com/rate_limit', headers=GH_HEADERS, timeout=15)\n",
    "    if r.status_code == 200:\n",
    "        core = r.json()['resources']['core']\n",
    "        search = r.json()['resources']['search']\n",
    "        auth_state = 'authenticated' if GITHUB_TOKEN else 'unauthenticated'\n",
    "        print(f'\\nGitHub API quota ({auth_state}):')\n",
    "        print(f'  core   : {core[\"remaining\"]}/{core[\"limit\"]} per hour')\n",
    "        print(f'  search : {search[\"remaining\"]}/{search[\"limit\"]} per minute-window')\n",
    "    elif r.status_code == 401:\n",
    "        print('\\n\u274c Token rejected (401 Unauthorized) -- check it was copied correctly / has not expired.')\n",
    "        print('   Falling back to unauthenticated GH_HEADERS for the rest of this session.')\n",
    "        GITHUB_TOKEN = ''\n",
    "        GH_HEADERS = {}\n",
    "    else:\n",
    "        print(f'\\n\u26a0\ufe0f  Could not verify quota (HTTP {r.status_code}) -- proceeding with current GH_HEADERS anyway.')\n",
    "except requests.exceptions.RequestException as e:\n",
    "    print(f'\\n\u26a0\ufe0f  Could not reach GitHub to verify quota ({e}) -- proceeding with current GH_HEADERS anyway.')\n"
   ]
