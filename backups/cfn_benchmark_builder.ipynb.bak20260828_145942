   "source": [
    "# \u2500\u2500 6. Size Filter & Difficulty Assignment \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# CFN difficulty is a JOINT function of LoC and #Resources, mirroring the\n",
    "# Terraform track's calculate_difficulty(): a scenario only advances to a\n",
    "# harder level if it clears BOTH the LoC and resource-count bar for that\n",
    "# level. This is the single authoritative difficulty function for CFN --\n",
    "# it is computed once here and carried through unchanged by every\n",
    "# downstream cell (Aggregate & Export, Visualisation). Do not recompute or\n",
    "# override 'difficulty' anywhere else in this notebook.\n",
    "#\n",
    "# L5_LOC, L5_RES = 400, 12\n",
    "# L4_LOC, L4_RES = 250, 8\n",
    "# L3_LOC, L3_RES = 150, 4\n",
    "# L2_LOC, L2_RES = 80,  2\n",
    "#\n",
    "# Mirrors DPIaC-Eval difficulty stratification while\n",
    "# keeping both structural axes -- LoC and resource count -- consistent with\n",
    "# the Terraform track's methodology.\n",
    "\n",
    "def calculate_difficulty_cfn(row):\n",
    "    loc, res = row['loc'], row['n_resources']\n",
    "    if loc >= 400 and res >= 12: return 5\n",
    "    elif loc >= 250 and res >= 8:  return 4\n",
    "    elif loc >= 150 and res >= 4:  return 3\n",
    "    elif loc >= 80  and res >= 2:  return 2\n",
    "    else: return 1\n",
    "\n",
    "# Update metrics from normalised content (reparse after normalisation)\n",
    "df_raw['loc']    = df_raw['content_norm'].apply(lambda c: c.count('\\n') + 1)\n",
    "df_raw['tokens'] = df_raw['content_norm'].apply(count_tokens)\n",
    "df_raw['difficulty'] = df_raw.apply(calculate_difficulty_cfn, axis=1)\n",
    "\n",
    "# Apply filters\n",
    "mask_loc    = df_raw['loc'].between(MIN_LOC, MAX_LOC)\n",
    "mask_tokens = df_raw['tokens'] <= MAX_TOKENS\n",
    "MAX_RESOURCES = 100\n",
    "mask_res    = df_raw['n_resources'].between(MIN_RESOURCES, MAX_RESOURCES)\n",
    "mask_params = df_raw['n_parameters'] <= MAX_PARAMETERS\n",
    "\n",
    "# \u2500\u2500 Exclude \"compliance rule-list\" scenarios (e.g. AWS Config Conformance\n",
    "# Packs) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# These are templates whose resource list is overwhelmingly one repeated\n",
    "# rule-enumeration type -- dozens of near-identical AWS::Config::ConfigRule\n",
    "# entries transcribing a compliance checklist (e.g.\n",
    "# aws-config-conformance-packs/Operational-Best-Practices-for-*.yaml). Their\n",
    "# high n_resources/LoC pushes them into L4/L5 under the joint metric above,\n",
    "# but they aren't architecturally complex: they're a flat list of specific\n",
    "# AWS-managed rule identifiers that no reasonable natural-language prompt\n",
    "# can enumerate, so any model -- IaCGOD included -- scores near-0% resource\n",
    "# coverage on them regardless of skill. Diagnosed from IaCGOD eval rows\n",
    "# 305-317 (cfn_eval_benchmark_diff_345.csv), all of which were exactly this\n",
    "# pattern (44-86 AWS::Config::ConfigRule resources, nothing else). The prior\n",
    "# diverse-resource sampling (cell 14's sample_diverse, grouped by\n",
    "# aws_services) didn't catch these because it diversifies across service\n",
    "# *domains*, not within-scenario resource-type repetition -- a Config\n",
    "# conformance pack and a legitimate multi-resource Config scenario both read\n",
    "# as service group \"Config\".\n",
    "#\n",
    "# Small/legitimate uses of these types are deliberately spared:\n",
    "#  - a handful of Config rules attached to real surrounding infra (fraction\n",
    "#    below the threshold) stays in, since it's not a checklist dump; and\n",
    "#  - a single AWS::Config::ConformancePack resource that just references an\n",
    "#    AWS-managed pack by name (dominant_resource_count == 1, no embedded\n",
    "#    rule list) stays in as a trivial L1 scenario.\n",
    "RULE_LIST_TYPES = {\n",
    "    'AWS::Config::ConfigRule',\n",
    "    'AWS::Config::ConformancePack',\n",
    "    'AWS::Config::OrganizationConfigRule',\n",
    "    'AWS::Config::OrganizationConformancePack',\n",
    "}\n",
    "mask_rule_list = ~(\n",
    "    df_raw['dominant_resource_type'].isin(RULE_LIST_TYPES)\n",
    "    & (df_raw['dominant_resource_frac'] >= 0.7)\n",
    "    & (df_raw['dominant_resource_count'] >= 8)\n",
    ")\n",
    "\n",
    "df_sized = df_raw[mask_loc & mask_tokens & mask_res & mask_params & mask_rule_list].copy()\n",
    "\n",
    "print(f'After size filter: {len(df_sized):,} templates (from {len(df_raw):,})')\n",
    "print(f'  Removed (LOC <{MIN_LOC} or >{MAX_LOC})     : {(~mask_loc).sum():,}')\n",
    "print(f'  Removed (tokens >{MAX_TOKENS})             : {(~mask_tokens).sum():,}')\n",
    "print(f'  Removed (#resources <{MIN_RESOURCES} or >{MAX_RESOURCES}) : {(~mask_res).sum():,}')\n",
    "print(f'  Removed (#parameters >{MAX_PARAMETERS})    : {(~mask_params).sum():,}')\n",
    "print(f'  Removed (Config/ConformancePack rule-list scenarios) : {(~mask_rule_list).sum():,}')\n",
    "print()\n",
    "print('Difficulty distribution (joint LoC + #resources):')\n",
    "print(df_sized['difficulty'].value_counts().sort_index().to_string())\n",
    "print()\n",
