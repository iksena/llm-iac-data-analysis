    "# independent row_number space from final_benchmark_with_prompts.csv (the\n",
    "# LocalStack benchmark).\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import difflib\n",
    "from collections import defaultdict\n",
    "from pathlib import Path\n",
    "\n",
    "REAL_AWS_CUSTOM_CSV = DATASET_DIR / 'final_benchmark_real_aws_custom.csv'\n",
    "REAL_AWS_PROMPTS_CSV = DATASET_DIR / 'final_benchmark_real_aws_with_prompts.csv'\n",
    "GT_DEPLOY_CACHE_PATH = DATASET_DIR / 'tf_ground_truth_deploy_check_aws.csv'\n",
    "\n",
    "TARGETS_PER_LEVEL = {1: 50, 2: 50, 3: 50, 4: 50, 5: 50}\n",
    "DUP_THRESHOLD = 0.90\n",
    "\n",
    "if not GT_DEPLOY_CACHE_PATH.exists():\n",
    "    raise FileNotFoundError(\n",
    "        f\"{GT_DEPLOY_CACHE_PATH} not found -- run the real-AWS deploy-check section \"\n",
    "        f\"(RUN_DEPLOYMENT = True) at least once first.\"\n",
    "    )\n",
    "\n",
    "gt_cache = pd.read_csv(GT_DEPLOY_CACHE_PATH)[['scenario_id', 'deploy_pass']].drop_duplicates('scenario_id')\n",
    "df_deployable_real = df_pool.merge(gt_cache, on='scenario_id', how='inner')\n",
    "df_deployable_real = df_deployable_real[df_deployable_real['deploy_pass'] == True].copy()\n",
    "\n",
    "def read_tf_content(folder_path_str):\n",
    "    folder = Path(folder_path_str)\n",
    "    if not folder.exists():\n",
    "        return \"\"\n",
    "    tf_files = sorted(folder.glob('*.tf'))\n",
    "    return \"\\n\\n\".join(f.read_text(encoding='utf-8', errors='ignore').strip() for f in tf_files)\n",
    "\n",
    "df_deployable_real['content'] = df_deployable_real['folder_path'].apply(read_tf_content)\n",
    "print(f\"Real-AWS-verified, TFLint+Trivy-clean candidates: {len(df_deployable_real):,}\")\n",
    "\n",
    "# ── Reconcile against THIS benchmark's own previously-frozen file (not the\n",
    "# LocalStack one) -- stable row_number per folder_path across reruns.\n",
    "existing_row_map, existing_prompt_map = {}, {}\n",
    "existing_extra_maps = {}\n",
    "max_existing_row_number = -1\n",
    "old_folder_paths = set()\n",
    "\n",
    "if REAL_AWS_PROMPTS_CSV.exists():\n",
    "    df_old = pd.read_csv(REAL_AWS_PROMPTS_CSV)\n",
    "    existing_row_map = dict(zip(df_old['folder_path'], df_old['row_number']))\n",
    "    max_existing_row_number = int(df_old['row_number'].max())\n",
    "    existing_prompt_map = dict(zip(df_old['folder_path'], df_old['user_prompt']))\n",
    "    old_folder_paths = set(df_old['folder_path'])\n",
    "    extra_cols = [c for c in df_old.columns if c not in df_deployable_real.columns\n",
    "                  and c not in ('folder_path', 'row_number', 'user_prompt')]\n",
    "    existing_extra_maps = {c: dict(zip(df_old['folder_path'], df_old[c])) for c in extra_cols}\n",
    "    print(f\"Loaded existing real-AWS benchmark: {len(df_old)} scenarios.\")\n",
    "else:\n",
    "    print(\"No existing real-AWS benchmark found -- building from scratch.\")\n",
    "\n",
    "# This benchmark is assembled entirely independently of\n",
    "# final_benchmark_with_prompts.csv (the LocalStack benchmark) -- no prompt\n",
    "# reuse from it, no row_number sharing. Every newly sampled row gets a blank\n",
    "# user_prompt, filled in afterward by generate_llm_prompts.py pointed at\n",
    "# this file via TF_PROMPTS_CSV.\n",
    "\n",
    "surviving_folder_paths = (old_folder_paths & set(df_deployable_real['folder_path'])) - MANUAL_EXCLUDE_SET\n",
