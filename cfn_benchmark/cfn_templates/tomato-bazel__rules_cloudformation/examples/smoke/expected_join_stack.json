{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Fn::Join: a list-valued GetAtt in an Output, plus list-form joins with nested sentinels.",
  "Mappings": {
    "JoinEnvConfig": {
      "development": {
        "RootDomain": "savvifi-dev"
      },
      "production": {
        "RootDomain": "savvifi-com"
      }
    }
  },
  "Outputs": {
    "JoinBucketArn": {
      "Description": "Bucket ARN assembled from a literal prefix and a Ref.",
      "Value": {
        "Fn::Join": [
          "",
          [
            "arn:aws:s3:::",
            {
              "Ref": "JoinBucket"
            }
          ]
        ]
      }
    },
    "JoinZoneNameServers": {
      "Description": "Nameservers to delegate to from the parent zone.",
      "Value": {
        "Fn::Join": [
          ",",
          {
            "Fn::GetAtt": [
              "JoinZone",
              "NameServers"
            ]
          }
        ]
      }
    }
  },
  "Parameters": {
    "JoinEnvironment": {
      "Default": "development",
      "Type": "String"
    }
  },
  "Resources": {
    "JoinBucket": {
      "Properties": {
        "BucketName": {
          "Fn::Join": [
            "-",
            [
              {
                "Ref": "JoinEnvironment"
              },
              "smoke",
              {
                "Fn::FindInMap": [
                  "JoinEnvConfig",
                  {
                    "Ref": "JoinEnvironment"
                  },
                  "RootDomain"
                ]
              }
            ]
          ]
        }
      },
      "Type": "AWS::S3::Bucket"
    },
    "JoinZone": {
      "Properties": {
        "Name": "smoke.example.com"
      },
      "Type": "AWS::Route53::HostedZone"
    }
  }
}