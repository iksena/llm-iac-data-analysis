{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Conditions": {
        "UseACM": {
            "Fn::Equals": [
                {
                    "Ref": "CertHostingService"
                },
                "ACM"
            ]
        },
        "UNCLASS": {
            "Fn::Equals": [
                {
                    "Ref": "AWS::Partition"
                },
                "aws"
            ]
        }
    },
    "Description": "ALB Generic Template",
    "Parameters": {
        "PublicSubnets": {
            "Type": "List<AWS::EC2::Subnet::Id>"
        },
        "LoadBalancerName": {
            "Type": "String"
        },
        "VPCId": {
            "Type": "AWS::EC2::VPC::Id"
        },
        "ElbLogsBucket": {
            "Type": "String"
        },
        "S3BucketPrefix": {
            "Type": "String"
        },
        "CertHostingService": {
            "Type": "String"
        },
        "ListenerCert": {
            "Type": "String"
        },
        "ToolName": {
            "Type": "String"
        },
        "Environment": {
            "Type": "String"
        },
        "CidrIpDev": {
            "Type": "String"
        },
        "CidrIpProd": {
            "Type": "String"
        }
    },
    "Resources": {
        "ELBSecurityGroup": {
            "Type": "AWS::EC2::SecurityGroup",
            "Properties": {
                "GroupDescription": "ELB Security Group",
                "SecurityGroupIngress": [
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 443,
                        "ToPort": 443,
                        "CidrIp": "0.0.0.0/0",
                        "Description": "HTTPS Port"
                    },
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 443,
                        "ToPort": 443,
                        "CidrIp": { "Ref" : "CidrIpDev" },
                        "Description": "HTTPS Port"
                    },
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 443,
                        "ToPort": 443,
                        "CidrIp": { "Ref" : "CidrIpProd" },
                        "Description": "HTTPS Port"
                    }
                ],
                "SecurityGroupEgress": [
                    {
                        "IpProtocol": "tcp",
                        "FromPort": 9000,
                        "ToPort": 9000,
                        "CidrIp": "0.0.0.0/0",
                        "Description": "HTTP Port for EC2"
                    }
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Join": [
                                "",
                                [
                                    {
                                        "Ref": "AWS::StackName"
                                    },
                                    "-SG"
                                ]
                            ]
                        }
                    },
                    {
                        "Key":"Tool",
                        "Value": {
                          "Fn::Join": [
                              "",
                              [
                                {"Ref": "ToolName"}
                              ]
                          ]
                        }
                      },
                      {
                        "Key":"ResourceType",
                        "Value": {
                          "Fn::Join": [
                              "",
                              [
                                "LoadBalancer"
                              ]
                          ]
                        }
                      },
                      {
                        "Key":"Environment",
                        "Value": {
                          "Fn::Join": [
                              "",
                              [
                                { "Ref" : "Environment" }
                              ]
                          ]
                        }
                      }
                ],
                "VpcId": {
                    "Ref": "VPCId"
                }
            }
        },
        "PubAlbListener": {
            "Type": "AWS::ElasticLoadBalancingV2::Listener",
            "Properties": {
                "Certificates": [
                    {
                        "Fn::If": [
                            "UseACM",
                            {
                                "CertificateArn": {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":acm:",
                                            {
                                                "Ref": "AWS::Region"
                                            },
                                            ":",
                                            {
                                                "Ref": "AWS::AccountId"
                                            },
                                            ":certificate/",
                                            {
                                                "Ref": "ListenerCert"
                                            }
                                        ]
                                    ]
                                }
                            },
                            {
                                "CertificateArn": {
                                    "Fn::Join": [
                                        "",
                                        [
                                            "arn:",
                                            {
                                                "Ref": "AWS::Partition"
                                            },
                                            ":iam::",
                                            {
                                                "Ref": "AWS::AccountId"
                                            },
                                            ":server-certificate/",
                                            {
                                                "Ref": "ListenerCert"
                                            }
                                        ]
                                    ]
                                }
                            }
                        ]
                    }
                ],
                "DefaultActions": [
                    {
                        "Type": "forward",
                        "TargetGroupArn": {
                            "Ref": "ApplicationTargetGroup"
                        }
                    }
                ],
                "LoadBalancerArn": {
                    "Ref": "PubAlbLoadBalancer"
                },
                "Port": 443,
                "Protocol": "HTTPS"
            }
        },
        "PubAlbLoadBalancer": {
            "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
            "Properties": {
                "Name": {
                    "Ref": "LoadBalancerName"
                },
                "Scheme": {
                    "Fn::If": [
                        "UNCLASS",
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "internet-facing"
                                ]
                            ]
                        },
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "internal"
                                ]
                            ]
                        }
                    ]
                },
                "SecurityGroups": [
                    {
                        "Ref": "ELBSecurityGroup"
                    }
                ],
                "Subnets": {
                    "Ref": "PublicSubnets"
                },
                "LoadBalancerAttributes": [
                    {
                        "Key": "access_logs.s3.enabled",
                        "Value": "true"
                    },
                    {
                        "Key": "access_logs.s3.bucket",
                        "Value": {
                            "Ref": "ElbLogsBucket"
                        }
                    },
                    {
                        "Key": "access_logs.s3.prefix",
                        "Value": {
                            "Ref": "S3BucketPrefix"
                        }
                    }
                ],
                "Tags": [
                    {
                        "Key": "Name",
                        "Value": {
                            "Fn::Join": [
                                "",
                                [
                                    {
                                        "Ref": "AWS::StackName"
                                    },
                                    "-ALB"
                                ]
                            ]
                        }
                    }
                ],
                "Type": "application"
            }
        },
        "ApplicationTargetGroup": {
            "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
            "Properties": {
                "HealthCheckPath": "/index.html",
                "HealthyThresholdCount": "5",
                "Name": {
                    "Fn::Join": [
                        "-",
                        [
                            {
                                "Ref": "AWS::StackName"
                            },
                            "TG"
                        ]
                    ]
                },
                "Port": 9000,
                "Protocol": "HTTP",
                "UnhealthyThresholdCount": "2",
                "VpcId": {
                    "Ref": "VPCId"
                }
            }
        }
    }
}