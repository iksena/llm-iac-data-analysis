    "            return False\n",
    "            \n",
    "        text_upper = log_text.upper()\n",
    "        has_warn = 'WARNING:' in text_upper\n",
    "        has_err = 'ERROR' in text_upper or 'SYSTEM ERROR' in text_upper or 'TIMEOUT' in text_upper\n",
