    "else:\n",
    "    print(\"✅ Same-source-path check: no repo file is used by more than one row.\")\n",
    "\n",
    "if any_found:\n",
    "    print(\"\\nTo resolve: add the dest_file you want dropped to MANUAL_EXCLUDE_DEST_FILES in cell 14 and rerun it.\")\n"
