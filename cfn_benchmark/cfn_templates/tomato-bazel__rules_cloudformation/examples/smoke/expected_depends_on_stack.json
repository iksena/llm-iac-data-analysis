{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DependsOn: an IGW route ordered after the gateway attachment.",
  "Resources": {
    "SmokeDefaultRoute": {
      "DependsOn": "SmokeIgwAttachment",
      "Properties": {
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "SmokeIgw"
        },
        "RouteTableId": {
          "Ref": "SmokeRt"
        }
      },
      "Type": "AWS::EC2::Route"
    },
    "SmokeIgw": {
      "Properties": {},
      "Type": "AWS::EC2::InternetGateway"
    },
    "SmokeIgwAttachment": {
      "Properties": {
        "InternetGatewayId": {
          "Ref": "SmokeIgw"
        },
        "VpcId": {
          "Ref": "SmokeVpc"
        }
      },
      "Type": "AWS::EC2::VPCGatewayAttachment"
    },
    "SmokeRt": {
      "Properties": {
        "VpcId": {
          "Ref": "SmokeVpc"
        }
      },
      "Type": "AWS::EC2::RouteTable"
    },
    "SmokeVpc": {
      "Properties": {
        "CidrBlock": "10.9.0.0/16"
      },
      "Type": "AWS::EC2::VPC"
    }
  }
}