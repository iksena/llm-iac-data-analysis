    "# %%\n",
    "# ── Utility: Analyze Deployment Failures for Retry Filtering ──────────────────\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "# Find the most recently modified deploy cache (handles 'aws' or 'localstack' suffixes)\n",
    "cache_files = sorted(DATASET_DIR.glob('deploy_cache_*.csv'), key=lambda f: f.stat().st_mtime, reverse=True)\n",
    "\n",
    "if not cache_files:\n",
    "    print(\"⚠️ No deploy cache files found in dataset directory.\")\n",
    "else:\n",
    "    target_cache = cache_files[0]\n",
    "    print(f\"📂 Analyzing deployment failures from: {target_cache.name}\")\n",
    "    \n",
    "    df_deploy = pd.read_csv(target_cache)\n",
    "    \n",
    "    # Identify failures (either failed template validation OR failed stack deployment)\n",
    "    mask_val_fail = df_deploy['validate_pass'] == False\n",
    "    mask_dep_fail = df_deploy['deploy_pass'] == False\n",
    "    \n",
    "    df_failed = df_deploy[mask_val_fail | mask_dep_fail].copy()\n",
    "    \n",
    "    print(f\"🔍 Found {len(df_failed)} total failed scenarios out of {len(df_deploy)} attempts.\")\n",
    "    \n",
    "    # ── Extract and Clean Error Messages ──\n",
    "    def extract_core_error(row):\n",
    "        # If it failed validation, return the validate error\n",
    "        if row.get('validate_pass') == False:\n",
    "            err = str(row.get('validate_error', 'Unknown Validation Error'))\n",
    "            return f\"[VALIDATION] {err.strip().split(chr(10))[0][:150]}\"\n",
    "            \n",
    "        # If it failed deployment, return the deploy error\n",
    "        if row.get('deploy_pass') == False:\n",
    "            err = str(row.get('deploy_error', 'Unknown Deployment Error'))\n",
    "            # Many CFN errors have a standard prefix or are too long, truncate for readability\n",
    "            return f\"[DEPLOY] {err.strip().split(chr(10))[0][:150]}\"\n",
    "            \n",
    "        return \"Unknown Error\"\n",
    "\n",
    "    if not df_failed.empty:\n",
    "        df_failed['core_error'] = df_failed.apply(extract_core_error, axis=1)\n",
    "        \n",
    "        print(\"\\n📊 Top Deployment & Validation Errors:\")\n",
    "        error_counts = df_failed['core_error'].value_counts()\n",
    "        \n",
    "        for err, count in error_counts.head(20).items():\n",
    "            print(f\"  [{count:3d}] {err}\")\n",
    "            \n",
    "        # ── Optional: Export failures for review ──\n",
    "        export_path = DATASET_DIR / 'cfn_deploy_failures_review.csv'\n",
    "        cols_to_export = ['content_hash', 'validate_pass', 'deploy_pass', 'core_error']\n",
    "        \n",
    "        # Include difficulty if available to see which levels are failing the most\n",
    "        if 'difficulty' in df_failed.columns:\n",
    "            cols_to_export.insert(1, 'difficulty')\n",
    "            \n",
    "        df_failed[cols_to_export].to_csv(export_path, index=False)\n",
