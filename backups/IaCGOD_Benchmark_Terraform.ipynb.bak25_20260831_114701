    "    max_existing_row_number = int(df_final['row_number'].max()) if not df_final.empty else 0\n",
    "\n",
    "    # \u2500\u2500 Licence eligibility gate (hard constraint, not a curation choice) \u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    # Absence of a LICENSE file means all rights reserved by default -- not an\n",
    "    # implicit permissive/open-source grant (see Cell 3 and CLAUDE.md). Any\n",
    "    # row whose source repo is not on the approved-licence list is dropped\n",
    "    # here automatically, every run, regardless of whether it passed every\n",
    "    # other gate -- this is what guarantees final_benchmark_with_prompts.csv\n",
    "    # only ever contains scenarios from an eligible-licence repo (or a known\n",
    "    # external dataset with its own separate provenance). See Cell 15b below\n",
    "    # for a standalone audit of this same invariant against the file on disk.\n",
    "    LICENCE_CACHE = DATASET_DIR / 'licence_cache.csv'\n",
    "    EXEMPT_LICENCE_SOURCES = {'Zenodo/TerraDS', 'autoiac-project/iac-eval'}\n",
    "    ALLOWED_SPDX_LICENCE = {'MIT', 'MIT-0', 'Apache-2.0', 'BSD-2-Clause', 'BSD-3-Clause',\n",
    "                             'ISC', 'MPL-2.0', 'CC0-1.0', 'Unlicense', 'WTFPL'}\n",
    "    COPYLEFT_SPDX_LICENCE = {'GPL-2.0', 'GPL-3.0', 'LGPL-2.1', 'LGPL-3.0', 'AGPL-3.0'}\n",
    "    ELIGIBLE_SPDX = ALLOWED_SPDX_LICENCE | COPYLEFT_SPDX_LICENCE\n",
    "\n",
    "    if LICENCE_CACHE.exists():\n",
    "        licence_map = pd.read_csv(LICENCE_CACHE, index_col='slug')['spdx'].to_dict()\n",
    "    else:\n",
    "        licence_map = {}\n",
    "        print(\"\u26a0\ufe0f licence_cache.csv not found -- run Cell 3 first. Treating every non-exempt GitHub source as ineligible until it exists.\")\n",
    "\n",
    "    def is_licence_eligible(source):\n",
    "        if source in EXEMPT_LICENCE_SOURCES:\n",
    "            return True\n",
    "        return licence_map.get(source) in ELIGIBLE_SPDX\n",
    "\n",
    "    licence_ineligible_paths = set(\n",
    "        df_final.loc[~df_final['source'].apply(is_licence_eligible), 'folder_path']\n",
    "    )\n",
    "    if licence_ineligible_paths:\n",
    "        print(f\"\u26a0\ufe0f {len(licence_ineligible_paths)} previously-kept row(s) are sourced from a repo without an eligible licence -- dropping them now:\")\n",
    "        for fp in sorted(licence_ineligible_paths)[:10]:\n",
    "            src_val = df_final.loc[df_final['folder_path'] == fp, 'source'].iloc[0]\n",
    "            print(f\"   - {fp} (source={src_val}, licence={licence_map.get(src_val, 'unknown')})\")\n",
    "        if len(licence_ineligible_paths) > 10:\n",
    "            print(f\"   ... and {len(licence_ineligible_paths) - 10} more.\")\n",
    "    else:\n",
    "        print(\"\u2705 Licence eligibility gate: every previously-kept row is from an eligible-licence source.\")\n",
    "\n",
    "    # \u2500\u2500 Manual exclusion list: hand-reviewed scenarios to drop from the frozen\n",
    "    # benchmark regardless of whether they still pass the deploy cache. Same\n",
    "    # convention as cfn_benchmark_builder.ipynb's MANUAL_EXCLUDE_DEST_FILES --\n",
    "    # a replacement is resampled below and reuses the freed row_number instead\n",
    "    # of being appended as a new tail row, keeping the frozen row_number set\n",
    "    # stable (no growth, no gaps). Populate this after Cell 14b (below)\n",
    "    # confirms a near-duplicate pair -- keep one, drop the other here.\n",
    "    MANUAL_EXCLUDE_FOLDER_PATHS = {\n",
    "    # Surfaced by Cell 14b (post-resample near-duplicate check), 2026-08-18.\n",
    "    # 12 clusters of near-identical scenarios (quick_ratio >= 0.90, several\n",
    "    # exact 1.000 matches) were found across the 250-row benchmark, mostly\n",
    "    # concentrated at difficulty 5. For each cluster the lowest row_number was\n",
    "    # kept and the rest dropped here as redundant -- near-identical boilerplate\n",
    "    # doesn't add architectural diversity. Freed row_numbers are backfilled by\n",
    "    # fresh, distinct candidates the next time Cell 14 is rerun.\n",
    "    'near_duplicate': [\n",
    "        # cluster kept row 74 (terrads_534e4148d408):\n",
    "        'iac_benchmark/scenarios/terrads_559e5c90c3ea',  # row 75, quick_ratio 1.0 vs row 74\n",
    "        # cluster kept row 90 (terrads_b16fe326aefb):\n",
    "        'iac_benchmark/scenarios/terrads_ebaf7a67fef3',  # row 98, quick_ratio 0.995 vs row 90\n",
    "        # cluster kept row 103 (gh_3ec69cfa):\n",
    "        'iac_benchmark/scenarios/terrads_79d499359f89',  # row 131, quick_ratio 0.981 vs row 103\n",
    "        # cluster kept row 118 (terrads_2e8035ffc09c):\n",
    "        'iac_benchmark/scenarios/terrads_586a9474fd96',  # row 124, quick_ratio 0.989 vs row 118\n",
    "        # cluster kept row 179 (terrads_765efd6394eb):\n",
    "        'iac_benchmark/scenarios/terrads_f06187331dff',  # row 199, quick_ratio 1.0 vs row 179\n",
    "        # cluster kept row 201 (gh_3a4dde50):\n",
    "        'iac_benchmark/scenarios/terrads_39c90624ffed',  # row 215, quick_ratio 1.0 vs row 201\n",
    "        'iac_benchmark/scenarios/terrads_c92b260bc738',  # row 243, quick_ratio 1.0 vs row 201\n",
    "        # cluster kept row 202 (gh_8159ec72):\n",
    "        'iac_benchmark/scenarios/terrads_84f64c0c2376',  # row 225, quick_ratio 1.0 vs row 202\n",
    "        'iac_benchmark/scenarios/terrads_c6dcc9b29983',  # row 241, quick_ratio 1.0 vs row 202\n",
    "        # cluster kept row 203 (terrads_01334dedc4eb):\n",
    "        'iac_benchmark/scenarios/terrads_916c37ccf307',  # row 229, quick_ratio 1.0 vs row 203\n",
    "        # cluster kept row 206 (terrads_15dc7dba11b2):\n",
    "        'iac_benchmark/scenarios/terrads_6f97821a57ad',  # row 218, quick_ratio 0.991 vs row 206\n",
    "        'iac_benchmark/scenarios/terrads_f86afb58a0d5',  # row 250, quick_ratio 0.973 vs row 206\n",
    "        # cluster kept row 208 (terrads_253bca1f8ff4):\n",
    "        'iac_benchmark/scenarios/terrads_2d7923019d0c',  # row 211, quick_ratio 1.0 vs row 208\n",
    "        'iac_benchmark/scenarios/terrads_48ad8a91b6a4',  # row 216, quick_ratio 1.0 vs row 208\n",
    "        # cluster kept row 212 (terrads_33766381a4b4):\n",
    "        'iac_benchmark/scenarios/terrads_71c036ff15e5',  # row 219, quick_ratio 0.999 vs row 212\n",
    "        'iac_benchmark/scenarios/terrads_8ac6bda76d9a',  # row 226, quick_ratio 0.999 vs row 212\n",
    "        'iac_benchmark/scenarios/terrads_e3a38ad9c4b0',  # row 246, quick_ratio 0.998 vs row 212\n",
    "        # cluster kept row 213 (terrads_3460cbdc48ca):\n",
    "        'iac_benchmark/scenarios/terrads_6bc966772840',  # row 217, quick_ratio 1.0 vs row 213\n",
    "        'iac_benchmark/scenarios/terrads_dcfd05f3ba14',  # row 245, quick_ratio 1.0 vs row 213\n",
    "    ],\n",
    "    }\n",
    "    MANUAL_EXCLUDE_SET = {p for paths in MANUAL_EXCLUDE_FOLDER_PATHS.values() for p in paths} | licence_ineligible_paths\n",
    "\n",
    "    _not_found = MANUAL_EXCLUDE_SET - set(df_final['folder_path'])\n",
    "    if _not_found:\n",
    "        print(f\"\u26a0\ufe0f {len(_not_found)} manually-excluded path(s) not found in the frozen benchmark (already gone or typo'd):\")\n",
    "        for f in sorted(_not_found): print(f\"   - {f}\")\n",
    "\n",
    "    old_difficulty_map = dict(zip(df_final['folder_path'], df_final['difficulty']))\n",
    "    freed_row_numbers_by_level = defaultdict(list)\n",
    "    for fp in MANUAL_EXCLUDE_SET & set(df_final['folder_path']):\n",
    "        lvl = old_difficulty_map.get(fp)\n",
    "        if lvl is not None and fp in existing_row_map:\n",
    "            freed_row_numbers_by_level[int(lvl)].append(existing_row_map[fp])\n",
    "\n",
    "    # 1. Update difficulty from the latest deploy cache (source of truth) and\n",
    "    #    drop anything that no longer exists in the deployable pool at all,\n",
    "    #    plus anything on the manual exclusion list.\n",
    "    truth_map = dict(zip(df_deploy['folder_path'], df_deploy['difficulty']))\n",
    "    old_paths = set(df_final['folder_path'])\n",
    "    dropped_from_deploy = (old_paths - set(df_deploy['folder_path'])) | (old_paths & MANUAL_EXCLUDE_SET)\n",
    "\n",
    "    df_final['difficulty'] = df_final['folder_path'].map(truth_map)\n",
    "    df_final = df_final[~df_final['folder_path'].isin(MANUAL_EXCLUDE_SET)]\n",
    "    df_final = df_final.dropna(subset=['difficulty']).copy()\n",
    "    df_final['difficulty'] = df_final['difficulty'].astype(int)\n",
    "\n",
    "    # Helper: Extract AWS Services for diversity grouping\n",
    "    def get_aws_services(folder_path_str):\n",
    "        services = set()\n",
    "        folder = Path(folder_path_str)\n",
    "        if not folder.exists(): return \"\"\n",
    "        for tf_file in folder.glob('*.tf'):\n",
    "            content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "            try:\n",
    "                ast = hcl2.load(io.StringIO(content))\n",
    "                for r_block in ast.get('resource', []):\n",
    "                    for r_type in r_block.keys():\n",
    "                        if str(r_type).startswith('aws_'): services.add(str(r_type))\n",
    "                for d_block in ast.get('data', []):\n",
    "                    for d_type in d_block.keys():\n",
    "                        if str(d_type).startswith('aws_'): services.add(str(d_type))\n",
    "                continue\n",
    "            except Exception: pass\n",
    "            matches = re.findall(r'(?:resource|data)\\s+\"(aws_[a-zA-Z0-9_]+)\"', content)\n",
    "            for m in matches: services.add(m)\n",
    "        return \", \".join(sorted(services))\n",
    "\n",
    "    def read_tf_content(folder_path_str):\n",
    "        folder = Path(folder_path_str)\n",
    "        if not folder.exists(): return \"\"\n",
    "        tf_files = sorted(folder.glob('*.tf'))\n",
    "        return \"\\n\\n\".join(f.read_text(encoding='utf-8', errors='ignore').strip() for f in tf_files)\n",
    "\n",
    "    df_deploy = df_deploy.copy()\n",
    "    df_deploy['aws_services'] = df_deploy['folder_path'].apply(get_aws_services)\n",
    "\n",
    "    if 'aws_services' not in df_final.columns:\n",
    "        df_final['aws_services'] = df_final['folder_path'].apply(get_aws_services)\n",
    "    else:\n",
    "        missing_svc = df_final['aws_services'].isna() | (df_final['aws_services'] == '')\n",
    "        if missing_svc.any():\n",
    "            df_final.loc[missing_svc, 'aws_services'] = df_final.loc[missing_svc, 'folder_path'].apply(get_aws_services)\n",
    "\n",
    "    # Helper: Diverse Sampling (round-robin across architecture groups)\n",
    "    def sample_diverse(df_candidates, n_needed, group_col='aws_services', seed=42):\n",
    "        df_shuffled = df_candidates.sample(frac=1, random_state=seed).reset_index(drop=True)\n",
    "        group_rows = [g.to_dict('records') for _, g in df_shuffled.groupby(group_col)]\n",
    "        import random\n",
    "        random.seed(seed)\n",
    "        random.shuffle(group_rows)\n",
    "        sampled = []\n",
    "        while len(sampled) < n_needed and group_rows:\n",
    "            next_groups = []\n",
    "            for g_list in group_rows:\n",
    "                if len(sampled) >= n_needed: break\n",
    "                if g_list: sampled.append(g_list.pop(0))\n",
    "                if g_list: next_groups.append(g_list)\n",
    "            group_rows = next_groups\n",
    "        return pd.DataFrame(sampled)\n",
    "\n",
    "    def _block_key(rec):\n",
    "        return (rec.get('n_resources'), frozenset(str(rec.get('aws_services', '')).split(', ')))\n",
    "\n",
    "    final_dfs = []\n",
    "    next_row_number = max_existing_row_number + 1\n",
    "    scenarios_dropped = list(dropped_from_deploy)\n",
    "    scenarios_added = []\n",
    "\n",
    "    print(\"\u2696\ufe0f Balancing Difficulty Levels (dedup-aware, row-number-stable)...\\n\")\n",
    "\n",
    "    for level in range(1, 6):\n",
    "        target = TARGETS_PER_LEVEL.get(level, 0)\n",
    "        df_lvl = df_final[df_final['difficulty'] == level].copy()\n",
    "        n_kept = len(df_lvl)\n",
    "\n",
    "        kept_by_block = defaultdict(list)\n",
    "        for _, r in df_lvl.iterrows():\n",
    "            kept_by_block[_block_key(r)].append(read_tf_content(r['folder_path']))\n",
    "\n",
    "        if n_kept == target:\n",
    "            print(f\"  \u2705 Level {level}: Perfect at exactly {target} kept scenarios.\")\n",
    "            final_dfs.append(df_lvl)\n",
    "\n",
    "        elif n_kept < target:\n",
    "            shortfall = target - n_kept\n",
    "            candidates = df_deploy[\n",
    "                (df_deploy['difficulty'] == level) &\n",
    "                (~df_deploy['folder_path'].isin(df_final['folder_path'])) &\n",
    "                (~df_deploy['folder_path'].isin(MANUAL_EXCLUDE_SET)) &\n",
    "                (df_deploy['source'].apply(is_licence_eligible))\n",
    "            ].copy()\n",
    "\n",
    "            ordered = sample_diverse(candidates, len(candidates)).to_dict('records') if len(candidates) else []\n",
    "\n",
    "            accepted = []\n",
    "            accepted_content_by_block = defaultdict(list)\n",
    "            for rec in ordered:\n",
    "                if len(accepted) >= shortfall: break\n",
    "                content = read_tf_content(rec['folder_path'])\n",
    "                key = _block_key(rec)\n",
    "                against = kept_by_block.get(key, []) + accepted_content_by_block.get(key, [])\n",
    "                is_dup = any(difflib.SequenceMatcher(None, content, other).quick_ratio() >= DUP_THRESHOLD for other in against)\n",
    "                if not is_dup:\n",
    "                    rec['tf_code'] = content\n",
    "                    accepted.append(rec)\n",
    "                    accepted_content_by_block[key].append(content)\n",
    "                    scenarios_added.append(rec['folder_path'])\n",
    "\n",
    "            sampled = pd.DataFrame(accepted)\n",
    "            n_reused = 0\n",
    "            if not sampled.empty:\n",
    "                freed_here = freed_row_numbers_by_level.get(level, [])\n",
    "                n_reused = min(len(sampled), len(freed_here))\n",
    "                assigned = list(freed_here[:n_reused])\n",
    "                for _ in range(len(sampled) - n_reused):\n",
    "                    assigned.append(next_row_number)\n",
    "                    next_row_number += 1\n",
    "                sampled['row_number'] = assigned\n",
    "                sampled['user_prompt'] = np.nan\n",
    "                df_lvl = pd.concat([df_lvl, sampled], ignore_index=True)\n",
    "\n",
    "            n_short = shortfall - len(accepted)\n",
    "            if n_short > 0:\n",
    "                print(f\"  \u26a0\ufe0f Level {level}: Needed {shortfall}, only found {len(accepted)} non-duplicate candidate(s) ({n_short} short).\")\n",
    "            print(f\"  \u2795 Level {level}: Kept {n_kept}, sampled {len(sampled)} new diverse scenarios to reach {len(df_lvl)} ({n_reused} reused freed row_number(s)).\")\n",
    "            final_dfs.append(df_lvl)\n",
    "\n",
    "        else:\n",
    "            excess = n_kept - target\n",
    "            df_lvl_indexed = df_lvl.set_index('aws_services')\n",
    "            for _ in range(excess):\n",
    "                top_arch = df_lvl_indexed.index.value_counts().idxmax()\n",
    "                row_to_drop = df_lvl_indexed.loc[[top_arch]].iloc[0]\n",
    "                scenarios_dropped.append(row_to_drop['folder_path'])\n",
    "                df_lvl_indexed = df_lvl_indexed[df_lvl_indexed['folder_path'] != row_to_drop['folder_path']]\n",
    "            df_lvl = df_lvl_indexed.reset_index()\n",
    "            print(f\"  \u2796 Level {level}: Dropped {excess} excess scenarios (prioritizing redundancy) to reach {target}.\")\n",
    "            final_dfs.append(df_lvl)\n",
    "\n",
    "    # \u2500\u2500 3. Combine & Save (row_number preserved for every kept row) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    df_balanced = pd.concat(final_dfs, ignore_index=True)\n",
    "\n",
    "    if 'tf_code' in df_balanced.columns:\n",
    "        missing_code = df_balanced['tf_code'].isna() | (df_balanced['tf_code'] == '')\n",
    "        if missing_code.any():\n",
    "            df_balanced.loc[missing_code, 'tf_code'] = df_balanced.loc[missing_code, 'folder_path'].apply(read_tf_content)\n",
    "    else:\n",
    "        df_balanced['tf_code'] = df_balanced['folder_path'].apply(read_tf_content)\n",
    "\n",
    "    df_balanced = df_balanced.sort_values('row_number').reset_index(drop=True)\n",
    "\n",
    "    # \u2500\u2500 Row-number stability guard \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    # Every row carried forward from the input PROMPTS_CSV (i.e. still present\n",
    "    # in df_balanced, not dropped by a gate/exclusion above) must keep its\n",
    "    # EXACT row_number -- that's the whole point of existing_row_map. This\n",
    "    # invariant was silently violated for ~2 years' worth of prior sessions\n",
    "    # (root-caused 2026-08-23: an older, pre-reconciliation version of this\n",
    "    # cell reassigned row_number from scratch on every run, before the\n",
    "    # existing_row_map logic above was ever added -- see CLAUDE.md). Assert\n",
    "    # it here, BEFORE writing to disk, so any future regression in this\n",
    "    # cell's logic is caught immediately and the corrupted file is never\n",
    "    # persisted, instead of silently drifting unnoticed again.\n",
    "    _carried_forward = set(existing_row_map.keys()) & set(df_balanced['folder_path'])\n",
    "    _new_row_number_map = dict(zip(df_balanced['folder_path'], df_balanced['row_number']))\n",
    "    _stability_violations = {\n",
    "        p: (existing_row_map[p], _new_row_number_map[p])\n",
    "        for p in _carried_forward\n",
    "        if existing_row_map[p] != _new_row_number_map[p]\n",
    "    }\n",
    "    if _stability_violations:\n",
    "        raise AssertionError(\n",
    "            f\"Row-number stability violated for {len(_stability_violations)} carried-forward \"\n",
    "            f\"row(s) -- refusing to write {PROMPTS_CSV.name}. A row present in both the input \"\n",
    "            f\"and output must keep its row_number unchanged. Sample violations \"\n",
    "            f\"(folder_path: (old_row_number, new_row_number)): \"\n",
    "            f\"{dict(list(_stability_violations.items())[:5])}\"\n",
    "        )\n",
    "    print(f\"\u2705 Row-number stability guard: all {len(_carried_forward)} carried-forward row(s) kept their exact row_number.\")\n",
    "\n",
    "    df_balanced.to_csv(PROMPTS_CSV, index=False)\n",
    "    df_balanced.to_csv(FINAL_BENCHMARK_CSV, index=False)\n",
    "\n",
    "    print(f\"\\n\ud83c\udf89 Final custom benchmark assembled with {len(df_balanced)} scenarios.\")\n",
    "    print(f\"\ud83d\udcc1 Updated: {PROMPTS_CSV.name}\")\n",
    "    print(f\"\ud83d\udcc1 Updated: {FINAL_BENCHMARK_CSV.name}\")\n",
    "\n",
    "    print(\"\\n\ud83d\udcdd Changelog:\")\n",
    "    print(f\"\ud83d\udd34 Removed {len(scenarios_dropped)} scenarios:\")\n",
    "    for f in sorted(set(scenarios_dropped))[:10]: print(f\"   - {f}\")\n",
    "    if len(scenarios_dropped) > 10: print(f\"   ... and {len(scenarios_dropped) - 10} more.\")\n",
    "    print(f\"\\n\ud83d\udfe2 Added {len(scenarios_added)} new scenarios:\")\n",
    "    for f in sorted(scenarios_added)[:10]: print(f\"   + {f}\")\n",
    "    if len(scenarios_added) > 10: print(f\"   ... and {len(scenarios_added) - 10} more.\")\n",
    "\n",
    "    missing_prompts = df_balanced['user_prompt'].isna().sum()\n",
    "    if missing_prompts > 0:\n",
    "        print(f\"\\n\ud83d\ude80 Next Step: Run generate_llm_prompts.py to generate the {missing_prompts} missing prompt(s), then Cell 14b below.\")\n",
    "    else:\n",
    "        print(\"\\n\ud83d\ude80 Next Step: Run Cell 14b (near-duplicate check) below, then Cell 15 to format tf_benchmark.csv for evaluation.\")\n",
    "\n",
    "    # \u2500\u2500 4. Visualisations \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "    sns.set_theme(style=\"whitegrid\")\n",
    "    fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "    fig.suptitle(f'Final Benchmark Distribution (N={len(df_balanced)})', fontsize=16, fontweight='bold', y=1.05)\n",
    "\n",
    "    sns.countplot(data=df_balanced, x='difficulty', ax=axes[0], palette='viridis')\n",
    "    axes[0].set_title('Scenarios per Difficulty Level')\n",
    "\n",
    "    sns.boxplot(data=df_balanced, x='difficulty', y='loc', ax=axes[1], palette='viridis')\n",
    "    axes[1].set_title('Lines of Code (LoC) by Difficulty')\n",
    "\n",
    "    sns.boxplot(data=df_balanced, x='difficulty', y='n_resources', ax=axes[2], palette='viridis')\n",
    "    axes[2].set_title('Resource Count by Difficulty')\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
