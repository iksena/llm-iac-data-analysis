    "# ── 5. Collect CloudFormation Templates → Raw Dataset ─────────────────────────\n",
    "# Unlike Terraform, a single CFN file IS the complete stack definition —\n",
    "# no multi-file merging is needed. We simply collect every .json/.yaml/\n",
    "# .yml/.template file that looks like a CFN template (has a top-level\n",
    "# Resources key, once parsed correctly — see note below on why parsing\n",
    "# must NOT trust the file extension).\n",
    "\n",
    "import json, yaml, re\n",
    "\n",
    "_SKIP_RE = re.compile(\n",
    "    r'(^|/)(\\.|__pycache__|\\.git|\\.terraform|tests?|fixtures?|'\n",
    "    r'testdata|vendor|node_modules|cdk\\.out|\\.aws-sam)(/|$)',\n",
    "    re.IGNORECASE,\n",
    ")\n",
    "\n",
    "def _should_skip(rel_path: str) -> bool:\n",
    "    return bool(_SKIP_RE.search(rel_path))\n",
    "\n",
    "# ── CFN-aware YAML loader ──────────────────────────────────────────────────────\n",
    "# Plain yaml.safe_load throws on CloudFormation's short-form intrinsic-function\n",
    "# tags (!Ref, !GetAtt, !Sub, !Join, ...), which are extremely common in\n",
    "# real-world templates. Without a fix, every template using them silently\n",
    "# fails to parse here and is dropped before it ever reaches cell 11. We\n",
    "# register constructors that map each short tag back to its long Fn:: form\n",
    "# as a 1-key dict, so the result is structurally identical to what\n",
    "# json.loads would produce for the equivalent JSON template. This is the\n",
    "# SAME loader cell 11 uses for metrics extraction — defined once here so\n",
    "# both stages agree on what parses.\n",
    "class CfnYamlLoader(yaml.SafeLoader):\n",
    "    pass\n",
    "\n",
    "def _cfn_multi_constructor(loader, tag_suffix, node):\n",
    "    key = tag_suffix if tag_suffix == 'Ref' else f'Fn::{tag_suffix}'\n",
    "    if isinstance(node, yaml.ScalarNode):\n",
    "        value = loader.construct_scalar(node)\n",
    "        if key == 'Fn::GetAtt' and isinstance(value, str) and '.' in value:\n",
    "            value = value.split('.')\n",
    "    elif isinstance(node, yaml.SequenceNode):\n",
    "        value = loader.construct_sequence(node)\n",
    "    else:\n",
    "        value = loader.construct_mapping(node)\n",
    "    return {key: value}\n",
    "\n",
    "CfnYamlLoader.add_multi_constructor('!', _cfn_multi_constructor)\n",
    "\n",
    "def _parse_cfn_content(content: str):\n",
    "    \"\"\"Parse CFN content WITHOUT trusting the file extension.\n",
    "\n",
    "    Empirically, extension is not a reliable format signal for this corpus:\n",
    "    - .yaml/.yml files routinely use short-form intrinsic tags that break\n",
    "      plain yaml.safe_load (fixed by CfnYamlLoader above).\n",
    "    - .template files are frequently YAML despite the JSON-sounding name\n",
    "      (sampling this corpus: 9 of 12 non-test .template files are YAML,\n",
    "      not JSON) — forcing them through json.loads drops them all.\n",
    "    - .json files are, empirically, always valid JSON, but trying YAML\n",
    "      second is harmless (JSON is a YAML subset) and costs nothing since\n",
    "      we short-circuit on the first successful dict parse.\n",
    "\n",
    "    Tries json.loads first (fast, and the common case for .json), then\n",
    "    falls back to the CFN-aware YAML loader. Returns the parsed dict, or\n",
    "    None if neither succeeds.\n",
    "    \"\"\"\n",
    "    for loader in (json.loads, lambda c: yaml.load(c, Loader=CfnYamlLoader)):\n",
    "        try:\n",
    "            parsed = loader(content)\n",
    "            if isinstance(parsed, dict):\n",
    "                return parsed\n",
    "        except Exception:\n",
    "            continue\n",
    "    return None\n",
    "\n",
    "def _is_cfn_template(content: str, ext: str) -> tuple[bool, dict | None]:\n",
    "    \"\"\"Return (is_cfn, parsed_dict). Checks for CFN top-level keys.\"\"\"\n",
    "    parsed = _parse_cfn_content(content)\n",
    "    if not isinstance(parsed, dict):\n",
    "        return False, None\n",
    "    # Must have Resources (mandatory in all valid CFN templates)\n",
    "    if 'Resources' not in parsed:\n",
    "        return False, None\n",
    "    return True, parsed\n",
    "\n",
    "RAW_RECORDS = []\n",
    "\n",
    "for repo in eligible:\n",
    "    if 'local_path' not in repo:\n",
    "        continue\n",
    "    root     = pathlib.Path(repo['local_path'])\n",
    "    subdir   = repo.get('subdir', '')\n",
    "    scan_root = root / subdir if subdir else root\n",
    "\n",
    "    for cfn_path in scan_root.rglob('*'):\n",
    "        if cfn_path.suffix.lower() not in CFN_EXTENSIONS:\n",
    "            continue\n",
    "        if not cfn_path.is_file():\n",
    "            continue\n",
    "\n",
    "        rel = str(cfn_path.relative_to(root))\n",
    "        if _should_skip(rel):\n",
    "            continue\n",
    "\n",
    "        try:\n",
    "            content = cfn_path.read_text(encoding='utf-8', errors='replace')\n",
    "        except Exception:\n",
    "            continue\n",
    "\n",
    "        is_cfn, _ = _is_cfn_template(content, cfn_path.suffix.lower())\n",
    "        if not is_cfn:\n",
    "            continue\n",
    "\n",
    "        loc    = content.count('\\n') + 1\n",
    "        tokens = count_tokens(content)\n",
    "\n",
    "        RAW_RECORDS.append({\n",
    "            'source_slug'     : repo['slug'],\n",
    "            'source_category' : repo['category'],\n",
    "            'licence_spdx'    : repo['licence_spdx'],\n",
    "            'file_path'       : rel,\n",
    "            'file_ext'        : cfn_path.suffix.lower(),\n",
    "            'github_url'      : f'https://github.com/{repo[\"slug\"]}/blob/HEAD/{rel}',\n",
    "            'content'         : content,\n",
    "            'loc'             : loc,\n",
    "            'tokens'          : tokens,\n",
    "        })\n",
    "\n",
    "# ── Fold in externally-fetched benchmark sources (Multi-IaC-Eval, DPIaC-Eval) ──\n",
    "# These arrive via EXTERNAL_RECORDS (cells 4.5 / 4.6) without 'loc'/'tokens'\n",
    "# computed yet, since they don't go through the repo-walk above.\n",
    "n_repo_records = len(RAW_RECORDS)\n",
    "for rec in globals().get('EXTERNAL_RECORDS', []):\n",
    "    content = rec['content']\n",
    "    rec = dict(rec)  # don't mutate EXTERNAL_RECORDS itself\n",
    "    rec['loc']    = content.count('\\n') + 1\n",
    "    rec['tokens'] = count_tokens(content)\n",
    "    RAW_RECORDS.append(rec)\n",
    "n_external_records = len(RAW_RECORDS) - n_repo_records\n",
    "\n",
    "df_raw = pd.DataFrame(RAW_RECORDS)\n",
    "print(f'Raw collection: {len(df_raw):,} CFN templates '\n",
    "      f'({n_repo_records:,} from cloned repos + {n_external_records:,} from external benchmarks)')\n",
    "print(df_raw.groupby('source_slug')[['loc','tokens']]\n",
    "      .agg({'loc': 'mean', 'tokens': 'mean'})\n",
    "      .round(1).to_string())\n",
    "print(f'\\nFile extension breakdown:')\n",
    "print(df_raw['file_ext'].value_counts().to_string())\n"
   ]
