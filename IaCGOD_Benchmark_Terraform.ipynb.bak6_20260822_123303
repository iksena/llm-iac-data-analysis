    "CODE_SEARCH_QUERIES = [\n",
    "    # Strategy A: File size & strong TF anchor\n",
    "    '\"provider \\\\\"aws\\\\\"\" extension:tf size:>4000',\n",
    "    '\"provider \\\\\"aws\\\\\"\" extension:tf size:>8000',\n",
    "\n",
    "    # Strategy B: Heavyweight Resource Types\n",
    "    '\"resource \\\\\"aws_eks_cluster\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_rds_cluster\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_opensearch_domain\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_msk_cluster\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_ec2_transit_gateway\\\\\"\" extension:tf',\n",
    "    '\"module \\\\\"vpc\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_ecs_service\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_api_gateway_rest_api\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_cognito_user_pool\\\\\"\" extension:tf',\n",
    "\n",
    "    # Strategy C: Additional resource types whose real-world usage almost always\n",
    "    # drags in a web of supporting resources (subnets/parameter groups/security\n",
    "    # groups, IAM roles, node groups, launch templates, ...) -- same rationale\n",
    "    # as Strategy B, extended to services not yet covered there. Deliberately\n",
    "    # excludes aws_config_config_rule/aws_config_conformance_pack: those\n",
    "    # inflate n_resources/LoC with a flat enumeration of AWS-managed rule IDs\n",
    "    # rather than genuine architecture (see CLAUDE.md's compliance rule-list\n",
    "    # filter), and would just get filtered back out downstream -- wasting API\n",
    "    # quota to find them.\n",
    "    '\"resource \\\\\"aws_eks_node_group\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_neptune_cluster\\\\\"\" extension:tf',\n",
    "    '\"resource \\\\\"aws_docdb_cluster\\\\\"\" extension:tf',\n",
