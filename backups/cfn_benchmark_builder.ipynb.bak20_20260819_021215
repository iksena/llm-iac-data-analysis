    "    if scen['orig_dest_file'] not in df_prov.index:\n",
    "        raise KeyError(f\"❌ No provenance row for {scen['orig_dest_file']} in {AWS_CACHE_PATH.name}\")\n",
    "    prov = df_prov.loc[scen['orig_dest_file']]\n",
    "    f = dict(scen)\n",
    "    f['content'] = gf_path.read_text(encoding='utf-8')\n",
    "    f['source_slug'] = prov['source_slug']\n",
    "    f['licence_spdx'] = prov['licence_spdx']\n",
    "    f['github_url'] = prov['github_url']\n",
