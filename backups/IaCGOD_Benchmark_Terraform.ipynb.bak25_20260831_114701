    "# %%\n",
    "# \u2500\u2500 Utility: Compare Old vs New tf_benchmark_diff_345 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# \"Old\" is a saved snapshot -- before resampling, copy the current\n",
    "# tf_benchmark_diff_345.csv aside to OLD_DIFF345_CSV's filename (or point\n",
    "# OLD_DIFF345_CSV at whatever dated snapshot you saved). \"New\" is the\n",
    "# difficulty 3/4/5 slice derived fresh from the CURRENT tf_benchmark.csv, so\n",
    "# this works standalone without needing the cell above to have been re-run\n",
    "# first -- useful right after a difficulty recalculation/resample or a\n",
    "# manual ground-truth fix, before you've decided to overwrite the formatted\n",
    "# diff_345 export. Mirrors cfn_benchmark_builder.ipynb's \"Compare Old vs New\n",
    "# cfn_eval_benchmark_diff_345\" utility.\n",
    "#\n",
    "# Reports added/removed row_numbers, and for row_numbers present in both,\n",
    "# whether ground_truth_path/prompt/difficulty changed.\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "TF_BENCHMARK_CSV = DATASET_DIR / 'tf_benchmark.csv'\n",
    "OLD_DIFF345_CSV = DATASET_DIR / 'tf_benchmark_diff_345_22Aug.csv'\n",
    "\n",
    "if not OLD_DIFF345_CSV.exists():\n",
    "    print(f\"\u26a0\ufe0f {OLD_DIFF345_CSV.name} not found -- nothing to compare against.\")\n",
    "    print(\"   Save a snapshot first, e.g.:\")\n",
    "    print(f\"   cp {DATASET_DIR / 'tf_benchmark_diff_345.csv'} {OLD_DIFF345_CSV}\")\n",
    "    print(\"   ...then rerun this cell (or point OLD_DIFF345_CSV at a different dated snapshot).\")\n",
    "else:\n",
    "    df_old = pd.read_csv(OLD_DIFF345_CSV)\n",
    "\n",
    "    df_new_full = pd.read_csv(TF_BENCHMARK_CSV)\n",
    "    df_new = df_new_full[df_new_full['difficulty'].isin([3, 4, 5])].copy()\n",
    "\n",
    "    old_rows = df_old.set_index('row_number')\n",
    "    new_rows = df_new.set_index('row_number')\n",
    "\n",
    "    old_ids, new_ids = set(old_rows.index), set(new_rows.index)\n",
    "    removed = old_ids - new_ids\n",
    "    added = new_ids - old_ids\n",
    "    common = old_ids & new_ids\n",
    "\n",
    "    print(f\"Old diff_345: {len(df_old)} rows  |  New diff_345: {len(df_new)} rows\")\n",
    "    print(f\"Removed (in old, not in new): {len(removed)}\")\n",
    "    print(f\"Added   (in new, not in old): {len(added)}\")\n",
    "\n",
    "    changed_rows = []\n",
    "    for rn in sorted(common):\n",
    "        o, n = old_rows.loc[rn], new_rows.loc[rn]\n",
    "        diffs = []\n",
    "        if o['ground_truth_path'] != n['ground_truth_path']:\n",
    "            diffs.append(f\"ground_truth_path ({o['ground_truth_path']} -> {n['ground_truth_path']})\")\n",
    "        if o['difficulty'] != n['difficulty']:\n",
    "            diffs.append(f\"difficulty ({o['difficulty']} -> {n['difficulty']})\")\n",
    "        if str(o['prompt']) != str(n['prompt']):\n",
    "            diffs.append('prompt text changed')\n",
    "        if diffs:\n",
    "            changed_rows.append((rn, diffs))\n",
    "\n",
    "    print(f\"Changed (same row_number, different content): {len(changed_rows)}\")\n",
    "\n",
    "    if removed:\n",
    "        print(\"\\nRemoved row_numbers:\", sorted(removed))\n",
    "    if added:\n",
    "        print(\"Added row_numbers:\", sorted(added))\n",
    "    if changed_rows:\n",
    "        print(\"\\nChanged rows:\")\n",
    "        for rn, diffs in changed_rows:\n",
    "            print(f\"  row {rn}:\")\n",
    "            for d in diffs:\n",
    "                print(f\"     - {d}\")\n"
