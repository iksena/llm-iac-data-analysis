    "# %%\n",
    "# \u2500\u2500 Utility: Compare Old vs New cfn_eval_benchmark_diff_345 \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "# \"Old\" is whatever's currently on disk at cfn_eval_benchmark_diff_345.csv --\n",
    "# a difficulty 3/4/5 snapshot, normally last (re)generated by the cell above\n",
    "# right after a cell-14/15 run. \"New\" is the equivalent slice derived fresh\n",
    "# from the CURRENT final_benchmark_with_prompts.csv, so this works standalone\n",
    "# without needing cells 14/15 to have been re-run first (useful right after\n",
    "# a difficulty recalculation/resample or a manual ground-truth fix, before\n",
    "# you've decided to regenerate the formatted eval exports).\n",
    "#\n",
    "# Reports added/removed row_numbers, and for row_numbers present in both,\n",
    "# whether ground_truth_path/prompt/difficulty changed.\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "OLD_DIFF345_CSV = DATASET_DIR / 'cfn_eval_benchmark_diff_345.csv'\n",
    "PROMPTS_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "\n",
    "df_old = pd.read_csv(OLD_DIFF345_CSV)\n",
    "\n",
    "df_new_full = pd.read_csv(PROMPTS_CSV)\n",
    "prompt_col = (\n",
    "    'final_user_prompt'\n",
    "    if 'final_user_prompt' in df_new_full.columns and df_new_full['final_user_prompt'].notna().any()\n",
    "    else 'user_prompt'\n",
    ")\n",
    "df_new = df_new_full[df_new_full['difficulty'].isin([3, 4, 5])][\n",
    "    ['row_number', 'dest_file', prompt_col, 'difficulty']\n",
    "].copy()\n",
    "df_new = df_new.rename(columns={'dest_file': 'ground_truth_path', prompt_col: 'prompt'})\n",
    "\n",
    "old_rows = df_old.set_index('row_number')\n",
    "new_rows = df_new.set_index('row_number')\n",
    "\n",
    "old_ids, new_ids = set(old_rows.index), set(new_rows.index)\n",
    "removed = old_ids - new_ids\n",
    "added = new_ids - old_ids\n",
    "common = old_ids & new_ids\n",
    "\n",
    "print(f\"Old diff_345: {len(df_old)} rows  |  New diff_345: {len(df_new)} rows\")\n",
    "print(f\"Removed (in old, not in new): {len(removed)}\")\n",
    "print(f\"Added   (in new, not in old): {len(added)}\")\n",
    "\n",
    "changed_rows = []\n",
    "for rn in sorted(common):\n",
    "    o, n = old_rows.loc[rn], new_rows.loc[rn]\n",
    "    diffs = []\n",
    "    if o['ground_truth_path'] != n['ground_truth_path']:\n",
    "        diffs.append(f\"ground_truth_path ({o['ground_truth_path']} -> {n['ground_truth_path']})\")\n",
    "    if o['difficulty'] != n['difficulty']:\n",
    "        diffs.append(f\"difficulty ({o['difficulty']} -> {n['difficulty']})\")\n",
    "    if not str(n['prompt']):\n",
    "        diffs.append('prompt text empty')\n",
    "    if str(o['prompt']) != str(n['prompt']):\n",
    "        diffs.append('prompt text changed')\n",
    "    if diffs:\n",
    "        changed_rows.append((rn, diffs))\n",
    "\n",
    "print(f\"Changed (same row_number, different content): {len(changed_rows)}\")\n",
    "\n",
    "if removed:\n",
    "    print(\"\\nRemoved row_numbers:\", sorted(removed))\n",
    "if added:\n",
    "    print(\"Added row_numbers:\", sorted(added))\n",
    "if changed_rows:\n",
    "    print(\"\\nChanged rows:\")\n",
    "    for rn, diffs in changed_rows:\n",
    "        print(f\"  row {rn}:\")\n",
    "        for d in diffs:\n",
    "            print(f\"     - {d}\")\n"
