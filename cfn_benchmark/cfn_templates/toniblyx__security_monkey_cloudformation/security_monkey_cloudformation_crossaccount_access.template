{
   "AWSTemplateFormatVersion": "2010-09-09",
   "Parameters" : {
        "SecurityMonkeyInstanceAwsAccountId" : {
            "Description" : "Amazon Account ID hosting Security Monkey deployment",
            "Type" : "String",
            "Default": "1234567890"
        },
   },
   "Resources": {
      "SecurityMonkey": {
         "Type": "AWS::IAM::Role",
         "Properties": {
            "RoleName": "SecurityMonkey",
            "AssumeRolePolicyDocument": {
               "Version" : "2012-10-17",
               "Statement": [ {
                  "Effect": "Allow",
                  "Principal": {
                     "AWS": [ { "Fn::Sub" : "arn:aws:iam::${SecurityMonkeyInstanceAwsAccountId}:role/SecurityMonkeyInstanceProfile" } ]
                  },
                  "Action": [ "sts:AssumeRole" ]
               } ]
            },
            "Path": "/"
         }
      },
      "RolePolicies": {
         "Type": "AWS::IAM::Policy",
         "Properties": {
            "PolicyName": "SecurityMonkeyInstancePolicy",
            "PolicyDocument": {
               "Version" : "2012-10-17",
               "Statement": [ {
                  "Effect": "Allow",
