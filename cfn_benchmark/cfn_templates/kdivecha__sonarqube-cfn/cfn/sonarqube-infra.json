{
    "AWSTemplateFormatVersion": "2010-09-09",
    "Description": "SecurityGroup, RDS and EC2 templates.",
    "Parameters": {
        "DeployType": {
            "Type": "String"
        },
        "Bucket": {
            "Type": "String"
        },
        "DBName": {
            "Type": "String"
        },
        "DBUsername": {
            "Type": "String"
        },
        "DBPassword": {
            "Type": "String",
            "NoEcho": "True"
        },
        "DBSnapshotId": {
            "Type": "String"
        },
        "DBInstanceClass": {
            "Type": "String"
        },
        "DBEngineVersion": {
            "Type": "String"
        },
        "DBParameterFamily": {
            "Type": "String"
        },
        "DBSize": {
            "Type": "String"
        },
        "PrivateSubnets": {
            "Type": "List<AWS::EC2::Subnet::Id>"
        },
        "LoadBalancerSG": {
            "Type": "String"
        },
        "VpcId": {
            "Type": "AWS::EC2::VPC::Id"
        },
        "ImageId": {
            "Type": "AWS::EC2::Image::Id"
        },
        "IamInstanceProfile": {
            "Type": "String"
        },
        "InstanceType": {
            "Type": "String"
        },
        "Hostname": {
            "Type": "String"
        },
        "AFUser": {
            "Type": "String"
        },
        "AFPass": {
            "Type": "String",
            "NoEcho": "True"
        },
        "Environment": {
            "Type": "String"
        },
        "LDAPUser": {
            "Type": "String"
        },
        "LDAPPass": {
            "Type": "String",
            "NoEcho": "True"
        },
        "LDAPURL": {
            "Type": "String"
        },
        "CfnEndpointUrl": {
            "Type": "String"
        },
        "ArtUrl": {
            "Type": "String"
        },
        "ArtRepo": {
            "Type": "String"
        },
        "WamConfig": {
            "Type": "String"
        },
        "CredsBucket": {
            "Type": "String"
        },
        "AppSize": {
            "Type": "String"
        },
        "BannerText": {
            "Type": "String"
        },
        "BannerBg": {
            "Type": "String"
        },
        "BannerTextColor": {
            "Type": "String"
        },
        "EC2Domain": {
            "Type": "String"
        },
        "EnterpriseSecurityGroup": {
            "Type": "AWS::EC2::SecurityGroup::Id"
        },
        "CidrBlock": {
            "Type": "String"
        },
        "NtpServers": {
      "Description": "Timeserver address to append to chrony",
      "Type": "String"
    },
            "AppVersion" : {
                "Type": "String"
            }
    },
    "Conditions": {
        "UNCLASS": {
            "Fn::Equals": [
                {
                    "Ref": "AWS::Partition"
                },
                "aws"
            ]
        }
    },
    "Resources": {
        "RdsRes": {
            "Type": "AWS::CloudFormation::Stack",
            "Properties": {
                "Parameters": {
                    "ParentStack": {
                        "Ref": "AWS::StackName"
                    },
                    "DBUsername": {
                        "Ref": "DBUsername"
                    },
                    "DBPassword": {
                        "Ref": "DBPassword"
                    },
                    "DBName": {
                        "Ref": "DBName"
                    },
                    "DBSnapshotId": {
                        "Ref": "DBSnapshotId"
                    },
                    "DBEngineVersion": {
                        "Ref": "DBEngineVersion"
                    },
                    "DBParameterFamily": {
                        "Ref": "DBParameterFamily"
                    },
                    "DBSize": {
                        "Ref": "DBSize"
                    },
                    "SubnetIds": {
                        "Fn::Join": [
                            ",",
                            {
                                "Ref": "PrivateSubnets"
                            }
                        ]
                    },
                    "RDSInstanceClass": {
                        "Ref": "DBInstanceClass"
                    },
                    "VPCSecurityGroups": {
                        "Fn::GetAtt": [
                            "SgRes",
                            "Outputs.RdsSG"
                        ]
                    },
                    "Environment": {
                        "Ref": "Environment"
                    }
                },
                "TemplateURL": {
                    "Fn::If": [
                        "UNCLASS",
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-rds.json"
                                ]
                            ]
                        },
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::Region"
                                    },
                                    ".",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-rds.json"
                                ]
                            ]
                        }
                    ]
                }
            }
        },
        "SgRes": {
            "Type": "AWS::CloudFormation::Stack",
            "Properties": {
                "Parameters": {
                    "LoadBalancerSG": {
                        "Ref": "LoadBalancerSG"
                    },
                    "ParentStack": {
                        "Ref": "AWS::StackName"
                    },
                    "VpcId": {
                        "Ref": "VpcId"
                    }
                },
                "TemplateURL": {
                    "Fn::If": [
                        "UNCLASS",
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-sgs.json"
                                ]
                            ]
                        },
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::Region"
                                    },
                                    ".",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-sgs.json"
                                ]
                            ]
                        }
                    ]
                }
            }
        },
        "ec2Res": {
            "Type": "AWS::CloudFormation::Stack",
            "Properties": {
                "Parameters": {
                    "ParentStack": {
                        "Ref": "AWS::StackName"
                    },
                    "DeployType": {
                        "Ref": "DeployType"
                    },
                    "IamInstanceProfile": {
                        "Ref": "IamInstanceProfile"
                    },
                    "GroupSet": {
                        "Fn::Join": [
                            ",",
                            [
                                {
                                    "Fn::GetAtt": [
                                        "SgRes",
                                        "Outputs.AppSG"
                                    ]
                                },
                                {
                                    "Ref": "EnterpriseSecurityGroup"
                                }
                            ]
                        ]
                    },
                    "DBHost": {
                        "Fn::GetAtt": [
                            "RdsRes",
                            "Outputs.EndpointAddress"
                        ]
                    },
                    "DBName": {
                        "Ref": "DBName"
                    },
                    "DBUsername": {
                        "Ref": "DBUsername"
                    },
                    "DBPassword": {
                        "Ref": "DBPassword"
                    },
                    "ImageId": {
                        "Ref": "ImageId"
                    },
                    "Bucket": {
                        "Ref": "Bucket"
                    },
                    "SubnetId": {
                        "Fn::Select": [
                            "0",
                            {
                                "Ref": "PrivateSubnets"
                            }
                        ]
                    },
                    "InstanceType": {
                        "Ref": "InstanceType"
                    },
                    "AFUser": {
                        "Ref": "AFUser"
                    },
                    "AFPass": {
                        "Ref": "AFPass"
                    },
                    "Environment": {
                        "Ref": "Environment"
                    },
                    "LDAPUser": {
                        "Ref": "LDAPUser"
                    },
                    "LDAPPass": {
                        "Ref": "LDAPPass"
                    },
                    "LDAPURL": {
                        "Ref": "LDAPURL"
                    },
                    "CfnEndpointUrl": {
                        "Ref": "CfnEndpointUrl"
                    },
                    "ArtUrl": {
                        "Ref": "ArtUrl"
                    },
                    "ArtRepo": {
                        "Ref": "ArtRepo"
                    },
                    "CredsBucket": {
                        "Ref": "CredsBucket"
                    },
                    "WamConfig": {
                        "Ref": "WamConfig"
                    },
                    "AppSize": {
                        "Ref": "AppSize"
                    },
                    "BannerText": {
                        "Ref": "BannerText"
                    },
                    "BannerBg": {
                        "Ref": "BannerBg"
                    },
                    "BannerTextColor": {
                        "Ref": "BannerTextColor"
                    },
                    "EC2Domain": {
                        "Ref": "EC2Domain"
                    },
                    "Hostname": {
                        "Ref": "Hostname"
                    },
                    "CidrBlock": {
                        "Ref": "CidrBlock"
                    },
                    "NtpServers": {
            "Ref": "NtpServers"
          },
                        "AppVersion": {
                            "Ref": "AppVersion"
                    }
                },
                "TemplateURL": {
                    "Fn::If": [
                        "UNCLASS",
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-ec2.json"
                                ]
                            ]
                        },
                        {
                            "Fn::Join": [
                                "",
                                [
                                    "https://",
                                    {
                                        "Ref": "Bucket"
                                    },
                                    ".s3.",
                                    {
                                        "Ref": "AWS::Region"
                                    },
                                    ".",
                                    {
                                        "Ref": "AWS::URLSuffix"
                                    },
                                    "/Templates/sonarqube-ec2.json"
                                ]
                            ]
                        }
                    ]
                }
            }
        }
    }
}