    "    if _cache_df.index.duplicated().any():\n",
    "        _cache_df = _cache_df[~_cache_df.index.duplicated(keep='last')]\n",
    "    _cache = _cache_df.to_dict('index')\n",
    "    \n",
    "    _n_cached_errors = sum(1 for v in _cache.values() if v.get('spdx') == 'ERROR')\n",
    "    if _n_cached_errors:\n",
