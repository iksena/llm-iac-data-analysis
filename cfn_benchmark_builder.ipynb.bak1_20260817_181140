    "                _sleep_for_reset(reset_at)\n",
    "            else:\n",
    "                time.sleep(min(2 ** attempt * 2, 60))\n",
    "            continue\n",
    "\n",
    "        time.sleep(min(2 ** attempt, 30))\n",
    "\n",
    "    return {'spdx': 'ERROR', 'name': f'HTTP {last_status}'}\n",
    "\n",
    "# ── De-duplicate REPO_REGISTRY by slug ────────────────────────────────────────\n",
    "n_before_dedup = len(REPO_REGISTRY)\n",
