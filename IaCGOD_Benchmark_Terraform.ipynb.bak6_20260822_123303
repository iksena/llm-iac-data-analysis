    "# ── 12.5. Filter by Trivy Severity ────────────────────────────────────────────\n",
    "import pandas as pd\n",
    "\n",
    "TRIVY_SCANNED_CSV = DATASET_DIR / 'trivy_scanned_batch.csv'\n",
    "TRIVY_FILTERED_CSV = DATASET_DIR / 'trivy_filtered_batch.csv'\n",
