    "    print(\"\\n🏆 Top 5 AWS Resources per Difficulty Level:\")\n",
    "    \n",
    "    def extract_full_resources(folder_path_str):\n",
    "        \"\"\"Extracts exact AWS resource types (e.g., aws_instance) from .tf files.\"\"\"\n",
    "        resources = []\n",
    "        folder = Path(folder_path_str)\n",
    "        if not folder.exists(): \n",
    "            return resources\n",
    "            \n",
    "        for tf_file in folder.glob('*.tf'):\n",
    "            content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "            \n",
    "            # Try AST first\n",
    "            try:\n",
    "                ast = hcl2.load(io.StringIO(content))\n",
    "                for res_block in ast.get('resource', []):\n",
    "                    for res_type in res_block.keys():\n",
    "                        if str(res_type).startswith('aws_'):\n",
    "                            resources.append(str(res_type))\n",
    "                continue\n",
    "            except Exception:\n",
    "                pass\n",
    "                \n",
    "            # Regex Fallback\n",
    "            matches = re.findall(r'resource\\s+\"(aws_[a-zA-Z0-9_]+)\"', content)\n",
    "            resources.extend(matches)\n",
    "            \n",
    "        return resources\n",
    "\n",
    "    # Iterate through each difficulty level and aggregate resource types\n",
    "    for level in sorted(df_deploy['difficulty'].dropna().unique()):\n",
    "        level_df = df_deploy[df_deploy['difficulty'] == level]\n",
    "        all_resources = []\n",
    "        \n",
    "        for fp in level_df['folder_path']:\n",
    "            all_resources.extend(extract_full_resources(fp))\n",
    "        \n",
    "        top_res = Counter(all_resources).most_common(5)\n",
    "        \n",
    "        print(f\"\\nLevel {int(level)} (n={len(level_df)} scenarios):\")\n",
    "        for res_type, count in top_res:\n",
    "            print(f\"  - {res_type}: {count} occurrences\")"
