    "# user_prompt, filled in afterward by generate_llm_prompts.py pointed at\n",
    "# this file via TF_PROMPTS_CSV.\n",
    "\n",
    "surviving_folder_paths = (old_folder_paths & set(df_deployable_real['folder_path'])) - MANUAL_EXCLUDE_SET\n",
    "df_kept = df_deployable_real[df_deployable_real['folder_path'].isin(surviving_folder_paths)].copy()\n",
    "df_kept['row_number'] = df_kept['folder_path'].map(existing_row_map)\n",
    "df_kept['user_prompt'] = df_kept['folder_path'].map(existing_prompt_map)\n",
    "for _col, _mapping in existing_extra_maps.items():\n",
    "    df_kept[_col] = df_kept['folder_path'].map(_mapping)\n",
    "\n",
    "kept_by_block = defaultdict(list)\n",
    "for _, row in df_kept.iterrows():\n",
