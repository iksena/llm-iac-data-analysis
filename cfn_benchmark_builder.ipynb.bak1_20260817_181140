    "# excluded too, rather than silently passing through as if it had zero findings.\n",
    "\n",
    "TRIVY_SEVERITY_COLS = ('trivy_critical', 'trivy_high')\n",
    "for _col in TRIVY_SEVERITY_COLS:\n",
