{
     "AWSTemplateFormatVersion": "2010-09-09",
     "Description": "Creates one public subnet per availability zone.",
     "Resources": {
          "GreenVPC": {
               "Type": "AWS::EC2::VPC",
               "Properties": {
                    "CidrBlock": "10.24.0.0/16",
                    "EnableDnsSupport": true,
                    "EnableDnsHostnames": true,
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "synapse-dev-vpc-2"
                         }
                    ]
               }
          },
          "GreenInternetGateway": {
               "Type": "AWS::EC2::InternetGateway",
               "Properties": {
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         }
                    ]
               }
          },
          "GreenVPCGatewayAttachment": {
               "Type": "AWS::EC2::VPCGatewayAttachment",
               "Properties": {
                    "VpcId": {"Ref": "GreenVPC"},
                    "InternetGatewayId": {"Ref": "GreenInternetGateway"}
               }
          },
          "PublicUsEast1aSubnet": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.0.0/24",
                    "AvailabilityZone": "us-east-1a",
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1a"
                         }
                    ]
               }
          },
          "PublicUsEast1bSubnet": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.1.0/24",
                    "AvailabilityZone": "us-east-1b",
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1b"
                         }
                    ]
               }
          },
          "PublicUsEast1cSubnet": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": true,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.2.0/24",
                    "AvailabilityZone": "us-east-1c",
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1c"
                         }
                    ]
               }
          },
          "PublicUsEast1aNATGatwayEIP": {
               "Type": "AWS::EC2::EIP",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "PublicUsEast1aNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["PublicUsEast1aNATGatwayEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "PublicUsEast1aSubnet"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1aNATGatway"
                         }
                    ]
               }
          },
          "PublicUsEast1bNATGatwayEIP": {
               "Type": "AWS::EC2::EIP",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "PublicUsEast1bNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["PublicUsEast1bNATGatwayEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "PublicUsEast1bSubnet"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1bNATGatway"
                         }
                    ]
               }
          },
          "PublicUsEast1cNATGatwayEIP": {
               "Type": "AWS::EC2::EIP",
               "Properties": {
                    "Domain": "vpc"
               }
          },
          "PublicUsEast1cNATGatway": {
               "Type": "AWS::EC2::NatGateway",
               "Properties": {
                    "AllocationId": {"Fn::GetAtt": ["PublicUsEast1cNATGatwayEIP", "AllocationId"]},
                    "SubnetId": {"Ref": "PublicUsEast1cSubnet"},
                    "Tags": [
                         {
                              "Key": "Name",
                              "Value": "PublicUsEast1cNATGatway"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1a": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.32.0/24",
                    "AvailabilityZone": "us-east-1a",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1a"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1aRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "GreenVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1a"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1aPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1aRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1aNATGatway"}
               }
          },
          "GreenPrivateUsEast1aRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1a"},
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1aRouteTable"}
               }
          },
          "GreenPrivateUsEast1aNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1a"},
                    "NetworkAclId": {"Fn::GetAtt": ["GreenVPC", "DefaultNetworkAcl"]}
               }
          },
          "GreenPrivateUsEast1b": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.33.0/24",
                    "AvailabilityZone": "us-east-1b",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1b"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1bRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "GreenVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1b"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1bPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1bRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1bNATGatway"}
               }
          },
          "GreenPrivateUsEast1bRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1b"},
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1bRouteTable"}
               }
          },
          "GreenPrivateUsEast1bNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1b"},
                    "NetworkAclId": {"Fn::GetAtt": ["GreenVPC", "DefaultNetworkAcl"]}
               }
          },
          "GreenPrivateUsEast1c": {
               "Type": "AWS::EC2::Subnet",
               "Properties": {
                    "MapPublicIpOnLaunch": false,
                    "VpcId": {"Ref": "GreenVPC"},
                    "CidrBlock": "10.24.34.0/24",
                    "AvailabilityZone": "us-east-1c",
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1c"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1cRouteTable": {
               "Type": "AWS::EC2::RouteTable",
               "Properties": {
                    "VpcId": {"Ref": "GreenVPC"},
                    "Tags": [
                         {
                              "Key": "Application",
                              "Value": {"Ref": "AWS::StackName"}
                         },
                         {
                              "Key": "Name",
                              "Value": "GreenPrivateUsEast1c"
                         }
                    ]
               }
          },
          "GreenPrivateUsEast1cPrivateRoute": {
               "Type": "AWS::EC2::Route",
               "Properties": {
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1cRouteTable"},
                    "DestinationCidrBlock": "0.0.0.0/0",
                    "NatGatewayId": {"Ref": "PublicUsEast1cNATGatway"}
               }
          },
          "GreenPrivateUsEast1cRouteTableAssociation": {
               "Type": "AWS::EC2::SubnetRouteTableAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1c"},
                    "RouteTableId": {"Ref": "GreenPrivateUsEast1cRouteTable"}
               }
          },
          "GreenPrivateUsEast1cNetworkAclAssociation": {
               "Type": "AWS::EC2::SubnetNetworkAclAssociation",
               "Properties": {
                    "SubnetId": {"Ref": "GreenPrivateUsEast1c"},
                    "NetworkAclId": {"Fn::GetAtt": ["GreenVPC", "DefaultNetworkAcl"]}
               }
          },
          "VPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": "*",
                              "Action": ["*"],
                              "Resource": ["*"]
                         }]
                    },
                    "RouteTableIds": [
                         {"Ref": "GreenPrivateUsEast1aRouteTable"},
                         {"Ref": "GreenPrivateUsEast1bRouteTable"},
                         {"Ref": "GreenPrivateUsEast1cRouteTable"}
                    ],
                    "ServiceName": {"Fn::Join": [
                         "",
                         [
                              "com.amazonaws.",
                              {"Ref": "AWS::Region"},
                              ".s3"
                         ]
                    ]},
                    "VpcId": {"Ref": "GreenVPC"}
               }
          },
          "VPCEndpointSecurityGroup": {
               "Type": "AWS::EC2::SecurityGroup",
               "Properties": {
                    "GroupDescription": "Allow access from the VPC cidr",
                    "VpcId": {"Ref": "GreenVPC"},
                    "SecurityGroupIngress": [{
                         "IpProtocol": "tcp",
                         "FromPort": 443,
                         "ToPort": 443,
                         "CidrIp": "10.24.0.0/16"
                    }]
               }
          },
          "OpenSearchVpcEndpoint": {
               "Type": "AWS::OpenSearchServerless::VpcEndpoint",
               "Properties": {
                    "Name": "open-search-vpce",
                    "VpcId": {"Ref": "GreenVPC"},
                    "SubnetIds": [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ],
                    "SecurityGroupIds": [{"Ref": "VPCEndpointSecurityGroup"}]
               }
          },
          "bedrockVPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": { "AWS": [{ "Ref": "AWS::AccountId" }, "050451359079"]},
                              "Action": "*",
                              "Resource": "*"
                         }]
                    },
                    "PrivateDnsEnabled": true,
                    "ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock"},
                    "SubnetIds": [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ],
                    "SecurityGroupIds": [{"Ref": "VPCEndpointSecurityGroup"}],
                    "Tags": [{
                         "Key": "Name",
                         "Value": "bedrock-vpce"
                    }],
                    "VpcEndpointType": "Interface",
                    "VpcId": {"Ref": "GreenVPC"}
               }
          },
          "bedrockagentVPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": { "AWS": [{ "Ref": "AWS::AccountId" }, "050451359079"]},
                              "Action": "*",
                              "Resource": "*"
                         }]
                    },
                    "PrivateDnsEnabled": true,
                    "ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock-agent"},
                    "SubnetIds": [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ],
                    "SecurityGroupIds": [{"Ref": "VPCEndpointSecurityGroup"}],
                    "Tags": [{
                         "Key": "Name",
                         "Value": "bedrock-agent-vpce"
                    }],
                    "VpcEndpointType": "Interface",
                    "VpcId": {"Ref": "GreenVPC"}
               }
          },
          "bedrockruntimeVPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": { "AWS": [{ "Ref": "AWS::AccountId" }, "050451359079"]},
                              "Action": "*",
                              "Resource": "*"
                         }]
                    },
                    "PrivateDnsEnabled": true,
                    "ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock-runtime"},
                    "SubnetIds": [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ],
                    "SecurityGroupIds": [{"Ref": "VPCEndpointSecurityGroup"}],
                    "Tags": [{
                         "Key": "Name",
                         "Value": "bedrock-runtime-vpce"
                    }],
                    "VpcEndpointType": "Interface",
                    "VpcId": {"Ref": "GreenVPC"}
               }
          },
          "bedrockagentruntimeVPCEndpoint": {
               "Type": "AWS::EC2::VPCEndpoint",
               "Properties": {
                    "PolicyDocument": {
                         "Version": "2012-10-17",
                         "Statement": [{
                              "Effect": "Allow",
                              "Principal": { "AWS": [{ "Ref": "AWS::AccountId" }, "050451359079"]},
                              "Action": "*",
                              "Resource": "*"
                         }]
                    },
                    "PrivateDnsEnabled": true,
                    "ServiceName": {"Fn::Sub": "com.amazonaws.${AWS::Region}.bedrock-agent-runtime"},
                    "SubnetIds": [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ],
                    "SecurityGroupIds": [{"Ref": "VPCEndpointSecurityGroup"}],
                    "Tags": [{
                         "Key": "Name",
                         "Value": "bedrock-agent-runtime-vpce"
                    }],
                    "VpcEndpointType": "Interface",
                    "VpcId": {"Ref": "GreenVPC"}
               }
          }
     },
     "Outputs": {
          "PrivateSubnets": {
               "Description": "Comma separated list of all private sub-nets",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "GreenPrivateUsEast1a"},
                         {"Ref": "GreenPrivateUsEast1b"},
                         {"Ref": "GreenPrivateUsEast1c"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets"
                    ]
               ]}}
          },
          "PrivateSubnetRouteTableIds": {
               "Description": "Comma separated list of all private sub-net route table IDs",
               "Value": {"Fn::Join": [
                    ", ",
                    [
                         {"Ref": "GreenPrivateUsEast1aRouteTable"},
                         {"Ref": "GreenPrivateUsEast1bRouteTable"},
                         {"Ref": "GreenPrivateUsEast1cRouteTable"}
                    ]
               ]},
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "Private-Subnets-RouteTableIds"
                    ]
               ]}}
          },
          "SubnetGroupCIDR": {
               "Description": "CIDR for this subnetgroup",
               "Value": "10.24.32.0/21",
               "Export": {"Name": {"Fn::Join": [
                    "-",
                    [
                         {"Ref": "AWS::Region"},
                         {"Ref": "AWS::StackName"},
                         "CIDR"
                    ]
               ]}}
          },
          "OpenSearchVpcEndpoint": {
               "Description": "The Id of the VPC endpoint that can be used by to access serverless open search from the VPC.",
               "Value": {"Ref": "OpenSearchVpcEndpoint"},
               "Export": {"Name": {"Fn::Sub": "${AWS::Region}-synapse-dev-vpc-2-open-search-vpce"}}
          },
          "bedrockVPCEndpoint": {
               "Description": "The Id of the VPC endpoint used to access Bedrock from the VPC",
               "Value": {"Ref": "bedrockVPCEndpoint"},
               "Export": {"Name": {"Fn::Sub": "${AWS::Region}-synapse-dev-vpc-2-bedrock-vpce"}}
          },
          "bedrockagentVPCEndpoint": {
               "Description": "The Id of the VPC endpoint used to access Bedrock from the VPC",
               "Value": {"Ref": "bedrockagentVPCEndpoint"},
               "Export": {"Name": {"Fn::Sub": "${AWS::Region}-synapse-dev-vpc-2-bedrockagent-vpce"}}
          },
          "bedrockruntimeVPCEndpoint": {
               "Description": "The Id of the VPC endpoint used to access Bedrock from the VPC",
               "Value": {"Ref": "bedrockruntimeVPCEndpoint"},
               "Export": {"Name": {"Fn::Sub": "${AWS::Region}-synapse-dev-vpc-2-bedrockruntime-vpce"}}
          },
          "bedrockagentruntimeVPCEndpoint": {
               "Description": "The Id of the VPC endpoint used to access Bedrock from the VPC",
               "Value": {"Ref": "bedrockagentruntimeVPCEndpoint"},
               "Export": {"Name": {"Fn::Sub": "${AWS::Region}-synapse-dev-vpc-2-bedrockagentruntime-vpce"}}
          }
     }
}