    "# %%\n",
    "# ── Utility: Purge Non-AWS Scenarios (Batch, Resumable, AST-based) ────────────\n",
    "import pandas as pd\n",
    "import re\n",
    "import io\n",
    "import hcl2\n",
    "import signal\n",
    "from pathlib import Path\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "DATASET_DIR = Path('./iac_benchmark/dataset')\n",
    "AWS_CHECK_CACHE = DATASET_DIR / 'aws_scrub_cache.csv'\n",
    "\n",
    "# Fallback regex in case AST parsing fails due to invalid syntax\n",
    "AWS_PATTERN = re.compile(r'(provider\\s+\"aws\"|resource\\s+\"aws_|data\\s+\"aws_)', re.MULTILINE)\n",
    "\n",
    "class TimeoutException(Exception):\n",
    "    pass\n",
    "\n",
    "def timeout_handler(signum, frame):\n",
    "    raise TimeoutException(\"Parser timed out!\")\n",
    "\n",
    "def parse_hcl2_safe(content, timeout_sec=2):\n",
    "    \"\"\"Safely parse HCL2 with a strict timeout to prevent catastrophic deadlocks.\"\"\"\n",
    "    if len(content.encode('utf-8')) > 150_000:\n",
    "        return None\n",
    "    old_handler = signal.signal(signal.SIGALRM, timeout_handler)\n",
    "    signal.alarm(timeout_sec)\n",
    "    try:\n",
    "        return hcl2.load(io.StringIO(content))\n",
    "    except Exception:\n",
    "        return None\n",
    "    finally:\n",
    "        signal.alarm(0)\n",
    "        signal.signal(signal.SIGALRM, old_handler)\n",
    "\n",
    "def is_aws_scenario(folder_path_str):\n",
    "    \"\"\"Checks if a scenario targets AWS using AST, falling back to regex.\"\"\"\n",
    "    folder = Path(folder_path_str)\n",
    "    if not folder.exists():\n",
    "        return False\n",
    "        \n",
    "    for tf_file in folder.glob('*.tf'):\n",
    "        content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "        \n",
    "        # 1. Try AST Parsing\n",
    "        ast = parse_hcl2_safe(content)\n",
    "        if ast:\n",
    "            # Check providers\n",
    "            for p in ast.get('provider', []):\n",
    "                if 'aws' in p: return True\n",
    "            # Check resources\n",
    "            for r in ast.get('resource', []):\n",
    "                if any(rtype.startswith('aws_') for rtype in r.keys()): return True\n",
    "            # Check data sources\n",
    "            for d in ast.get('data', []):\n",
    "                if any(dtype.startswith('aws_') for dtype in d.keys()): return True\n",
    "        \n",
    "        # 2. Fallback to Regex (catches malformed files the parser rejected)\n",
    "        if AWS_PATTERN.search(content):\n",
    "            return True\n",
    "            \n",
    "    return False\n",
    "\n",
    "# List of all cache files that might contain legacy non-AWS data\n",
    "caches = [\n",
    "    'ast_parse_cache.csv',\n",
    "    'tflint_cache.csv',\n",
    "    'trivy_cache.csv',\n",
    "    'deploy_cache.csv'\n",
    "]\n",
    "\n",
    "# ── 1. Gather all unique scenarios from existing caches ───────────────────────\n",
    "print(\"🔍 Gathering unique scenarios across all caches...\")\n",
    "unique_scenarios = {}\n",
    "for cache_name in caches:\n",
    "    cache_file = DATASET_DIR / cache_name\n",
    "    if cache_file.exists():\n",
    "        df = pd.read_csv(cache_file)\n",
    "        if 'scenario_id' in df.columns and 'folder_path' in df.columns:\n",
    "            for _, row in df[['scenario_id', 'folder_path']].drop_duplicates().iterrows():\n",
    "                unique_scenarios[row['scenario_id']] = row['folder_path']\n",
    "\n",
    "# ── 2. Load Resume State ──────────────────────────────────────────────────────\n",
    "file_has_header = AWS_CHECK_CACHE.exists()\n",
    "if file_has_header:\n",
    "    df_checked = pd.read_csv(AWS_CHECK_CACHE)\n",
    "    checked_ids = set(df_checked['scenario_id'])\n",
    "    print(f\"✅ Loaded {len(checked_ids)} previously checked scenarios from {AWS_CHECK_CACHE.name}.\")\n",
    "else:\n",
    "    checked_ids = set()\n",
    "\n",
    "# ── 3. Process Unchecked Scenarios in Batches ─────────────────────────────────\n",
