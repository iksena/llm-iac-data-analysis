    "# %%\n",
    "# \u2500\u2500 7.8. AWS Targeting Filter (Pre-AST Parsing) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "import re\n",
    "import pathlib\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "print(f\"Filtering {len(raw_scenarios)} raw scenarios for AWS resources/providers...\")\n",
    "\n",
    "# Regex to detect explicit AWS provider or implicitly required AWS resources/data sources\n",
    "AWS_PATTERN = re.compile(r'(provider\\s+\"aws\"|resource\\s+\"aws_|data\\s+\"aws_)', re.MULTILINE)\n",
    "\n",
    "def is_aws_scenario(folder_path_str):\n",
    "    folder = pathlib.Path(folder_path_str)\n",
    "    if not folder.exists():\n",
    "        return False\n",
    "        \n",
    "    for tf_file in folder.glob('*.tf'):\n",
    "        try:\n",
    "            content = tf_file.read_text(encoding='utf-8', errors='ignore')\n",
    "            if AWS_PATTERN.search(content):\n",
    "                return True\n",
    "        except Exception:\n",
    "            continue\n",
    "    return False\n",
    "\n",
    "aws_scenarios = []\n",
    "for rec in tqdm(raw_scenarios, desc=\"Checking for AWS targets\"):\n",
    "    if is_aws_scenario(rec['folder_path']):\n",
    "        aws_scenarios.append(rec)\n",
    "\n",
    "dropped = len(raw_scenarios) - len(aws_scenarios)\n",
    "\n",
    "print(f\"\\n\u2705 AWS Targeting Filter Complete!\")\n",
    "print(f\"  -> Original scenarios: {len(raw_scenarios)}\")\n",
    "print(f\"  -> Dropped (Non-AWS) : {dropped}\")\n",
    "print(f\"  -> Remaining AWS     : {len(aws_scenarios)}\")\n",
    "\n",
    "# Overwrite the global raw_scenarios list so Cell 8 only parses AWS templates\n",
    "raw_scenarios = aws_scenarios"
   ]
