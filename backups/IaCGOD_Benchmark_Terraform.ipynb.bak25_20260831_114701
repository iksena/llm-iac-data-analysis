    "            return True\n",
    "            \n",
    "    return False\n",
    "\n",
    "# List of all cache files that might contain legacy non-AWS data\n",
    "caches = [\n",
    "    'ast_parse_cache.csv',\n",
    "    'tflint_cache.csv',\n",
    "    'trivy_cache.csv',\n",
    "    'deploy_cache.csv'\n",
    "]\n",
    "\n",
    "# \u2500\u2500 1. Gather all unique scenarios from existing caches \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "print(\"\ud83d\udd0d Gathering unique scenarios across all caches...\")\n",
    "unique_scenarios = {}\n",
    "for cache_name in caches:\n",
    "    cache_file = DATASET_DIR / cache_name\n",
    "    if cache_file.exists():\n",
    "        df = pd.read_csv(cache_file)\n",
    "        if 'scenario_id' in df.columns and 'folder_path' in df.columns:\n",
    "            for _, row in df[['scenario_id', 'folder_path']].drop_duplicates().iterrows():\n",
    "                unique_scenarios[row['scenario_id']] = row['folder_path']\n",
    "\n",
    "# \u2500\u2500 2. Load Resume State \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "file_has_header = AWS_CHECK_CACHE.exists()\n",
    "if file_has_header:\n",
    "    df_checked = pd.read_csv(AWS_CHECK_CACHE)\n",
    "    checked_ids = set(df_checked['scenario_id'])\n",
    "    print(f\"\u2705 Loaded {len(checked_ids)} previously checked scenarios from {AWS_CHECK_CACHE.name}.\")\n",
    "else:\n",
    "    checked_ids = set()\n",
    "\n",
    "# \u2500\u2500 3. Process Unchecked Scenarios in Batches \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "scenarios_to_process = [(sid, path) for sid, path in unique_scenarios.items() if sid not in checked_ids]\n",
    "\n",
    "if scenarios_to_process:\n",
    "    print(f\"\ud83d\ude80 Processing {len(scenarios_to_process)} unchecked scenarios...\")\n",
    "    batch_data = []\n",
    "    SAVE_EVERY = 500\n",
    "    new_count = 0\n",
    "    \n",
    "    for sid, path in tqdm(scenarios_to_process, desc=\"Scanning for AWS\"):\n",
    "        is_aws = is_aws_scenario(path)\n",
    "        batch_data.append({'scenario_id': sid, 'is_aws': is_aws})\n",
    "        new_count += 1\n",
    "        \n",
    "        # Save progress and clear RAM\n",
    "        if new_count % SAVE_EVERY == 0:\n",
    "            pd.DataFrame(batch_data).to_csv(AWS_CHECK_CACHE, mode='a', header=not file_has_header, index=False)\n",
    "            file_has_header = True\n",
    "            batch_data.clear()\n",
    "            \n",
    "    # Final flush\n",
    "    if batch_data:\n",
    "        pd.DataFrame(batch_data).to_csv(AWS_CHECK_CACHE, mode='a', header=not file_has_header, index=False)\n",
    "else:\n",
    "    print(\"\u2705 All scenarios have already been checked.\")\n",
    "\n",
    "# \u2500\u2500 4. Apply the Filter to All Caches \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n",
    "df_aws_status = pd.read_csv(AWS_CHECK_CACHE)\n",
