    "RE_AWS_RESOURCE = re.compile(r'^\\s*resource\\s+\"(aws_[a-zA-Z0-9_]+)\"', re.MULTILINE)\n",
    "RE_VARIABLE     = re.compile(r'^\\s*variable\\s+\"', re.MULTILINE)\n",
    "\n",
    "for rec in scenarios_to_process:\n",
    "    scenario_id = rec['scenario_id']\n",
