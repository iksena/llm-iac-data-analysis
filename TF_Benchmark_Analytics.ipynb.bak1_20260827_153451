    "# Real terraform registry provider downloads benefit from the same plugin\n",
    "# cache this project already configured in ~/.terraformrc for the\n",
    "# LocalStack track's tflocal calls -- terraform (not just tflocal) honors it\n",
    "# too, so repeated inits across many scenarios reuse already-downloaded\n",
    "# provider binaries instead of re-downloading a fresh copy per scenario.\n",
    "_run_env['PATH'] = f\"/opt/homebrew/bin:{_run_env.get('PATH', '')}\"\n",
    "\n",
    "\n",
    "def _extract_error(text: str) -> str:\n",
    "    return (text or '').strip()[:1500]\n",
    "\n",
    "\n",
    "def _deploy_timeout_multiplier(content: str) -> int:\n",
    "    \"\"\"Mirrors the CFN track's own per-content timeout scaling -- a handful\n",
    "    of resource types routinely need much longer than DEPLOY_TIMEOUT_MIN to\n",
    "    finish on real AWS (EKS control-plane creation, ImageBuilder AMI builds,\n",
