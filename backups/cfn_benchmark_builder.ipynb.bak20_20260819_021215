    "# ── 6. Size Filter & Difficulty Assignment ────────────────────────────────────\n",
    "# CFN difficulty is a JOINT function of LoC and #Resources, mirroring the\n",
    "# Terraform track's calculate_difficulty(): a scenario only advances to a\n",
    "# harder level if it clears BOTH the LoC and resource-count bar for that\n",
    "# level. This is the single authoritative difficulty function for CFN --\n",
    "# it is computed once here and carried through unchanged by every\n",
    "# downstream cell (Aggregate & Export, Visualisation). Do not recompute or\n",
    "# override 'difficulty' anywhere else in this notebook.\n",
    "#\n",
    "# L5_LOC, L5_RES = 400, 12\n",
    "# L4_LOC, L4_RES = 250, 8\n",
    "# L3_LOC, L3_RES = 150, 4\n",
    "# L2_LOC, L2_RES = 80,  2\n",
    "#\n",
    "# Mirrors DPIaC-Eval difficulty stratification while\n",
    "# keeping both structural axes -- LoC and resource count -- consistent with\n",
    "# the Terraform track's methodology.\n",
    "\n",
    "def calculate_difficulty_cfn(row):\n",
    "    loc, res = row['loc'], row['n_resources']\n",
    "    if loc >= 400 and res >= 12: return 5\n",
    "    elif loc >= 250 and res >= 8:  return 4\n",
    "    elif loc >= 150 and res >= 4:  return 3\n",
    "    elif loc >= 80  and res >= 2:  return 2\n",
    "    else: return 1\n",
    "\n",
    "# Update metrics from normalised content (reparse after normalisation)\n",
    "df_raw['loc']    = df_raw['content_norm'].apply(lambda c: c.count('\\n') + 1)\n",
    "df_raw['tokens'] = df_raw['content_norm'].apply(count_tokens)\n",
    "df_raw['difficulty'] = df_raw.apply(calculate_difficulty_cfn, axis=1)\n",
    "\n",
    "# Apply filters\n",
    "mask_loc    = df_raw['loc'].between(MIN_LOC, MAX_LOC)\n",
    "mask_tokens = df_raw['tokens'] <= MAX_TOKENS\n",
    "MAX_RESOURCES = 100\n",
    "mask_res    = df_raw['n_resources'].between(MIN_RESOURCES, MAX_RESOURCES)\n",
