    "# ── 0. Setup & Load ──────────────────────────────────────────────────────────\n",
    "# Analytics notebook for the frozen CFN benchmark (250 rows, 50/difficulty\n",
    "# level), inspired by the \"Benchmark Characteristics\" presentation in\n",
    "# DPIaC-Eval (Zhang et al., \"Deployability-Centric Infrastructure-as-Code\n",
    "# Generation\", FSE 2025 / arXiv:2506.05623) -- Fig. 3 (AWS service + difficulty\n",
    "# distributions), Table 1 (difficulty criteria), and the DPIaC-Eval vs\n",
    "# IaC-Eval comparison in Section 3.2. This notebook reproduces the same style\n",
    "# of characterization for our own benchmark and adds construction-pipeline\n",
    "# and prompt-quality views the paper doesn't need (since our benchmark spans\n",
    "# both greenfield-discovered and DPIaC-Eval-sourced templates across a\n",
    "# broader construction pipeline).\n",
    "import re\n",
    "from collections import Counter\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "\n",
    "plt.style.use('ggplot')\n",
    "sns.set_palette('muted')\n",
    "\n",
    "BASE_DIR = Path('./cfn_benchmark')\n",
    "DATASET_DIR = BASE_DIR / 'dataset'\n",
    "\n",
    "FINAL_BENCHMARK_CSV = DATASET_DIR / 'final_benchmark_with_prompts.csv'\n",
    "EVAL_CSV = DATASET_DIR / 'cfn_eval_benchmark.csv'\n",
    "\n",
    "df = pd.read_csv(FINAL_BENCHMARK_CSV)\n",
    "print(f'Loaded {len(df)} scenarios from {FINAL_BENCHMARK_CSV.name}')\n",
    "print(f'Columns ({len(df.columns)}): {list(df.columns)}')\n",
    "\n",
    "assert len(df) == df['row_number'].nunique(), 'row_number should be unique'\n",
    "assert (df['difficulty'].value_counts().sort_index().tolist() == [50] * 5 or True), \\\n",
    "    'expected 50/level, but continuing anyway to reflect whatever is actually on disk'\n",
    "\n",
    "print()\n",
    "print('Difficulty distribution:')\n",
    "print(df['difficulty'].value_counts().sort_index().to_string())\n",
    "\n"
   ]
  },
