    "old_dest_files = set()\n",
    "\n",
    "sync_source = FINAL_EVAL_CSV if FINAL_EVAL_CSV.exists() else (PROMPTS_CSV if PROMPTS_CSV.exists() else None)\n",
    "\n",
    "if sync_source:\n",
    "    df_old = pd.read_csv(sync_source)\n",
    "    # Handle column variations gracefully\n",
    "    path_col = 'ground_truth_path' if 'ground_truth_path' in df_old.columns else 'dest_file'\n",
    "    prompt_col = 'final_user_prompt' if 'final_user_prompt' in df_old.columns and df_old['final_user_prompt'].notna().any() else ('user_prompt' if 'user_prompt' in df_old.columns else 'prompt')\n",
    "    \n",
    "    if 'row_number' in df_old.columns:\n",
    "        existing_row_map = dict(zip(df_old[path_col], df_old['row_number']))\n",
    "        max_existing_row_number = int(df_old['row_number'].max())\n",
    "        \n",
    "    if prompt_col in df_old.columns:\n",
    "        existing_prompt_map = dict(zip(df_old[path_col], df_old[prompt_col]))\n",
    "        \n",
    "    old_dest_files = set(df_old[path_col])\n",
    "    print(f\"\\nLoaded existing prompts from {sync_source.name}: {len(df_old)} scenarios.\")\n",
    "else:\n",
    "    print(\"\\nNo existing benchmark found -- building from scratch.\")\n",
    "\n",
    "# We only keep existing scenarios if they STILL exist in the valid deployable pool\n",
    "surviving_dest_files = old_dest_files & set(df_deployable['dest_file'])\n",
    "dropped_from_deploy = old_dest_files - set(df_deployable['dest_file'])\n",
    "\n",
    "# ── 1. Create the base 'Kept' dataframe with UPDATED difficulty ───────────────\n",
    "df_kept = df_deployable[df_deployable['dest_file'].isin(surviving_dest_files)].copy()\n",
    "df_kept['row_number'] = df_kept['dest_file'].map(existing_row_map)\n",
    "df_kept['user_prompt'] = df_kept['dest_file'].map(existing_prompt_map)\n",
    "\n",
    "# ── 2. Enforce Exactly 50 Per Level (Drop Excess & Sample Shortfall) ──────────\n",
    "def sample_diverse(df_candidates, target, group_col='aws_services', seed=42):\n",
    "    df_shuffled = df_candidates.sample(frac=1, random_state=seed).reset_index(drop=True)\n",
    "    group_rows = [g.to_dict('records') for _, g in df_shuffled.groupby(group_col)]\n",
    "    import random\n",
    "    random.seed(seed)\n",
    "    random.shuffle(group_rows)\n",
    "    sampled = []\n",
    "    while len(sampled) < target and group_rows:\n",
    "        next_group_rows = []\n",
    "        for g_list in group_rows:\n",
    "            if len(sampled) >= target: break\n",
    "            if g_list: sampled.append(g_list.pop(0))\n",
    "            if g_list: next_group_rows.append(g_list)\n",
    "        group_rows = next_group_rows\n",
    "    return pd.DataFrame(sampled)\n",
    "\n",
    "def _block_key(row):\n",
    "    return (row['n_resources'], frozenset(str(row.get('resource_types', '')).split(' | ')))\n",
    "\n",
    "kept_by_block = defaultdict(list)\n",
    "for _, row in df_kept.iterrows():\n",
    "    kept_by_block[_block_key(row)].append(row['content'])\n",
    "\n",
    "final_dfs = []\n",
    "next_row_number = max_existing_row_number + 1\n",
    "scenarios_dropped = list(dropped_from_deploy)\n",
    "scenarios_added = []\n",
    "\n",
    "print(\"\\n⚖️ Balancing to exact targets (50 per level)...\")\n",
    "\n",
    "for level in range(1, 6):\n",
    "    target = TARGETS_PER_LEVEL.get(level, 0)\n",
    "    df_lvl_kept = df_kept[df_kept['difficulty'] == level].copy()\n",
    "    n_kept = len(df_lvl_kept)\n",
    "    \n",
    "    # ── CASE A: Too many scenarios (Difficulty shifted UP) ──\n",
    "    if n_kept > target:\n",
    "        excess = n_kept - target\n",
    "        df_lvl_kept = df_lvl_kept.set_index('aws_services')\n",
    "        \n",
    "        for _ in range(excess):\n",
    "            # Find the most overrepresented architecture and drop one\n",
    "            top_arch = df_lvl_kept.index.value_counts().idxmax()\n",
    "            row_to_drop = df_lvl_kept.loc[[top_arch]].iloc[0]\n",
    "            scenarios_dropped.append(row_to_drop['dest_file'])\n",
    "            df_lvl_kept = df_lvl_kept[df_lvl_kept['dest_file'] != row_to_drop['dest_file']]\n",
    "            \n",
    "        df_lvl_kept = df_lvl_kept.reset_index()\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "        print(f\"  ➖ Level {level}: Dropped {excess} excess scenarios (prioritizing redundancy) to reach {target}.\")\n",
    "        \n",
    "    # ── CASE B: Too few scenarios (Difficulty shifted DOWN) ──\n",
    "    elif n_kept < target:\n",
    "        shortfall = target - n_kept\n",
    "        candidates = df_deployable[\n",
    "            (df_deployable['difficulty'] == level) &\n",
    "            (~df_deployable['dest_file'].isin(df_kept['dest_file']))\n",
    "        ].copy()\n",
    "        \n",
    "        ordered = sample_diverse(candidates, len(candidates), group_col='aws_services').to_dict('records')\n",
    "        \n",
    "        accepted = []\n",
    "        accepted_content_by_block = defaultdict(list)\n",
    "        \n",
    "        for rec in ordered:\n",
    "            if len(accepted) >= shortfall: break\n",
    "            key = _block_key(rec)\n",
    "            against = kept_by_block.get(key, []) + accepted_content_by_block.get(key, [])\n",
    "            is_dup = any(difflib.SequenceMatcher(None, rec['content'], other).quick_ratio() >= 0.90 for other in against)\n",
    "            if not is_dup:\n",
    "                accepted.append(rec)\n",
    "                accepted_content_by_block[key].append(rec['content'])\n",
    "                scenarios_added.append(rec['dest_file'])\n",
    "                \n",
    "        sampled = pd.DataFrame(accepted)\n",
    "        if not sampled.empty:\n",
    "            sampled['row_number'] = range(next_row_number, next_row_number + len(sampled))\n",
    "            sampled['user_prompt'] = np.nan \n",
    "            next_row_number += len(sampled)\n",
    "            df_lvl_kept = pd.concat([df_lvl_kept, sampled], ignore_index=True)\n",
    "            \n",
    "        print(f\"  ➕ Level {level}: Kept {n_kept}, sampled {len(sampled)} new diverse scenarios to reach {len(df_lvl_kept)}.\")\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "        \n",
    "    # ── CASE C: Exactly 50 ──\n",
    "    else:\n",
    "        print(f\"  ✅ Level {level}: Perfect at exactly {target} kept scenarios.\")\n",
    "        final_dfs.append(df_lvl_kept)\n",
    "\n",
    "# ── 3. Combine and Save ───────────────────────────────────────────────────────\n",
    "df_final = pd.concat(final_dfs, ignore_index=True)\n",
    "df_final = df_final.sort_values('row_number').reset_index(drop=True)\n",
    "\n",
    "# Drop the temporary content column before saving back to CSVs\n",
    "if 'content' in df_final.columns:\n",
    "    df_final = df_final.drop(columns=['content'])\n",
    "\n",
    "df_final.to_csv(FINAL_BENCHMARK_CSV, index=False)\n",
    "df_final.to_csv(PROMPTS_CSV, index=False)\n",
    "\n",
    "print(f\"\\n\\U0001F389 Final custom benchmark assembled with {len(df_final)} scenarios.\")\n",
    "print(f\"📁 Updated: {PROMPTS_CSV.name}\")\n",
    "\n",
    "# ── Print Changelog ──\n",
    "print(\"\\n📝 Changelog (Difficulty Alignment):\")\n",
    "print(f\"🔴 Removed {len(scenarios_dropped)} scenarios:\")\n",
    "for f in sorted(scenarios_dropped)[:10]: print(f\"   - {f}\")\n",
    "if len(scenarios_dropped) > 10: print(f\"   ... and {len(scenarios_dropped)-10} more.\")\n",
    "\n",
    "print(f\"\\n🟢 Added {len(scenarios_added)} new scenarios:\")\n",
    "for f in sorted(scenarios_added)[:10]: print(f\"   + {f}\")\n",
    "if len(scenarios_added) > 10: print(f\"   ... and {len(scenarios_added)-10} more.\")\n",
    "\n",
    "# ── 4. Visualisations ─────────────────────────────────────────────────────────\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5))\n",
    "fig.suptitle(f'Final Benchmark Distribution (N={len(df_final)})', fontsize=16, fontweight='bold', y=1.05)\n",
    "\n",
    "sns.countplot(data=df_final, x='difficulty', ax=axes[0], palette='viridis')\n",
    "axes[0].set_title('Scenarios per Difficulty Level')\n",
    "\n",
    "sns.boxplot(data=df_final, x='difficulty', y='loc', ax=axes[1], palette='viridis')\n",
    "axes[1].set_title('Lines of Code (LoC) by Difficulty')\n",
    "\n",
    "sns.boxplot(data=df_final, x='difficulty', y='n_resources', ax=axes[2], palette='viridis')\n",
    "axes[2].set_title('Resource Count by Difficulty')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nMedian Statistics by Difficulty Level:\")\n",
    "display(df_final.groupby('difficulty')[['loc', 'n_resources', 'n_parameters']].median().round(1))"
   ]
