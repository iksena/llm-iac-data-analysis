    "# BEFORE writing to disk, so a future regression in THIS cell's logic is\n",
    "# caught immediately instead of silently drifting unnoticed the same way.\n",
    "_carried_forward = set(existing_row_map.keys()) & set(df_final['folder_path'])\n",
    "_new_row_number_map = dict(zip(df_final['folder_path'], df_final['row_number']))\n",
    "_stability_violations = {\n",
    "    p: (existing_row_map[p], _new_row_number_map[p])\n",
    "    for p in _carried_forward\n",
    "    if existing_row_map[p] != _new_row_number_map[p]\n",
