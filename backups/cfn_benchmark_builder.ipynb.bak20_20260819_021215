    "    def extract_core_error(row):\n",
    "        if row.get('validate_pass') == False:\n",
    "            err = str(row.get('validate_error', ''))\n",
    "            return f\"[VALIDATION] {err.strip().split(chr(10))[0][:150]}\"\n",
    "        if row.get('deploy_pass') == False:\n",
    "            err = str(row.get('deploy_error', ''))\n",
    "            return f\"[DEPLOY] {err.strip().split(chr(10))[0][:150]}\"\n",
    "        return \"\"\n",
    "\n",
    "    df_deploy['core_error'] = df_deploy.apply(extract_core_error, axis=1)\n",
    "\n",
    "    # Substrings that mark an error as TRANSIENT (retriable)\n",
    "    TRANSIENT_SIGNATURES = [\n",
    "        \"nan\",\n",
    "        \"connection was closed before we received a valid response\",\n",
    "        \"could not connect to the endpoint url\",\n",
    "        \"service unavailable\",\n",
    "        \"(503)\",\n",
    "        \"(502)\",\n",
    "        \"timeout\",\n",
    "        \"waiter stackcreatecomplete failed\",\n",
    "        \"failed to delete\"\n",
    "    ]\n",
    "\n",
    "    def is_transient(err_str):\n",
    "        err_str = str(err_str).lower().strip()\n",
