    "# ── 3. Metadata (content_hash/loc/n_resources/resource_types/aws_services/\n",
    "#    difficulty) -- mirrors cells 5c/5b/6/7 exactly ─────────────────────────\n",
    "def _normalise_cfn(text):\n",
    "    text = text.replace('\\r\\n', '\\n').replace('\\r', '\\n')\n",
    "    text = text.replace('\\t', '  ')\n",
    "    text = '\\n'.join(line.rstrip() for line in text.split('\\n'))\n",
    "    text = _re.sub(r'\\n{3,}', '\\n\\n', text)\n",
    "    return text.strip()\n",
    "\n",
    "def _content_hash(text):\n",
    "    return hashlib.sha256(text.encode('utf-8')).hexdigest()\n",
    "\n",
    "class _CfnYamlLoader(yaml.SafeLoader):\n",
    "    pass\n",
    "\n",
    "def _cfn_multi_constructor(loader, tag_suffix, node):\n",
    "    key = tag_suffix if tag_suffix == 'Ref' else f'Fn::{tag_suffix}'\n",
    "    if isinstance(node, yaml.ScalarNode):\n",
    "        value = loader.construct_scalar(node)\n",
    "        if key == 'Fn::GetAtt' and isinstance(value, str) and '.' in value:\n",
    "            value = value.split('.')\n",
    "    elif isinstance(node, yaml.SequenceNode):\n",
    "        value = loader.construct_sequence(node)\n",
    "    else:\n",
    "        value = loader.construct_mapping(node)\n",
    "    return {key: value}\n",
    "\n",
    "_CfnYamlLoader.add_multi_constructor('!', _cfn_multi_constructor)\n",
    "\n",
    "def _parse_cfn(content):\n",
    "    for loader in (_json.loads, lambda c: yaml.load(c, Loader=_CfnYamlLoader)):\n",
    "        try:\n",
    "            parsed = loader(content)\n",
    "            if isinstance(parsed, dict):\n",
    "                return parsed\n",
    "        except Exception:\n",
    "            continue\n",
    "    return None\n",
    "\n",
    "_AWS_SERVICE_RE = _re.compile(r'^AWS::([A-Za-z0-9]+)::')\n",
    "\n",
    "def _extract_aws_service(resource_types):\n",
    "    services = set()\n",
    "    for rtype in resource_types:\n",
    "        m = _AWS_SERVICE_RE.match(rtype.strip())\n",
    "        if m:\n",
    "            services.add(m.group(1))\n",
    "    return ', '.join(sorted(services))\n",
    "\n",
    "def _calc_difficulty(loc, res):\n",
    "    if 'calculate_difficulty_cfn' in globals():\n",
    "        return calculate_difficulty_cfn({'loc': loc, 'n_resources': res})\n",
    "    if loc >= 400 and res >= 12: return 5\n",
    "    elif loc >= 250 and res >= 8: return 4\n",
    "    elif loc >= 150 and res >= 4: return 3\n",
    "    elif loc >= 80 and res >= 2: return 2\n",
    "    else: return 1\n",
    "\n",
    "for f in _MANUAL_FIXES:\n",
    "    f['content_norm'] = _normalise_cfn(f['content'])\n",
    "    parsed = _parse_cfn(f['content'])\n",
    "    resources = parsed.get('Resources', {}) if isinstance(parsed, dict) else {}\n",
    "    if not isinstance(resources, dict):\n",
    "        resources = {}\n",
    "    parameters = parsed.get('Parameters', {}) if isinstance(parsed, dict) else {}\n",
    "    if not isinstance(parameters, dict):\n",
    "        parameters = {}\n",
    "    resource_types = sorted({str(v.get('Type', '')) for v in resources.values() if isinstance(v, dict) and v.get('Type')})\n",
    "\n",
    "    f['content_hash'] = _content_hash(f['content_norm'])\n",
    "    f['loc'] = f['content_norm'].count('\\n') + 1\n",
    "    f['n_resources'] = len(resources)\n",
    "    f['n_parameters'] = len(parameters)\n",
    "    f['resource_types'] = ' | '.join(resource_types)\n",
    "    f['aws_services'] = _extract_aws_service(resource_types)\n",
    "    f['difficulty'] = _calc_difficulty(f['loc'], f['n_resources'])\n",
    "    f['file_ext'] = pathlib.Path(f['gf_dest_file']).suffix\n",
    "\n",
    "# ── 4. Actually run cfn-lint + Trivy (not a hardcoded verdict) ──────────────\n",
    "def _cfnlint_check(content, ext):\n",
    "    suffix = ext if ext.startswith('.') else f'.{ext}'\n",
    "    with tempfile.NamedTemporaryFile(suffix=suffix, mode='w', encoding='utf-8', delete=False) as fh:\n",
    "        fh.write(content)\n",
    "        tmp_path = fh.name\n",
    "    try:\n",
    "        result = subprocess.run(['cfn-lint', '--format', 'json', tmp_path], capture_output=True, text=True, timeout=60)\n",
    "        try:\n",
    "            matches = _json.loads(result.stdout) if result.stdout.strip() else []\n",
    "        except _json.JSONDecodeError:\n",
    "            matches = []\n",
    "        errors = [m for m in matches if m.get('Level') == 'Error']\n",
    "        warnings = [m for m in matches if m.get('Level') == 'Warning']\n",
    "        infos = [m for m in matches if m.get('Level') == 'Informational']\n",
    "        return {\n",
    "            'lint_pass': len(errors) == 0,\n",
    "            'lint_errors': len(errors),\n",
    "            'lint_warnings': len(warnings),\n",
    "            'lint_info': len(infos),\n",
    "            'lint_error_codes': ' | '.join({m.get('Rule', {}).get('Id', '') for m in errors}),\n",
    "            'lint_error_msg': str(errors[0].get('Message', ''))[:300] if errors else '',\n",
    "        }\n",
    "    finally:\n",
    "        pathlib.Path(tmp_path).unlink(missing_ok=True)\n",
    "\n",
    "def _trivy_check(content, ext):\n",
    "    suffix = ext if ext.startswith('.') else f'.{ext}'\n",
    "    with tempfile.NamedTemporaryFile(suffix=suffix, mode='w', encoding='utf-8', delete=False) as fh:\n",
    "        fh.write(content)\n",
    "        tmp_path = fh.name\n",
    "    try:\n",
    "        result = subprocess.run(['trivy', 'config', '--format', 'json', '--quiet', tmp_path], capture_output=True, text=True, timeout=90)\n",
    "        try:\n",
    "            data = _json.loads(result.stdout) if result.stdout.strip() else {}\n",
    "        except _json.JSONDecodeError:\n",
    "            return {'trivy_pass': None, 'trivy_critical': -1, 'trivy_high': -1, 'trivy_medium': -1,\n",
    "                    'trivy_low': -1, 'trivy_unknown': -1, 'trivy_findings_json': '[]',\n",
    "                    'trivy_checks_with_severity': '', 'trivy_error': 'parse_error'}\n",
    "        results = data.get('Results', []) if isinstance(data, dict) else []\n",
    "        misconfigs = []\n",
    "        for r in results:\n",
    "            misconfigs.extend(r.get('Misconfigurations', []))\n",
    "        findings, sev_counts = [], {'CRITICAL': 0, 'HIGH': 0, 'MEDIUM': 0, 'LOW': 0, 'UNKNOWN': 0}\n",
    "        for m in misconfigs:\n",
    "            sev = str(m.get('Severity', 'UNKNOWN')).upper()\n",
    "            if sev not in sev_counts:\n",
    "                sev = 'UNKNOWN'\n",
    "            sev_counts[sev] += 1\n",
    "            findings.append({'id': m.get('ID', ''), 'severity': sev, 'title': m.get('Title', '')})\n",
    "        checks_with_severity = ' | '.join(f\"{fd['id']}:{fd['severity']}\" for fd in findings if fd['id'])\n",
    "        return {\n",
    "            'trivy_pass': sev_counts['CRITICAL'] == 0 and sev_counts['HIGH'] == 0,\n",
    "            'trivy_critical': sev_counts['CRITICAL'], 'trivy_high': sev_counts['HIGH'],\n",
    "            'trivy_medium': sev_counts['MEDIUM'], 'trivy_low': sev_counts['LOW'],\n",
    "            'trivy_unknown': sev_counts['UNKNOWN'],\n",
    "            'trivy_findings_json': _json.dumps(findings, ensure_ascii=False),\n",
    "            'trivy_checks_with_severity': checks_with_severity, 'trivy_error': '',\n",
    "        }\n",
    "    finally:\n",
    "        pathlib.Path(tmp_path).unlink(missing_ok=True)\n",
    "\n",
    "lint_rows, sec_rows = [], []\n",
    "for f in _MANUAL_FIXES:\n",
    "    lint_res = _cfnlint_check(f['content'], f['file_ext'])\n",
    "    sec_res = _trivy_check(f['content'], f['file_ext'])\n",
    "    f.update(lint_res)\n",
    "    f.update(sec_res)\n",
    "    lint_rows.append({'content_hash': f['content_hash'], **lint_res})\n",
    "    sec_rows.append({'content_hash': f['content_hash'], **sec_res})\n",
    "    status = 'OK' if lint_res['lint_pass'] and sec_res['trivy_pass'] else 'NEEDS ATTENTION'\n",
    "    print(f\"  [{status:16s}] lint_errors={lint_res['lint_errors']} trivy_crit/high={sec_res['trivy_critical']}/{sec_res['trivy_high']}  {f['gf_dest_file']}\")\n",
    "\n",
    "# ── 5. Append to lint_cache.csv / security_cache.csv (skip if already there) ─\n",
    "# IMPORTANT: the two caches don't agree on column order (lint_cache.csv has\n",
    "# content_hash LAST, security_cache.csv has it FIRST) -- must reindex each\n",
    "# new batch to the EXISTING file's actual header before appending, or a\n",
    "# plain header=False append silently writes columns into the wrong\n",
    "# positions (this bit us once already: appending a content_hash-first dict\n",
    "# straight into lint_cache.csv shifted every value over by one column).\n",
    "for cache_path, rows in [(LINT_CACHE_PATH, lint_rows), (SEC_CACHE_PATH, sec_rows)]:\n",
    "    df_new = pd.DataFrame(rows)\n",
    "    if cache_path.exists():\n",
    "        existing_cols = pd.read_csv(cache_path, nrows=0).columns\n",
    "        df_existing_hashes = pd.read_csv(cache_path, usecols=['content_hash'])\n",
    "        already = set(df_existing_hashes['content_hash']) & set(df_new['content_hash'])\n",
    "        df_new = df_new[~df_new['content_hash'].isin(already)]\n",
    "        df_new = df_new.reindex(columns=existing_cols)\n",
    "        if not df_new.empty:\n",
    "            df_new.to_csv(cache_path, mode='a', header=False, index=False)\n",
    "    else:\n",
    "        df_new.to_csv(cache_path, index=False)\n",
    "    if not df_new.empty:\n",
    "        print(f'💾 Appended {len(df_new)} row(s) to {cache_path.name}')\n",
    "\n",
    "# ── 6. Append to df_deploy_ready (only the ones that actually pass lint+sec) ─\n",
    "# NOTE: must include 'content_norm' (not just 'content') -- cell 10's\n",
    "# validate_template()/deploy_stack() read row['content_norm'] specifically,\n",
    "# since that's the canonical column name used everywhere downstream from\n",
    "# cell 5c onward. An earlier version of this cell appended 'content' only,\n",
    "# which left content_norm as NaN for these rows after pd.concat and crashed\n",
    "# cell 10 with `TypeError: write() argument must be str, not float`.\n",
    "passing = [f for f in _MANUAL_FIXES if f['lint_pass'] and f['trivy_pass']]\n",
    "failing = [f for f in _MANUAL_FIXES if not (f['lint_pass'] and f['trivy_pass'])]\n",
    "if failing:\n",
    "    print(f\"\\n⚠️ {len(failing)} scenario(s) did NOT pass lint+security on this run -- NOT added to df_deploy_ready:\")\n",
    "    for f in failing:\n",
    "        print(f\"   - {f['gf_dest_file']}\")\n",
    "\n",
    "manual_rows = []\n",
    "for f in passing:\n",
    "    manual_rows.append({\n",
    "        'dest_file': f['gf_dest_file'], 'source_category': 'manual-fix',\n",
    "        'source_slug': f['source_slug'], 'licence_spdx': f['licence_spdx'],\n",
    "        'github_url': f['github_url'], 'cfn_description': f['cfn_description'],\n",
    "        'content': f['content'], 'content_norm': f['content_norm'], 'content_hash': f['content_hash'],\n",
    "        'loc': f['loc'], 'n_resources': f['n_resources'], 'n_parameters': f['n_parameters'],\n",
    "        'resource_types': f['resource_types'], 'aws_services': f['aws_services'],\n",
    "        'difficulty': f['difficulty'], 'file_ext': f['file_ext'],\n",
    "        'lint_pass': f['lint_pass'], 'lint_errors': f['lint_errors'],\n",
    "        'trivy_pass': f['trivy_pass'], 'trivy_critical': f['trivy_critical'],\n",
    "        'trivy_high': f['trivy_high'], 'trivy_medium': f['trivy_medium'],\n",
    "    })\n",
    "\n",
    "df_manual_fix = pd.DataFrame(manual_rows)\n",
    "if 'df_deploy_ready' in globals():\n",
    "    df_deploy_ready = pd.concat([df_deploy_ready, df_manual_fix], ignore_index=True, sort=False)\n",
    "    print(f\"\\n✅ Added {len(df_manual_fix)} manual-fix scenario(s) to df_deploy_ready ({len(df_deploy_ready)} total).\")\n",
    "    print(\"   Run cell 10 (Deployability Check) next -- their content_hash isn't in\")\n",
    "    print(\"   deploy_cache yet, so they'll be picked up as new.\")\n",
    "else:\n",
    "    MANUAL_FIX_CSV = DATASET_DIR / 'manual_fix_deploy_ready.csv'\n",
    "    df_manual_fix.to_csv(MANUAL_FIX_CSV, index=False)\n",
